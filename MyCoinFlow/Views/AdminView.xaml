<UserControl x:Class="MyCoinFlow.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="AdminView_Loaded">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== LINKS: NAVIGATION (SidebarCard) ================== -->
        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="RoleHeaderText"
                               Text="Einstellungen"
                               Style="{StaticResource SidebarSectionHeader}"
                               Margin="0,0,0,12"/>

                    <!-- NavList bleibt ListBox (Code-behind) -->
                    <ListBox x:Name="NavList"
                             SelectionChanged="NavList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">

                        <!-- Einheitlicher Item-Style (nur Optik) -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,4,0,4"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    CornerRadius="10"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!-- Items (Tags bleiben exakt gleich) -->
                        <ListBoxItem Tag="Nummernkreise">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListNumbered"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Nummernkreise" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Kontenplan">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Kontenplan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Kreditkarten">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Kreditkarten" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Mandanten">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountMultiplePlusOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Mandanten" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Update">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Update" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Backup">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Pfade">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderArrowUpDown"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Dateianhänge und OCR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Lizenz">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyVariant"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"/>
                                <TextBlock Text="Lizenz" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================== RECHTS: CONTENT (Card) ================== -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <Grid>

                <Grid x:Name="SecNummernkreise" Visibility="Collapsed">
                    <ContentControl x:Name="NumberRangesHost"/>
                </Grid>

                <Grid x:Name="SecPfade" Visibility="Collapsed">
                    <ContentControl x:Name="PathsHost"/>
                </Grid>

                <!-- KONTENPLAN -->
                <Grid x:Name="SecKontenplan" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINKS: Kontenplan Sidebar (Import/Export + tab-abhängige Aktionen) -->
                    <Border Grid.Column="0"
            Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Kontenplan"
                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Aktionen"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,8"/>

                                <Button Click="ImportExcel_Click"
                        Style="{StaticResource IconTextButton}"
                        Tag="FileImport"
                        Content="Import (Excel)"
                        MinHeight="40"
                        Margin="0,0,0,10"/>

                                <Button Click="ExportExcel_Click"
                        Style="{StaticResource IconTextButton}"
                        Tag="FileExport"
                        Content="Export (Excel)"
                        MinHeight="40"/>

                                <Separator Margin="0,14,0,12"/>

                                <!-- ✅ HIER kommen jetzt die tab-spezifischen Eingaben/Buttons rein -->
                                <ContentControl x:Name="KontenplanActionsHost"
                                Margin="0,0,0,12"/>

                                <Separator Margin="0,2,0,12"/>

                                <TextBlock Text="Hinweis"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,6"/>

                                <TextBlock Text="Wähle rechts den Tab (Art/Gruppe/Untergruppe). Links erscheinen die passenden Eingaben und Aktionen. Rechts ist nur die Liste."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RECHTS: Inhalte (nur Listen) -->
                    <Border Grid.Column="2"
            CornerRadius="{StaticResource AppCornerRadius.Card}"
            Background="{DynamicResource MaterialDesignPaper}"
            Padding="12">

                        <TabControl x:Name="KontenplanTab"
                    SelectionChanged="KontenplanTab_SelectionChanged">
                            <!-- TAB: Konten-Art -->
                            <TabItem Header="Konten-Art">
                                <Border Padding="10" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenArtListHost"/>
                                </Border>
                            </TabItem>

                            <!-- TAB: Konten-Gruppe -->
                            <TabItem Header="Konten-Gruppe">
                                <Border Padding="10" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenGruppeHost"/>
                                </Border>
                            </TabItem>

                            <!-- TAB: Konten-Untergruppe -->
                            <TabItem Header="Konten-Untergruppe">
                                <Border Padding="10" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenUnterGruppeHost"/>
                                </Border>
                            </TabItem>
                        </TabControl>

                    </Border>
                </Grid>


                <!-- KREDITKARTEN -->
                <Grid x:Name="SecKreditkarten" Visibility="Collapsed">
                    <Border Padding="10" CornerRadius="10"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                        <ContentControl x:Name="CreditCardImportMappingHost"/>
                    </Border>
                </Grid>

                <!-- MANDANTEN -->
                <Grid x:Name="SecMandanten" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINKS: 3. Sidebar (Untermenü Mandanten) -->
                    <Border Grid.Column="0"
                        Style="{StaticResource SidebarCard}">
                        <StackPanel>

                            <TextBlock Text="Mandanten"
                       Style="{StaticResource SidebarSectionHeader}"/>

                            <TextBlock Text="Unterkategorien"
                       Style="{StaticResource SidebarGroupHeader}"
                       Margin="0,0,0,8"/>

                            <!-- Reine UI-Navigation ohne Code-behind: TabControl steuern wir via Name -->
                            <ListBox x:Name="MandantenSubNav"
                     SelectedIndex="0"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,4,0,4"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabasePlus"
                                                 Style="{StaticResource DefaultIconStyle.Nav}"/>
                                        <TextBlock Text="Neu anlegen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseSyncOutline"
                                                 Style="{StaticResource DefaultIconStyle.Nav}"/>
                                        <TextBlock Text="Daten kopieren" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountMultipleOutline"
                                                 Style="{StaticResource DefaultIconStyle.Nav}"/>
                                        <TextBlock Text="Benutzer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>

                            </ListBox>

                            <Separator Margin="0,14,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                         Style="{StaticResource DefaultIconStyle}"
                                         VerticalAlignment="Top"
                                         Margin="0,1,8,0"/>
                                <TextBlock Text="Wähle links die Unterkategorie. Rechts erscheinen die Details."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- RECHTS: Detailbereich -->
                    <Border Grid.Column="2"
            CornerRadius="{StaticResource AppCornerRadius.Card}"
            Background="{DynamicResource MaterialDesignPaper}"
            Padding="12">

                        <!-- Tabs nur als Container – Navigation über ListBox (SelectedIndex Binding) -->
                        <TabControl SelectedIndex="{Binding SelectedIndex, ElementName=MandantenSubNav}"
                    BorderThickness="0"
                    Background="Transparent">

                            <!-- TAB 0: Neu -->
                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text=""/>
                                </TabItem.Header>

                                <Border Padding="12" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Neuen Mandanten anlegen (leer – Schema nur)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <WrapPanel>
                                            <TextBox x:Name="NewTenantNameBox"
                                     materialDesign:HintAssist.Hint="Neuer DB-Name (z. B. MyCoinFlow_Test)"
                                     Width="320"
                                     Margin="0,0,10,10"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                            <Button Click="CreateEmptyTenant_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="DatabasePlus"
                                    Content="Anlegen (leer)"
                                    MinHeight="40"
                                    Margin="0,0,0,10"/>
                                        </WrapPanel>

                                        <TextBlock x:Name="TenantCreateStatus"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- TAB 1: Kopieren -->
                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text=""/>
                                </TabItem.Header>

                                <Border Padding="12" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Daten zwischen Datenbanken kopieren (Quelle → Ziel)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Quelle (DB)" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="Copy_SourceDbCombo"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ziel (DB)" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="Copy_TargetDbCombo"
                                          IsEditable="False"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Welche Daten kopieren?" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox x:Name="Copy_CbNummernkreise" Content="Nummernkreise" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbKonten"  Content="Kontenstruktur" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbAdressen" Content="Adressen" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbAliase"   Content="Aliase" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbGeldinst" Content="Geldinstitute (ohne Anfangsbestand)" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbImport"   Content="Import-Schema und Mapping" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbKatMap"   Content="Kategorie→Konto" IsChecked="True" Margin="0,0,16,8"/>
                                            <CheckBox x:Name="Copy_CbBudget"   Content="Budgetzeitraum (aktuelles Jahr)" IsChecked="True" Margin="0,0,16,8"/>
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                            <Button Click="Copy_Run_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="PlayCircle"
                                    Content="Ausführen"
                                    MinHeight="40"/>
                                        </StackPanel>

                                        <TextBlock x:Name="Copy_StatusText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- TAB 2: Benutzer -->
                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text=""/>
                                </TabItem.Header>

                                <Border Padding="12" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Benutzer verwalten (aktive DB)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <TextBlock x:Name="Users_ActiveDbText"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                   Margin="0,0,0,10"/>

                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Click="Users_Refresh_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="Refresh"
                                    Content="Aktualisieren"
                                    MinHeight="40"
                                    Margin="0,0,10,10"/>
                                            <Button Click="Users_Add_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="AccountPlus"
                                    Content="Neuer Benutzer"
                                    MinHeight="40"
                                    Margin="0,0,10,10"/>
                                            <Button Click="Users_ResetPassword_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="Key"
                                    Content="Passwort zurücksetzen"
                                    MinHeight="40"
                                    Margin="0,0,10,10"/>
                                            <Button Click="Users_ToggleActive_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="AccountOffOutline"
                                    Content="Aktiv/Inaktiv"
                                    MinHeight="40"
                                    Margin="0,0,10,10"/>
                                            <Button Click="Users_ToggleAdmin_Click"
                                    Style="{StaticResource IconTextButton}"
                                    Tag="ShieldAccountOutline"
                                    Content="Admin/Standard"
                                    MinHeight="40"
                                    Margin="0,0,10,10"/>
                                        </WrapPanel>

                                        <Border Padding="10" CornerRadius="10"
                                Background="{DynamicResource MaterialDesignPaper}">
                                            <DataGrid x:Name="UsersGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      materialDesign:DataGridAssist.CellPadding="8"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                                      RowHeight="40"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="{x:Null}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="90"/>
                                                    <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="90"/>
                                                    <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedAt}" Width="170"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>

                                        <TextBlock x:Name="Users_StatusText"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                        </TabControl>
                    </Border>

                </Grid>

                <!-- UPDATE -->
                <Grid x:Name="SecUpdate" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="UpdatesHost" Grid.Row="1" Margin="0,16,0,0"/>
                </Grid>

                <!-- BACKUP -->
                <Grid x:Name="SecBackup" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Backup und Restore (aktive DB)" FontSize="16" FontWeight="SemiBold"/>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="10"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="FrameworkElement">
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock x:Name="Backup_ActiveDbText" />
                            <DockPanel>
                                <TextBox x:Name="BackupFileBox"
                                         materialDesign:HintAssist.Hint="Ziel-Datei (*.bak)"
                                         Width="380"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Click="Backup_Browse_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="FolderSearchOutline"
                                        Content="Ziel wählen"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="Backup_Run_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="DatabaseArrowDown"
                                        Content="Backup erstellen"/>
                            </StackPanel>
                            <TextBlock x:Name="Backup_StatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>

                            <Separator Margin="0,12,0,12"/>

                            <TextBlock Text="Backup zurückspielen (überschreibt aktive DB)" FontWeight="SemiBold"/>
                            <DockPanel>
                                <TextBox x:Name="Restore_FileBox"
                                         materialDesign:HintAssist.Hint="Quelle (*.bak)"
                                         Width="380"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Click="Restore_BrowseBak_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="FileSearchOutline"
                                        Content="Quelle wählen"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="Restore_Run_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="DatabaseRefresh"
                                        Content="Wiederherstellen"/>
                            </StackPanel>
                            <TextBlock x:Name="Restore_StatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </Grid>

                <!-- LIZENZ -->
                <Grid x:Name="SecLizenz" Visibility="Collapsed">
                    <Border Padding="12" CornerRadius="10" Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <TextBlock Text="Lizenz"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <TextBlock x:Name="LicenseInfoText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <DockPanel>
                                <TextBox x:Name="LicenseKeyBox"
                                         materialDesign:HintAssist.Hint="Lizenzschlüssel (MCF1-...)"
                                         Width="520"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Click="License_Save_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="KeyPlus"
                                        Content="Speichern"/>
                            </DockPanel>

                            <TextBlock x:Name="LicenseStatusText"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
