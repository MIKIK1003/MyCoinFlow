<UserControl x:Class="MyCoinFlow.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="AdminView_Loaded">

        <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LINKS: NAVIGATION                                         -->
        <!-- ========================================================= -->
        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="RoleHeaderText"
                               Text="Einstellungen"
                               Style="{StaticResource SidebarSectionHeader}"
                               Margin="0,0,0,12"/>

                    <!-- NavList bleibt ListBox (Code-behind) -->
                    <ListBox x:Name="NavList"
                             SelectionChanged="NavList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">

                        <!-- Einheitlicher Item-Style (nur Optik) -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{DynamicResource MaterialDesignPaper}"
                                                    CornerRadius="5"
                                                    Padding="12,10"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  RecognizesAccessKey="True"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="{DynamicResource MaterialDesignSelection}"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="{DynamicResource MaterialDesignSelection}"/>
                                                    <Setter TargetName="Bd"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource MaterialDesignDivider}"/>
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!-- ================== NAV ITEMS ================== -->

                        <ListBoxItem Tag="Nummernkreise">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListNumbered"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.7"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Nummernkreise"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Kontenplan">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Kontenplan"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Kreditkarten">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Kreditkarten"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Mandanten">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountMultiplePlusOutline"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Mandanten"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Update">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Update"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Backup">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Backup"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Pfade">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderArrowUpDown"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Dateianhänge und OCR"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Lizenz">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyVariant"
                                                         Style="{StaticResource DefaultIconStyle.Nav}"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Lizenz"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========================================================= -->
        <!-- RECHTS: CONTENT                                            -->
        <!-- ========================================================= -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <Grid>

                <!-- ===================================================== -->
                <!-- 1) Nummernkreise                                       -->
                <!-- ===================================================== -->
                <Grid x:Name="SecNummernkreise" Visibility="Collapsed">
                    <ContentControl x:Name="NumberRangesHost"/>
                </Grid>

                <!-- ===================================================== -->
                <!-- 2) Dateianhänge & OCR (Pfade)                           -->
                <!-- ===================================================== -->
                <Grid x:Name="SecPfade" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: Aktionen je Tab -->
                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Dateianhänge und OCR"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <!-- Panel 0: Verzeichnisse -->
                                <StackPanel x:Name="PathsActionsAttachPanel" Visibility="Visible">
                                    <TextBlock Text="Verzeichnisse"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="FolderPlus"
                                            Content="Ordner erstellen"
                                            MinHeight="40"
                                            Margin="0,0,0,10"
                                            Click="Paths_CreateFolder_Click"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="FolderOpen"
                                            Content="Im Explorer öffnen"
                                            MinHeight="40"
                                            Margin="0,0,0,10"
                                            Click="Paths_OpenExplorer_Click"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="ContentSave"
                                            Content="Speichern"
                                            MinHeight="40"
                                            Click="Paths_Save_Click"/>
                                </StackPanel>

                                <!-- Panel 1: OCR -->
                                <StackPanel x:Name="PathsActionsOcrPanel" Visibility="Collapsed">
                                    <TextBlock Text="OCR"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="FileFind"
                                            Content="Durchsuchen…"
                                            MinHeight="40"
                                            Margin="0,0,0,10"
                                            Click="Paths_BrowseTesseract_Click"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="ContentSave"
                                            Content="OCR speichern"
                                            MinHeight="40"
                                            Margin="0,0,0,10"
                                            Click="Paths_SaveOcr_Click"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="Magnify"
                                            Content="Index aktualisieren"
                                            MinHeight="40"
                                            Click="Paths_Reindex_Click"/>
                                </StackPanel>

                                <!-- Panel 2: Datenbank -->
                                <StackPanel x:Name="PathsActionsDbPanel" Visibility="Collapsed">
                                    <TextBlock Text="Datenbank"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Style="{StaticResource IconTextButton}"
                                            Tag="Refresh"
                                            Content="Aktualisieren"
                                            MinHeight="40"
                                            Click="Paths_RefreshDb_Click"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Content: Tabs + Arbeitsfeld -->
                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TabControl x:Name="PathsTab"
                                        SelectionChanged="PathsTab_SelectionChanged">
                                <TabItem Header="Verzeichnisse"/>
                                <TabItem Header="OCR"/>
                                <TabItem Header="Datenbank"/>
                            </TabControl>

                            <Border Grid.Row="2"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="{DynamicResource MaterialDesignCardBackground}">
                                <ContentControl x:Name="PathsHost"/>
                            </Border>
                        </Grid>

                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 3) Kontenplan                                           -->
                <!-- ===================================================== -->
                <Grid x:Name="SecKontenplan" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: Import/Export + tab-spezifische Aktionen -->
                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Kontenplan"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <Button Click="ImportExcel_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="FileImport"
                                        Content="Import (Excel)"
                                        MinHeight="40"
                                        Margin="0,0,0,10"/>

                                <Button Click="ExportExcel_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="FileExport"
                                        Content="Export (Excel)"
                                        MinHeight="40"/>

                                <Separator Margin="0,14,0,12"/>

                                <ContentControl x:Name="KontenplanActionsHost"
                                                Margin="0,0,0,12"/>

                                <Separator Margin="0,2,0,12"/>

                                <TextBlock Text="Hinweis"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Wähle rechts den Tab (Art/Gruppe/Untergruppe). Links erscheinen die passenden Eingaben und Aktionen. Rechts ist nur die Liste."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Content: Tabs -->
                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">

                        <TabControl x:Name="KontenplanTab"
                                    SelectionChanged="KontenplanTab_SelectionChanged"
                                    Margin="0,0,0,10">
                            <TabItem Header="Konten-Art">
                                <Border Padding="10" CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenArtListHost"/>
                                </Border>
                            </TabItem>

                            <TabItem Header="Konten-Gruppe">
                                <Border Padding="10" CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenGruppeListHost"/>
                                </Border>
                            </TabItem>

                            <TabItem Header="Konten-Untergruppe">
                                <Border Padding="10" CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <ContentControl x:Name="KontenUnterGruppeListHost"/>
                                </Border>
                            </TabItem>
                        </TabControl>

                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 4) Kreditkarten                                         -->
                <!-- ===================================================== -->
                <Grid x:Name="SecKreditkarten" Visibility="Collapsed">
                    <Border CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}">
                        <ContentControl x:Name="CreditCardImportMappingHost"/>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 5) Mandanten                                            -->
                <!-- ===================================================== -->
                <Grid x:Name="SecMandanten" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: Aktionen je Tab -->
                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Mandanten"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <StackPanel x:Name="MandantenActionsNeuPanel" Visibility="Visible">
                                    <TextBlock Text="Neu anlegen"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Click="CreateEmptyTenant_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="DatabasePlus"
                                            Content="Anlegen (leer)"
                                            MinHeight="40"/>
                                </StackPanel>

                                <StackPanel x:Name="MandantenActionsCopyPanel" Visibility="Collapsed">
                                    <TextBlock Text="Daten kopieren"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <CheckBox x:Name="Copy_CbNummernkreise" Content="Nummernkreise" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbKonten"  Content="Kontenstruktur" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbAdressen" Content="Adressen" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbAliase"   Content="Aliase" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbGeldinst" Content="Geldinstitute (ohne Anfangsbestand)" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbImport"   Content="Import-Schema und Mapping" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbKatMap"   Content="Kategorie→Konto" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Copy_CbBudget"   Content="Budgetzeitraum (aktuelles Jahr)" IsChecked="True" Margin="0,0,0,12"/>

                                    <Button Click="Copy_Run_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="PlayCircle"
                                            Content="Ausführen"
                                            MinHeight="40"/>
                                </StackPanel>

                                <StackPanel x:Name="MandantenActionsUsersPanel" Visibility="Collapsed">
                                    <TextBlock Text="Benutzer"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Click="Users_Refresh_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="Refresh"
                                            Content="Aktualisieren"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Users_Add_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="AccountPlus"
                                            Content="Neuer Benutzer"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Users_ResetPassword_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="Key"
                                            Content="Passwort zurücksetzen"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Users_ToggleActive_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="AccountOffOutline"
                                            Content="Aktiv/Inaktiv"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Users_ToggleAdmin_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="ShieldAccountOutline"
                                            Content="Admin/Standard"
                                            MinHeight="40"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Content: Tabs -->
                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">

                        <TabControl x:Name="MandantenTab"
                                    SelectionChanged="MandantenTab_SelectionChanged"
                                    Margin="0,0,0,10">

                            <TabItem Header="Neu anlegen">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Neuen Mandanten anlegen (leer – Schema nur)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <TextBox x:Name="NewTenantNameBox"
                                                 materialDesign:HintAssist.Hint="Neuer DB-Name (z. B. MyCoinFlow_Test)"
                                                 HorizontalAlignment="Stretch"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <TextBlock x:Name="TenantCreateStatus"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Daten kopieren">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Daten zwischen Datenbanken kopieren (Quelle → Ziel)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Quelle (DB)" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="Copy_SourceDbCombo"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="True"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ziel (DB)" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="Copy_TargetDbCombo"
                                                          IsEditable="False"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="Copy_StatusText"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Benutzer">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Benutzer verwalten (aktive DB)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="Users_ActiveDbText"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                                   Margin="0,0,0,10"/>

                                        <Border Padding="10"
                                                CornerRadius="10"
                                                Background="{DynamicResource MaterialDesignPaper}">
                                            <DataGrid x:Name="UsersGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      RowHeaderWidth="0"
                                                      GridLinesVisibility="Horizontal"
                                                      materialDesign:DataGridAssist.CellPadding="8"
                                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                                                      RowHeight="40"
                                                      Background="White"
                                                      RowBackground="White"
                                                      AlternatingRowBackground="{x:Null}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="90"/>
                                                    <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="90"/>
                                                    <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedAt}" Width="170"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>

                                        <TextBlock x:Name="Users_StatusText"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                        </TabControl>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 6) Update                                               -->
                <!-- ===================================================== -->
                <Grid x:Name="SecUpdate" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Update"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <Button Click="Updates_Search_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="shieldsearch"
                                        Content="Suchen"
                                        MinHeight="40"
                                        Margin="0,0,0,10"/>

                                <Button Click="Updates_Backup_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="databaseexport"
                                        Content="Sichern"
                                        MinHeight="40"
                                        Margin="0,0,0,10"/>

                                <Button Click="Updates_Update_Click"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="update"
                                        Content="Updaten"
                                        MinHeight="40"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">
                        <Border Padding="12"
                                CornerRadius="10"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <ContentControl x:Name="UpdatesHost"/>
                        </Border>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 7) Backup                                               -->
                <!-- ===================================================== -->
                <Grid x:Name="SecBackup" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Backup"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <StackPanel x:Name="BackupActionsBackupPanel" Visibility="Visible">
                                    <TextBlock Text="Sicherung der Daten"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Click="Backup_Run_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="DatabaseArrowDown"
                                            Content="Backup erstellen"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Backup_Browse_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="FolderSearchOutline"
                                            Content="Ziel wählen"
                                            MinHeight="40"/>
                                </StackPanel>

                                <StackPanel x:Name="BackupActionsRestorePanel" Visibility="Collapsed">
                                    <TextBlock Text="Zurückholen einer Sicherung"
                                               Style="{StaticResource SidebarGroupHeader}"
                                               Margin="0,0,0,8"/>

                                    <Button Click="Restore_Run_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="DatabaseRefresh"
                                            Content="Wiederherstellen"
                                            MinHeight="40"
                                            Margin="0,0,0,10"/>

                                    <Button Click="Restore_BrowseBak_Click"
                                            Style="{StaticResource IconTextButton}"
                                            Tag="FileSearchOutline"
                                            Content="Quelle wählen"
                                            MinHeight="40"/>
                                </StackPanel>

                                <Separator Margin="0,14,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             VerticalAlignment="Top"
                                                             Margin="0,2,8,0"/>
                                    <TextBlock Text="Backup erstellt eine .bak-Datei. Restore überschreibt die aktive Datenbank."
                                               TextWrapping="Wrap"
                                               Width="180"
                                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">

                        <TabControl x:Name="BackupTab"
                                    SelectionChanged="BackupTab_SelectionChanged"
                                    Margin="0,0,0,10">

                            <TabItem Header="Backup">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Backup (aktive DB)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="Backup_ActiveDbText"
                                                   Margin="0,0,0,10"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>

                                        <TextBlock Text="Ziel-Datei (.bak)"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <TextBox x:Name="BackupFileBox"
                                                 IsReadOnly="True"
                                                 materialDesign:HintAssist.Hint="Ziel-Datei (*.bak)"
                                                 HorizontalAlignment="Stretch"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <TextBlock x:Name="Backup_StatusText"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Restore">
                                <Border Padding="12"
                                        CornerRadius="10"
                                        Background="{DynamicResource MaterialDesignCardBackground}">
                                    <StackPanel>
                                        <TextBlock Text="Restore (aktive DB überschreiben)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Text="Quelle-Datei (.bak)"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <TextBox x:Name="Restore_FileBox"
                                                 IsReadOnly="True"
                                                 materialDesign:HintAssist.Hint="Quelle (*.bak)"
                                                 HorizontalAlignment="Stretch"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <TextBlock x:Name="Restore_StatusText"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                        </TabControl>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- 8) Lizenz                                               -->
                <!-- ===================================================== -->
                <Grid x:Name="SecLizenz" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Aktionen"
                                           Style="{StaticResource SidebarSectionHeader}"/>

                                <TextBlock Text="Lizenz"
                                           Style="{StaticResource SidebarGroupHeader}"
                                           Margin="0,0,0,8"/>

                                <Button Click="License_ImportFile_Click"
        Style="{StaticResource IconTextButton}"
        Tag="FileImport"
        Content="Lizenzdatei importieren"
        MinHeight="40"
        Margin="0,0,0,10"/>

                                <Button Click="License_Save_Click"
        Style="{StaticResource IconTextButton}"
        Tag="KeyPlus"
        Content="MCF1-Key speichern"
        MinHeight="40"/>

                                <Separator Margin="0,14,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             VerticalAlignment="Top"
                                                             Margin="0,2,8,0"/>
                                    <TextBlock Text="Rechts kannst du den Lizenzschlüssel erfassen. Änderungen werden beim nächsten Start wirksam."
                                               TextWrapping="Wrap"
                                               Width="180"
                                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="{StaticResource AppCornerRadius.Card}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Padding="12">
                        <Border Padding="12"
                                CornerRadius="10"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>

                                <TextBlock Text="Lizenz"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <TextBlock x:Name="LicenseInfoText"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                           Margin="0,0,0,12"/>

                                <Border Padding="12"
        CornerRadius="10"
        Background="{DynamicResource MaterialDesignPaper}"
        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Aktive Module"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

                                        <TextBlock x:Name="LicenseModulesText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Lizenzschlüssel"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="LicenseKeyBox"
                                         materialDesign:HintAssist.Hint="Lizenzschlüssel (MCF1-...)"
                                         HorizontalAlignment="Stretch"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBlock x:Name="LicenseStatusText"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>

                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>