<base:BaseWindow x:Class="MyCoinFlow.Views.HaushaltObjektKategorieDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
                 Title="Objekt-Kategorie"
                 Width="520"
                 Height="430"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Objekt-Kategorie erfassen / bearbeiten"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">

            <TextBox x:Name="BezeichnungBox"
                     MinHeight="40"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Bezeichnung"
                     Margin="0,0,0,12"/>

            <ComboBox x:Name="IconBox"
                      MinHeight="40"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Icon"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Key"
                      Margin="0,0,0,12"/>

            <TextBox x:Name="BemerkungBox"
                     MinHeight="130"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Bemerkung"/>

        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button Content="Abbrechen"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Abbrechen_Click"/>

            <Button Content="Speichern"
                    Width="120"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Speichern_Click"/>
        </DockPanel>
    </Grid>
</base:BaseWindow>