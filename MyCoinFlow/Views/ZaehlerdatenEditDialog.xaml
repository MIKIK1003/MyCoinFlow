<base:BaseWindow x:Class="MyCoinFlow.Views.ZaehlerdatenEditDialog"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Zählerdaten"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{Binding HeaderText}"/>

        <!-- Erfassungsart -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10"
                Padding="12">

            <StackPanel>

                <TextBlock Text="Erfassungsart"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <ComboBox Width="260"
                          SelectedValue="{Binding ErfassungsTypProxy, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="Differenz (Zählerstand)" Tag="0"/>
                    <ComboBoxItem Content="Monatswerte (kWh)" Tag="1"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0"
                            Visibility="{Binding MonatswerteVisibility}">
                    <TextBlock Text="Anzahl Monate:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox Width="70"
                             Text="{Binding MonatsAnzahlProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Header Felder -->
        <Border Grid.Row="4"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Datum -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Erfasst am"/>
                <DatePicker Grid.Row="0" Grid.Column="2"
                            SelectedDate="{Binding ModelErfasstAm, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Rechnung -->
                <TextBlock Grid.Row="0" Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="Rechnung kWh total"/>
                <TextBox Grid.Row="0" Grid.Column="6"
                         Text="{Binding RechnungKwhText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Gutschrift -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Gutschrift CHF (optional)"/>
                <TextBox Grid.Row="2" Grid.Column="2"
                         Text="{Binding GutschriftChfText, UpdateSourceTrigger=LostFocus}"/>

                <!-- Rückspeisung -->
                <TextBlock Grid.Row="2" Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="Rückspeisung kWh (optional)"/>
                <TextBox Grid.Row="2" Grid.Column="6"
                         Text="{Binding RueckgespeistKwhText, UpdateSourceTrigger=LostFocus}"/>

                <!-- Notiz -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           VerticalAlignment="Top"
                           Text="Notiz"/>
                <TextBox Grid.Row="4" Grid.Column="2"
                         Grid.ColumnSpan="5"
                         Height="60"
                         AcceptsReturn="True"
                         Text="{Binding Model.Notiz, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
        </Border>

        <!-- Zähler Grid -->
        <Border Grid.Row="6"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10"
                Padding="12">

            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Typ}"
                                        IsReadOnly="True"
                                        Width="90"/>

                    <DataGridTextColumn Header="Zähler"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="2*"/>

                    <DataGridTextColumn Header="EinheitId"
                                        Binding="{Binding EinheitId}"
                                        IsReadOnly="True"
                                        Width="100"/>

                    <!-- Differenzmodus -->
                    <DataGridTemplateColumn Header="Neu-Wert (kWh)" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NeuText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsMonatswerte, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Monatswerte -->
                    <DataGridTemplateColumn Header="Monatswerte" Width="420">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsMonatswerte, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>

                                        <ItemsControl ItemsSource="{Binding Monatswerte}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,10,6">
                                                        <TextBlock Text="{Binding MonatIndex, StringFormat=Monat {0}}"
                                                                   FontSize="11"
                                                                   Margin="0,0,0,2"/>
                                                        <TextBox Width="80"
                                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding MonatswerteInfo}"
                                                   Margin="0,6,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Cancel_Click"
                    Padding="14,8"
                    Margin="0,0,10,0">
                Abbrechen
            </Button>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"
                    Padding="16,8">
                Speichern
            </Button>

        </StackPanel>
    </Grid>
</base:BaseWindow>