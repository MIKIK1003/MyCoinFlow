<Window x:Class="MyCoinFlow.Views.ZaehlerNeuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Zähler"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{Binding HeaderText}"/>

        <!-- Body -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Name"/>
                <TextBox Grid.Row="0" Grid.Column="2"
                         Text="{Binding Model.Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,0"/>

                <!-- Typ -->
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Typ"/>
                <ComboBox Grid.Row="2" Grid.Column="2"
                          ItemsSource="{Binding TypOptions}"
                          SelectedItem="{Binding SelectedTyp}"
                          Margin="0,2,0,0"/>

                <!-- Einheit -->
                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Einheit"
                           Opacity="{Binding EinheitOpacity}"/>
                <ComboBox Grid.Row="4" Grid.Column="2"
                          ItemsSource="{Binding Einheiten}"
                          SelectedItem="{Binding SelectedEinheit}"
                          DisplayMemberPath="Bezeichnung"
                          IsEnabled="{Binding IsEinheitEnabled}"
                          Margin="0,2,0,0"/>

                <!-- Notiz -->
                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Text="Notiz"/>
                <TextBox Grid.Row="6" Grid.Column="2"
                         Text="{Binding Model.Notiz, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="90"/>

                <!-- Info -->
                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="DIREKT: Zähler ist einer Einheit zugeordnet (Wohnungszähler). ALLG/HEIZ/EVU: ohne Einheit."
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Cancel_Click"
                    Padding="14,8"
                    Margin="0,0,10,0">
                Abbrechen
            </Button>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"
                    Padding="16,8">
                Speichern
            </Button>
        </StackPanel>
    </Grid>
</Window>
