<Window x:Class="MyCoinFlow.Views.KontenplanImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontenplan aus Excel importieren"
        Width="1700" MinWidth="900"
        Height="780" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile: links Datei/Preview, rechts Budget-Optionen (wrappt bei wenig Platz) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- links -->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBox x:Name="PfadBox" Width="480" IsReadOnly="True" Margin="0,0,8,0"/>
                <Button Content="Datei wählen…" Width="140" Click="DateiWaehlen_Click" Margin="0,0,8,0"/>
                <Button Content="Vorschau aktualisieren" Width="180" Click="Vorschau_Click"/>
            </StackPanel>

            <!-- rechts (wrappt) -->
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <CheckBox x:Name="OnlyNewBox" Content="Nur neue anlegen" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="BudgetChk" Content="BudgetJ importieren" VerticalAlignment="Center" Margin="0,0,8,0"
                          Checked="BudgetChk_Toggled" Unchecked="BudgetChk_Toggled"/>
                <TextBlock Text="Zeitraum:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ZeitraumBox" Width="260" IsEnabled="False"
                          DisplayMemberPath="Bezeichnung" SelectedValuePath="Id"/>
            </WrapPanel>
        </Grid>

        <!-- Preview-Tabelle -->
        <DataGrid x:Name="PreviewGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Warning}"/>
                    <Setter Property="Background" Value="{x:Null}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FFFDECEA"/>
                            <!-- leicht rot -->
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DuplicateKontoInFile}" Value="True">
                            <Setter Property="Background" Value="#FFFFF7E6"/>
                            <!-- leicht gelb -->
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNo}" Width="50"/>
                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="90"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/>

                <DataGridTextColumn Header="ArtN" Binding="{Binding ArtN}" Width="80"/>
                <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="220"/>
                <DataGridTextColumn Header="Art (Bezeichnung)" Binding="{Binding ArtBezeichnung}" Width="220"/>

                <DataGridTextColumn Header="Gruppe" Binding="{Binding Gruppe}" Width="180"/>
                <DataGridTextColumn Header="Untergruppe" Binding="{Binding Untergruppe}" Width="180"/>

                <DataGridTextColumn Header="BudgetJ" Binding="{Binding BudgetInfo}" Width="110"/>

                <DataGridTextColumn Header="Art↴" Binding="{Binding ActionArt}" Width="70"/>
                <DataGridTextColumn Header="Gruppe↴" Binding="{Binding ActionGruppe}" Width="80"/>
                <DataGridTextColumn Header="Untergruppe↴" Binding="{Binding ActionUntergruppe}" Width="110"/>
                <DataGridTextColumn Header="Konto↴" Binding="{Binding ActionKonto}" Width="80"/>

                <DataGridTextColumn Header="Hinweis" Binding="{Binding Warning}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Fußzeile -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Abbrechen" Width="110" Margin="0,0,8,0" Click="Abbrechen_Click"/>
                <Button Content="Import starten" Width="160" IsDefault="True" Click="Import_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
