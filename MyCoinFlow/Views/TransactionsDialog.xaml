<Window x:Class="MyCoinFlow.Views.TransactionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Neue Buchung"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <!-- DockPanel = Layout mit fixem Bereich unten -->
    <DockPanel Margin="16">

        <!-- Buttons unten -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0" Click="Abbrechen_Click"/>
            <Button Content="Buchen" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Buchen_Click"/>
        </StackPanel>

        <!-- Scrollbarer Bereich oben -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Typ -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Datum -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Von-Konto -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3: Nach-Konto -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Geldinstitut -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5: Betrag -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6: Adresse -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7: Notiz -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Typ -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Buchungstyp" Margin="0,0,12,8"/>
                <ComboBox x:Name="TypBox" Grid.Row="0" Grid.Column="1" Height="36" Margin="0,0,0,8"
                          SelectionChanged="TypBox_SelectionChanged">
                    <ComboBoxItem Content="Bank → Konto" IsSelected="True"/>
                    <ComboBoxItem Content="Konto → Konto"/>
                    <ComboBoxItem Content="Konto → Bank"/>
                    <ComboBoxItem Content="Adresse → Bank"/>
                </ComboBox>

                <!-- Datum -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datum" Margin="0,0,12,8"/>
                <DatePicker x:Name="DatumBox" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,0,8"/>

                <!-- Von-Konto -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Von-Konto" Margin="0,0,12,8"/>
                <ComboBox x:Name="VonKontoBox" Grid.Row="2" Grid.Column="1" Height="36" Margin="0,0,0,8"
                          DisplayMemberPath="Anzeige" SelectedValuePath="Id"/>

                <!-- Nach-Konto -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Nach-Konto" Margin="0,0,12,8"/>
                <ComboBox x:Name="NachKontoBox" Grid.Row="3" Grid.Column="1" Height="36" Margin="0,0,0,8"
                          DisplayMemberPath="Anzeige" SelectedValuePath="Id"/>

                <!-- Geldinstitut -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Geldinstitut" Margin="0,0,12,8"/>
                <ComboBox x:Name="BankBox" Grid.Row="4" Grid.Column="1" Height="36" Margin="0,0,0,8"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <!-- Betrag -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Betrag" Margin="0,0,12,8"/>
                <TextBox x:Name="BetragBox" Grid.Row="5" Grid.Column="1" Height="36"
                         HorizontalContentAlignment="Right" Margin="0,0,0,8"/>

                <!-- Adresse -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Adresse" Margin="0,0,12,8"/>
                <ComboBox x:Name="AdresseBox" Grid.Row="6" Grid.Column="1" Height="36" Margin="0,0,0,8"
                          Width="300"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          IsEditable="False"
                          IsEnabled="True"/>

                <!-- Notiz -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Notiz" Margin="0,0,12,8"/>
                <TextBox x:Name="NotizBox" Grid.Row="7" Grid.Column="1" Height="100"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
