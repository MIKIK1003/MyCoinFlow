<UserControl x:Class="MyCoinFlow.Views.BankImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1250">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="IdHintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Layout wie AdresseTransaktionenWindow: Sidebar links + Tabelle rechts -->
    <DockPanel Margin="16">

        <!-- Sidebar: Aktionen & Infos -->
        <Border DockPanel.Dock="Left"
                Width="320"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" Orientation="Vertical">

                    <TextBlock Text="Aktionen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- Toolbar-Buttons vertikal -->
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="FileImport"
                            Content="CAMT"
                            Command="{Binding OpenFileCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Broom"
                            Content="Leeren"
                            Margin="0,8,0,0"
                            Command="{Binding ClearCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="ContentSave"
                            Content="Speichern"
                            Margin="0,8,0,0"
                            Command="{Binding SaveToDbCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Download"
                            Content="Laden"
                            Margin="0,8,0,0"
                            Command="{Binding LoadPendingFromDbCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="PlayCircle"
                            Content="Bulk"
                            Margin="0,8,0,0"
                            ToolTip="Bucht alle aktuell vollständig zugeordneten Zeilen ohne Rückfrage"
                            Command="{Binding BulkUebernehmenCommand}"/>

                    <!-- Optionen -->
                    <Separator Margin="0,12,0,12"/>
                    <CheckBox Content="Nur unvollständige anzeigen"
                              IsChecked="{Binding OnlyIncomplete}"/>

                    <!-- Quelle -->
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                        <Run Text="Quelle: "/>
                        <Run Text="{Binding FilePath}"/>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rechts: Tabelle + Status unten -->
        <DockPanel>

            <!-- Status unten -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, StringFormat={}{0} Einträge}" />
            </DockPanel>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding ItemsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      RowHeight="44"
                      FrozenColumnCount="3"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      materialDesign:DataGridAssist.CellPadding="6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12">

                <DataGrid.Columns>

                    <!-- Status: vollständig => Bearbeiten -->
                    <DataGridTemplateColumn Header="" Width="64" MinWidth="64" MaxWidth="64" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Zuordnung bearbeiten"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.BearbeitenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="CheckCircle"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             Width="24" Height="24"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstVollstaendig}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Einzeln buchen -->
                    <DataGridTemplateColumn Header="" Width="64" MinWidth="64" MaxWidth="64" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Diese Buchung sofort übernehmen"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.EinzelBuchenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="PlayCircle"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             Width="24" Height="24"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstVollstaendig}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StagingId}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Anlernen: nur sichtbar, wenn NICHT vollständig -->
                    <DataGridTemplateColumn Header="" Width="64" MinWidth="64" MaxWidth="64" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Transaktion anlernen"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.AnlernenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <!-- Falls 'InvoiceImport' fehlt: später Icon-Kind tauschen (z.B. FileImportOutline) -->
                                    <materialDesign:PackIcon Kind="InvoiceImport"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             Width="24" Height="24"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstVollstaendig}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Löschen: Löscht eine importierte Zeile -->
                    <DataGridTemplateColumn Header="" Width="64" MinWidth="64" MaxWidth="64" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Zeile löschen"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.DeleteImportedRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Margin="4,0,0,0">
                                    <materialDesign:PackIcon Kind="DeleteForever"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
                                </Button>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- vorhandene Daten-Spalten -->
                    <DataGridTextColumn Header="#" Binding="{Binding StagingId}" Width="60"/>
                    <DataGridTextColumn Header="Buchung" Binding="{Binding BookingDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                    <DataGridTextColumn Header="Valuta"   Binding="{Binding ValueDate,   StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                    <DataGridTextColumn Header="Betrag"   Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="Währung"  Binding="{Binding Currency}" Width="80"/>
                    <DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="90"/>
                    <DataGridTextColumn Header="Konto-IBAN" Binding="{Binding AccountIban}" Width="200"/>
                    <DataGridTextColumn Header="Gegenpartei" Binding="{Binding CounterpartyName}" Width="200"/>
                    <DataGridTextColumn Header="Gegen-IBAN"  Binding="{Binding CounterpartyIban}" Width="200"/>
                    <DataGridTextColumn Header="Text"     Binding="{Binding Text}" Width="*"/>
                    <DataGridTextColumn Header="ServiceRef" Binding="{Binding ServiceRef}" Width="160"/>

                    <!-- Label-Spalten -->
                    <DataGridTemplateColumn Header="Adresse" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding AdresseLabel}"/>
                                    <TextBlock Style="{StaticResource IdHintText}"
                                               Text="{Binding VorschlagAdresseId, StringFormat=Id: {0}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Geldinstitut" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding GeldinstitutLabel}"/>
                                    <TextBlock Style="{StaticResource IdHintText}"
                                               Text="{Binding VorschlagGeldinstitutId, StringFormat=Id: {0}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Konto (Nach)" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NachKontoLabel}"/>
                                    <TextBlock Style="{StaticResource IdHintText}"
                                               Text="{Binding VorschlagNachKontoId, StringFormat=Id: {0}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Konto (Von)" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding VonKontoLabel}"/>
                                    <TextBlock Style="{StaticResource IdHintText}"
                                               Text="{Binding VorschlagVonKontoId, StringFormat=Id: {0}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
