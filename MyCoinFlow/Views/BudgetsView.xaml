<UserControl x:Class="MyCoinFlow.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Sidebar | Divider | Tabelle -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="16"/>
            <!-- Divider -->
            <ColumnDefinition Width="*"/>
            <!-- Tabelle -->
        </Grid.ColumnDefinitions>

        <!-- ================== SIDEBAR ================== -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel>
                <TextBlock Text="Aktionen"
                           FontSize="18" Margin="0,0,0,12"
                           Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                <!-- 1) Zeitraum hinzufügen -->
                <Button Style="{StaticResource IconTextButton}"
                        Tag="TimerPlus"
                        Content="Zeitraum hinzufügen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding NeuerZeitraumCommand}"/>

                <!-- 2) Zeitraum bearbeiten -->
                <Button Style="{StaticResource IconTextButton}"
                        Tag="TimerEdit"
                        Content="Zeitraum bearbeiten"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding BearbeitenZeitraumCommand}"/>

                <!-- 3) Zeitraum löschen -->
                <Button Style="{StaticResource IconTextButton.Danger}"
                        Tag="TimerMinus"
                        Content="Zeitraum löschen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding LoeschenEintragCommand}"/>

                <!-- 4) Budget erfassen -->
                <Button Style="{StaticResource IconTextButton}"
                        Tag="HandCoin"
                        Content="Budget erfassen"
                        MinHeight="40"
                        Command="{Binding BudgetwerteErfassenCommand}"/>
            </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1"
                Background="{DynamicResource MaterialDesignDivider}"/>

        <!-- ================== TABELLE (unverändert, nur Farben) ================== -->
        <Grid Grid.Column="2">
            <DataGrid ItemsSource="{Binding Budgetzeitraeume}"
                      SelectedItem="{Binding AusgewaehlterZeitraum}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      RowHeaderWidth="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="{x:Null}">

                <!-- Header-Farbe wie Sidebar -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bezeichnung"
                                        Binding="{Binding Bezeichnung}" Width="*"/>
                    <DataGridTextColumn Header="Startdatum"
                                        Binding="{Binding Startdatum, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                    <DataGridTextColumn Header="Enddatum"
                                        Binding="{Binding Enddatum, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                    <DataGridCheckBoxColumn Header="Aktiv"
                                            Binding="{Binding IstAktiv}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
