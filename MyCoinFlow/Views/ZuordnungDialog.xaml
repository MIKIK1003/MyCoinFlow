<Window x:Class="MyCoinFlow.Views.ZuordnungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyCoinFlow.Views"
        Title="Transaktion anlernen"
        Height="650" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <!-- Buttons unten -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Width="110" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Speichern" Width="120" IsDefault="True" Click="Speichern_Click"/>
        </StackPanel>

        <!-- Inhalt -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0,0,0,8">

                <!-- Info -->
                <TextBlock Text="Buchungsinformationen" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Vertical" Margin="0,6,0,12">
                    <TextBlock Text="{Binding BuchungInfo}" />
                    <TextBlock Text="{Binding BuchungText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <Separator/>

                <!-- Adresse -->
                <TextBlock Text="Adresse" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="NeueAdresseCheck" Content="Neue Adresse anlegen" Margin="0,0,0,6"/>

                    <!-- bestehende Adresse -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Bestehende Adresse" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AdrBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Height="32"
                                  IsEnabled="{Binding IsChecked, ElementName=NeueAdresseCheck, Converter={x:Static views:BooleanNegationConverter.Instance}}"/>
                    </StackPanel>

                    <!-- neue Adresse -->
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <TextBlock Text="Neue Adresse" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Name" Width="90" VerticalAlignment="Center"/>
                            <TextBox x:Name="NeuNameBox" Width="360"
                                     IsEnabled="{Binding IsChecked, ElementName=NeueAdresseCheck}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IBAN" Width="90" VerticalAlignment="Center"/>
                            <TextBox x:Name="NeuIbanBox" Width="360"
                                     IsEnabled="{Binding IsChecked, ElementName=NeueAdresseCheck}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,8,0,8"/>

                <!-- Standardkonto -->
                <TextBlock Text="Standardkonto" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="KontoBox"
                          DisplayMemberPath="Anzeige"
                          SelectedValuePath="Id"
                          Height="32"/>

                <Separator Margin="0,8,0,8"/>

                <!-- Einnahmen-Budget-Option (nur für Adresse -> Bank sichtbar) -->
                <CheckBox x:Name="BudgetEinnahmenCheck"
                            Content="Standard-Einnahme Adresse-Bank (Standard-Einnahmenkonto)"
                            Margin="0,8,0,2"
                            Visibility="Collapsed"/>
                <TextBlock x:Name="BudgetHinweisText"
                            Text="Bei „Speichern“ wird dieses Konto als Standard-Einnahmenkonto der Adresse gesetzt."
                            FontSize="11"
                            Foreground="Gray"
                            Margin="0,0,0,8"
                            Visibility="Collapsed"/>

                <!-- Geldinstitut (Anzeige) -->
                <TextBlock Text="Geldinstitut / Kontoquelle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="GiInfoText" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
