<base:BaseWindow x:Class="MyCoinFlow.Views.HaushaltObjektDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
                 Title="Objekt"
                 Width="560"
                 Height="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Objekt erfassen / bearbeiten"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <ComboBox x:Name="KategorieBox"
          MinHeight="44"
          Padding="8,6,8,6"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          materialDesign:HintAssist.Hint="Objekt-Kategorie"
          DisplayMemberPath="Bezeichnung"
          SelectedValuePath="Id"
          Margin="0,8,0,14"/>

                <TextBox x:Name="HerstellerBox"
                         MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Hersteller"
                         Margin="0,0,0,12"/>

                <TextBox x:Name="ModellBox"
                         MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Modell"
                         Margin="0,0,0,12"/>

                <TextBox x:Name="SeriennummerBox"
                         MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Seriennummer"
                         Margin="0,0,0,12"/>

                <DatePicker x:Name="KaufdatumPicker"
                            MinHeight="40"
                            materialDesign:HintAssist.Hint="Kaufdatum"
                            Margin="0,0,0,12"/>

                <TextBox x:Name="KaufpreisBox"
                         MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Kaufpreis"
                         Margin="0,0,0,12"/>

                <TextBox x:Name="BemerkungBox"
                         MinHeight="110"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Bemerkung"/>

            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4"
                   LastChildFill="False">

            <Button Content="Abbrechen"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Abbrechen_Click"/>

            <Button Content="Speichern"
                    Width="120"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Speichern_Click"/>
        </DockPanel>
    </Grid>
</base:BaseWindow>