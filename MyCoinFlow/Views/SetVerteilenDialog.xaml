<Window x:Class="MyCoinFlow.Views.SetVerteilenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Set verteilen"
        Width="980"
        Height="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="Set verteilen"
                       DockPanel.Dock="Left"/>

            <!-- Abschließen nur wenn editierbar -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Abschließen"
                    Click="CloseSet_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding IsEditable}"/>

            <!-- Speichern nur wenn editierbar -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Save_Click"
                    Padding="14,8"
                    IsEnabled="{Binding IsEditable}"/>

            <!-- Schließen immer möglich -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Schließen"
                    Click="Close_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"/>
        </DockPanel>

        <!-- Kopfinfo -->
        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource MaterialDesignPaper}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding HeaderText}"
                               TextWrapping="Wrap"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DistributedText}"/>
                        <TextBlock Text="{Binding RestText}" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                   Text="{Binding StatusLine}"/>
                    </StackPanel>
                </Grid>

                <!-- Schlüssel Auswahl -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Schluessel}"
                              SelectedItem="{Binding SelectedSchluessel}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Schlüssel (Verteilplan)"
                              MinWidth="260"
                              IsEnabled="{Binding IsEditable}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Auto verteilen (FIX)"
                            Click="AutoFix_Click"
                            Padding="14,8"
                            IsEnabled="{Binding IsEditable}"/>

                    <Button Grid.Column="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Auto verteilen (MEA)"
                            Click="AutoMea_Click"
                            Padding="14,8"
                            IsEnabled="{Binding IsEditable}"/>

                    <Button Grid.Column="6"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Zeilen leeren"
                            Click="ClearRows_Click"
                            Padding="14,8"
                            IsEnabled="{Binding IsEditable}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Zeilen Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Zeile hinzufügen"
                    Click="AddRow_Click"
                    Padding="14,8"
                    IsEnabled="{Binding IsEditable}"/>

            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Zeile löschen"
                    Click="DeleteRow_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding IsEditable}"/>
        </DockPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="6"
                  x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="{Binding IsReadOnlyGrid}">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Eigentümer" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EigentuemerName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Owners, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding EigentuemerId, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="220"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Betrag"
                                    Binding="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140"/>

                <DataGridTextColumn Header="Notiz"
                                    Binding="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}"
                                    Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <TextBlock Grid.Row="8"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   Text="Geschlossene Sets sind schreibgeschützt. Für Änderungen Set wieder öffnen (später)."/>
    </Grid>
</Window>
