<Window x:Class="MyCoinFlow.Views.SetVerteilenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Set verteilen"
        Width="980"
        Height="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="Set verteilen" DockPanel.Dock="Left"/>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Save_Click"
                    Padding="14,8"/>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Schließen"
                    Click="Close_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"/>
        </DockPanel>

        <!-- Kopfinfo -->
        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource MaterialDesignPaper}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DistributedText}"/>
                    <TextBlock Text="{Binding RestText}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Zeile hinzufügen"
                    Click="AddRow_Click"
                    Padding="14,8"/>

            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Zeile löschen"
                    Click="DeleteRow_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"/>
        </DockPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="6"
                  x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Eigentümer" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EigentuemerName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Owners, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding EigentuemerId, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="220"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Betrag"
                                    Binding="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140"/>

                <DataGridTextColumn Header="Notiz"
                                    Binding="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}"
                                    Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <TextBlock Grid.Row="8"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   Text="Hinweis: Punkt oder Komma als Dezimaltrenner möglich."/>
    </Grid>
</Window>
