<Window x:Class="MyCoinFlow.Views.SetVerteilenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Set verteilen"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LINKS: Aktionen -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Aktionen"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Status -->
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Margin="0,6,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="Save_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Speichern"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <!-- Automatik -->
                    <TextBlock Text="Automatik"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="AutoFix_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartPie" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Auto verteilen (FIX)"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="AutoMea_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartDonut" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Auto verteilen (MEA)"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="ClearRows_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistRemove" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zeilen leeren"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <!-- Zeilen -->
                    <TextBlock Text="Zeilen"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="AddRow_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zeile hinzufügen"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="DeleteRow_Click"
                            Padding="14,8"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistMinus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zeile löschen"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RECHTS: Inhalt -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="Set verteilen"/>

            <!-- Status / Titel -->
            <Border Grid.Row="2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding HeaderText}"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding StatusLine}"
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Schlüssel -->
            <Border Grid.Row="4"
                    Background="{DynamicResource MaterialDesignPaper}"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Schlüssel:"
                               Margin="0,0,6,0"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Schluessel}"
                              SelectedItem="{Binding SelectedSchluessel}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding IsEditable}"/>
                </Grid>
            </Border>

            <!-- Grid -->
            <DataGrid x:Name="Grid"
                      Grid.Row="6"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="{Binding IsReadOnlyGrid}"
                      Margin="0,6,0,0">

                <DataGrid.Columns>

                    <!-- ✅ FIX: ItemsSource muss auf DataGrid.DataContext zeigen -->
                    <DataGridComboBoxColumn Header="Eigentümer"
                                            SelectedValueBinding="{Binding EigentuemerId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            Width="2*">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource"
                                        Value="{Binding DataContext.Owners, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource"
                                        Value="{Binding DataContext.Owners, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="IsEditable" Value="False"/>
                                <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <DataGridTextColumn Header="Betrag"
                                        Binding="{Binding BetragText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Notiz"
                                        Binding="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}"
                                        Width="3*"/>

                    <DataGridTextColumn Header="Quelle"
                                        Binding="{Binding Source}"
                                        IsReadOnly="True"
                                        Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totals -->
            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalText}"
                           Margin="0,0,14,0"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DistributedText}"
                           Margin="0,0,14,0"/>
                <TextBlock Text="{Binding RestText}"
                           FontWeight="SemiBold"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
