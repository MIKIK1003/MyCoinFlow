<!-- Benutzersteuerelement für die Adressverwaltung -->
<UserControl x:Class="MyCoinFlow.Views.AddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (vereinheitlicht) -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="AccountPlus"
                    Content="Neue Adresse"
                    Margin="0,0,10,0"
                    Command="{Binding NeuCommand}"/>

            <Button Style="{StaticResource IconTextButton}"
                    Tag="Pencil"
                    Content="Bearbeiten"
                    Margin="0,0,10,0"
                    Command="{Binding BearbeitenCommand}"/>

            <Button Style="{StaticResource IconTextButton.Danger}"
                    Tag="DeleteForever"
                    Content="Löschen"
                    Command="{Binding LoeschenCommand}"/>
        </StackPanel>

        <!-- Tabelle -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Adressen}"
                  SelectedItem="{Binding AusgewaehlteAdresse}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>

                <!-- Icon-Spalte ganz rechts (Standard-Icon/Farbe via DefaultIconStyle) -->
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="42" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Transaktionen der Adresse anzeigen und drucken"
                                    Command="{Binding DataContext.ZeigeAdresseTransaktionenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="0"
                                    HorizontalAlignment="Right">
                                <materialDesign:PackIcon
                                    Kind="FileDocumentMultipleOutline"
                                    Style="{StaticResource DefaultIconStyle}"
                                    Width="24" Height="24"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Daten-Spalten -->
                <DataGridTextColumn Header="Name"       Binding="{Binding Name}"    Width="2*"/>
                <DataGridTextColumn Header="IBAN"       Binding="{Binding IBAN}"    Width="*"/>
                <DataGridTextColumn Header="Typ"        Binding="{Binding Typ}"     Width="*"/>
                <DataGridTextColumn Header="Straße"     Binding="{Binding Strasse}" Width="*"/>
                <DataGridTextColumn Header="PLZ"        Binding="{Binding PLZ}"     Width="Auto"/>
                <DataGridTextColumn Header="Ort"        Binding="{Binding Ort}"     Width="*"/>
                <DataGridTextColumn Header="Land"       Binding="{Binding Land}"    Width="Auto"/>
                <DataGridTextColumn Header="Notiz"      Binding="{Binding Notiz}"   Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
