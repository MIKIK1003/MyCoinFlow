<!-- Benutzersteuerelement für die Adressverwaltung -->
<UserControl x:Class="MyCoinFlow.Views.AddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Command="{Binding NeuCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Neue Adresse"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Command="{Binding BearbeitenCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Bearbeiten"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding LoeschenCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteForever" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Löschen"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Tabelle -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Adressen}"
                  SelectedItem="{Binding AusgewaehlteAdresse}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"       Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="IBAN"       Binding="{Binding IBAN}" Width="*"/>
                <DataGridTextColumn Header="Typ"        Binding="{Binding Typ}" Width="*"/>
                <DataGridTextColumn Header="Straße"     Binding="{Binding Strasse}" Width="*"/>
                <DataGridTextColumn Header="PLZ"        Binding="{Binding PLZ}" Width="Auto"/>
                <DataGridTextColumn Header="Ort"        Binding="{Binding Ort}" Width="*"/>
                <DataGridTextColumn Header="Land"       Binding="{Binding Land}" Width="Auto"/>
                <DataGridTextColumn Header="Notiz"      Binding="{Binding Notiz}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
