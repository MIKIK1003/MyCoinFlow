<UserControl x:Class="MyCoinFlow.Views.VermoegenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LINKS: SIDEBAR -->
        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Filter und Aktionen"
                               Style="{StaticResource SidebarSectionHeader}"/>

                    <TextBlock Text="Suche"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,6"/>

                    <TextBox MinHeight="40"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Titel, ISIN, Depot…"
                             Text="{Binding Suchtext, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Depot"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,14,0,6"/>

                    <ComboBox MinHeight="36"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding DepotFilterListe}"
                              SelectedItem="{Binding SelectedDepotFilter, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Depot wählen…"/>

                    <TextBlock Text="Anlageklasse"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,14,0,6"/>

                    <ComboBox MinHeight="36"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding AnlageklasseFilterListe}"
                              SelectedItem="{Binding SelectedAnlageklasseFilter, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Anlageklasse wählen…"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Magnify"
                                Content="Suchen"
                                MinHeight="40"
                                Margin="0,0,10,0"
                                Width="118"
                                IsDefault="True"
                                Command="{Binding SucheCommand}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="CloseCircle"
                                Content="Leeren"
                                MinHeight="40"
                                Width="118"
                                Command="{Binding FilterLeerenCommand}"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,12"/>

                    <TextBlock Text="Depotverwaltung"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,8"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="PlusCircleOutline"
                            Content="Depot neu"
                            MinHeight="40"
                            Margin="0,0,0,10"
                            Command="{Binding NeuesDepotCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="PencilOutline"
                            Content="Depot bearbeiten"
                            MinHeight="40"
                            Margin="0,0,0,10"
                            Command="{Binding DepotBearbeitenCommand}"/>

                    <Button Style="{StaticResource IconTextButton.Danger}"
                            Tag="DeleteOutline"
                            Content="Depot ausblenden"
                            MinHeight="40"
                            Margin="0,0,0,12"
                            Command="{Binding DepotLoeschenCommand}"/>

                    <Separator Margin="0,10,0,12"/>

                    <TextBlock Text="Positionen"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,8"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="PlusCircleOutline"
                            Content="Neu"
                            MinHeight="40"
                            Margin="0,0,0,10"
                            Command="{Binding NeuePositionCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="PencilOutline"
                            Content="Bearbeiten"
                            MinHeight="40"
                            Margin="0,0,0,10"
                            Command="{Binding PositionBearbeitenCommand}"/>

                    <Button Style="{StaticResource IconTextButton.Danger}"
                            Tag="DeleteOutline"
                            Content="Löschen"
                            MinHeight="40"
                            Command="{Binding PositionLoeschenCommand}"/>

                    <Separator Margin="0,12,0,12"/>

                    <TextBlock Text="Kurse"
           Style="{StaticResource SidebarGroupHeader}"
           Margin="0,0,0,8"/>

                    <Button Style="{StaticResource IconTextButton}"
        Tag="KeyVariant"
        Content="API-Key"
        MinHeight="40"
        Margin="0,0,0,10"
        Command="{Binding ApiEinstellungCommand}"/>

                    <Button Style="{StaticResource IconTextButton}"
        Tag="ChartLine"
        Content="Kurse aktualisieren"
        MinHeight="40"
        Command="{Binding KurseAktualisierenCommand}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RECHTS: INHALT -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="280"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Vermögen"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding FilterTitelText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <UniformGrid Columns="3">
                        <Border Padding="12"
                                Margin="0,0,10,0"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                CornerRadius="{StaticResource AppCornerRadius.Card}">
                            <StackPanel>
                                <TextBlock Text="Depotwert"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                <TextBlock Text="{Binding DepotwertText}"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Margin="0,0,10,0"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                CornerRadius="{StaticResource AppCornerRadius.Card}">
                            <StackPanel>
                                <TextBlock Text="Einstand"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                <TextBlock Text="{Binding EinstandText}"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                CornerRadius="{StaticResource AppCornerRadius.Card}">
                            <StackPanel>
                                <TextBlock Text="Gewinn / Verlust"
                                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                                <TextBlock Text="{Binding GewinnVerlustText}"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Depotverlauf -->
                    <Border Grid.Column="0"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="{StaticResource AppCornerRadius.Card}"
            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Depotverlauf"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                            <lvc:CartesianChart Grid.Row="1"
                                Series="{Binding DepotVerlaufSeries}"
                                XAxes="{Binding DepotVerlaufXAxes}"
                                YAxes="{Binding DepotVerlaufYAxes}"
                                LegendPosition="Hidden"/>
                        </Grid>
                    </Border>

                    <!-- Vermögensaufteilung -->
                    <Border Grid.Column="2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="{StaticResource AppCornerRadius.Card}"
            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Vermögensaufteilung"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                            <lvc:PieChart Grid.Row="1"
                          Series="{Binding VermoegenAufteilungSeries}"
                          LegendPosition="Right"/>
                        </Grid>
                    </Border>
                </Grid>



                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding Positionen}"
                          SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          SelectionUnit="FullRow"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="{x:Null}"
                          materialDesign:DataGridAssist.CellPadding="8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                          RowHeight="40">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button ToolTip="Kursverlauf anzeigen"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0"
                    Command="{Binding DataContext.KursHistorieCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="ChartLine"
                                         Style="{StaticResource DefaultIconStyle}"
                                         Width="22"
                                         Height="22"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="Depot" Binding="{Binding Depot}" Width="150"/>
                        <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="*"/>
                        <DataGridTextColumn Header="ISIN" Binding="{Binding ISIN}" Width="125"/>
                        <DataGridTextColumn Header="Anlageklasse" Binding="{Binding Anlageklasse}" Width="120"/>
                        <DataGridTextColumn Header="Währung" Binding="{Binding Waehrung}" Width="85"/>
                        <DataGridTextColumn Header="Stück" Binding="{Binding AnzahlText}" Width="90"/>
                        <DataGridTextColumn Header="Einstandswert" Binding="{Binding EinstandText}" Width="130"/>
                        <DataGridTextColumn Header="Marktwert" Binding="{Binding AktuellText}" Width="130"/>
                        <DataGridTextColumn Header="Gewinn / Verlust" Binding="{Binding GewinnText}" Width="190"/>
                        <DataGridTextColumn Header="FX" Binding="{Binding FxKursText}" Width="90"/>
                        <DataGridTextColumn Header="Marktwert CHF" Binding="{Binding MarktwertChfText}" Width="135"/>
                        <DataGridTextColumn Header="Gewinn CHF" Binding="{Binding GewinnChfText}" Width="135"/>
                        <DataGridTextColumn Header="Kursdatum" Binding="{Binding KursdatumText}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>