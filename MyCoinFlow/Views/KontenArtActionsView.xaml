<UserControl x:Class="MyCoinFlow.Views.KontenArtActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <StackPanel>
        <StackPanel.Resources>
            <!-- Einheitlicher Abstand zwischen Elementen -->
            <Style TargetType="FrameworkElement">
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="Konten-Art"
                   Style="{StaticResource SidebarGroupHeader}"
                   Margin="0,0,0,8"/>

        <TextBox Text="{Binding NeueBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Neue Bezeichnung"/>

        <Button Style="{StaticResource IconTextButton}"
                Tag="PlusCircleOutline"
                Content="Hinzufügen"
                Command="{Binding HinzufuegenCommand}"
                MinHeight="40"/>

        <Separator Margin="0,6,0,10"/>

        <TextBox Text="{Binding BearbeiteteBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Bezeichnung ändern"/>

        <Button Style="{StaticResource IconTextButton}"
                Tag="Pencil"
                Content="Ändern"
                Command="{Binding BearbeitenCommand}"
                MinHeight="40"/>

        <Separator Margin="0,6,0,10"/>

        <Button Style="{StaticResource IconTextButton.Danger}"
                Tag="DeleteForever"
                Content="Löschen"
                Command="{Binding LoeschenCommand}"
                MinHeight="40"
                Margin="0"/>
    </StackPanel>
</UserControl>