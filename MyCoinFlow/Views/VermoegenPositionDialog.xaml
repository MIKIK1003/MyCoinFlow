<base:BaseWindow x:Class="MyCoinFlow.Views.VermoegenPositionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
                 Title="Vermögensposition"
                 Width="620"
                 Height="1000"
                 SizeToContent="Manual"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Position erfassen / bearbeiten"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <ComboBox MinHeight="40"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Depot"
                          ItemsSource="{Binding Depots}"
                          SelectedItem="{Binding SelectedDepot, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,12"/>

                <TextBox x:Name="TitelBox"
                         MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Titel"
                         Text="{Binding Model.Titel, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
         Style="{StaticResource MaterialDesignOutlinedTextBox}"
         materialDesign:HintAssist.Hint="ISIN"
         Text="{Binding Model.ISIN, UpdateSourceTrigger=PropertyChanged}"
         Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
         Style="{StaticResource MaterialDesignOutlinedTextBox}"
         materialDesign:HintAssist.Hint="Valor"
         Text="{Binding Model.Valor, UpdateSourceTrigger=PropertyChanged}"
         Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Symbol für Kursabfrage, z.B. NESN.SW"
                         Text="{Binding Model.Symbol, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <ComboBox MinHeight="40"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Börse"
                          ItemsSource="{Binding Boersen}"
                          SelectedItem="{Binding Model.Boerse, Mode=TwoWay}"
                          Margin="0,0,0,12"/>

                <ComboBox MinHeight="40"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Anlageklasse"
                          ItemsSource="{Binding Anlageklassen}"
                          SelectedItem="{Binding Model.Anlageklasse, Mode=TwoWay}"
                          Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Anzahl"
                         Text="{Binding AnzahlText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Einstand pro Stück"
                         Text="{Binding EinstandspreisText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <DatePicker MinHeight="40"
                            materialDesign:HintAssist.Hint="Einstanddatum"
                            SelectedDate="{Binding Model.EinstandDatum, Mode=TwoWay}"
                            Margin="0,0,0,12"/>

                <TextBox MinHeight="40"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Aktueller Kurs pro Stück"
                         Text="{Binding AktuellerKursText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <DatePicker MinHeight="40"
                            materialDesign:HintAssist.Hint="Kursdatum"
                            SelectedDate="{Binding Model.KursDatum, Mode=TwoWay}"
                            Margin="0,0,0,12"/>

                <TextBox MinHeight="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Notiz"
                         Text="{Binding Model.Notiz, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <CheckBox Content="Aktiv"
                          IsChecked="{Binding Model.IstAktiv, Mode=TwoWay}"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="ContentSave"
                    Content="Speichern"
                    Width="130"
                    IsDefault="True"
                    Click="Speichern_Click"
                    Margin="0,0,10,0"/>

            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    Width="130"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>