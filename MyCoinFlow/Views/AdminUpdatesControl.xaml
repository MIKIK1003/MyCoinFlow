<UserControl x:Class="MyCoinFlow.Views.Admin.AdminUpdatesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MyCoinFlow.Views.Admin"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinHeight="180" MinWidth="480">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <DockPanel>
            <materialDesign:PackIcon Width="24" Height="24"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     Margin="0,0,8,0"
                                     Kind="Clouddownload"/>
            <TextBlock Text="Updates"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"/>
        </DockPanel>

        <!-- Inhalt -->
        <Border Grid.Row="2"
                Padding="16"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Versionen -->
                    <RowDefinition Height="Auto"/>
                    <!-- Auswahl -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Notes -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Progress -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Versionen -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Aktuelle Version" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentVersionText"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Verfügbare Version" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AvailableVersionText"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Auswahl Lokal / Online -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <TextBlock Text="Quelle:"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <RadioButton x:Name="ModeLocal"
                                 Content="Lokal"
                                 IsChecked="True"
                                 Margin="0,0,16,0"/>

                    <RadioButton x:Name="ModeOnline"
                                 Content="Online"/>
                </StackPanel>

                <!-- Release Notes -->
                <TextBlock Grid.Row="3"
                           x:Name="ReleaseNotesText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                <!-- Progress -->
                <ProgressBar Grid.Row="5"
                             x:Name="DownloadProgress"
                             Height="6"
                             Visibility="Collapsed"
                             IsIndeterminate="False"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="7"
                            Orientation="Horizontal"
                            Visibility="Collapsed">

                    <Button x:Name="CheckButton"
                            Click="CheckButton_Click"
                            Style="{StaticResource IconTextButton}"
                            Tag="shieldsearch"
                            Content="Suchen"
                            Margin="0,0,5,0"/>

                    <Button x:Name="BackupButton"
                            Click="BackupButton_Click"
                            Style="{StaticResource IconTextButton}"
                            Tag="databaseexport"
                            Content="Sichern"
                            Margin="0,0,5,0"/>

                    <Button x:Name="UpdateButton"
                            Click="UpdateButton_Click"
                            Style="{StaticResource IconTextButton}"
                            Tag="update"
                            Content="Updaten"
                            IsEnabled="False"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>