<UserControl x:Class="MyCoinFlow.Views.Admin.AdminUpdatesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MyCoinFlow.Views.Admin"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinHeight="180" MinWidth="480">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titelzeile: Template/Icon via x:Static (kein Button) -->
        <DockPanel>
            <materialDesign:PackIcon Width="24" Height="24"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     Margin="0,0,8,0"
                                     Kind="{x:Static materialDesign:PackIconKind.CloudUpload}"/>
            <TextBlock Text="Updates"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"/>
        </DockPanel>

        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="12"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kopfwerte -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Aktuelle Version" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentVersionText"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Verfügbare Version" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AvailableVersionText"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Release Notes -->
                <TextBlock Grid.Row="2" x:Name="ReleaseNotesText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                <!-- Downloadfortschritt -->
                <ProgressBar Grid.Row="4" x:Name="DownloadProgress"
                             Height="6"
                             Visibility="Collapsed"
                             IsIndeterminate="False"/>

                <!-- Aktionen: Buttons nach Standard = IconTextButton (Icon via Tag, Text via Content) -->
                <StackPanel Grid.Row="6" Orientation="Horizontal">

                    <!-- Nach Updates suchen -->
                    <Button x:Name="CheckButton"
                            Click="CheckButton_Click"
                            Style="{StaticResource IconTextButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Tag="CloudSearch"
                            Content="Nach Updates suchen"
                            Margin="0,0,8,0"/>

                    <!-- Datenbank sichern -->
                    <Button x:Name="BackupButton"
                            Click="BackupButton_Click"
                            Style="{StaticResource IconTextButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Tag="ContentSave"
                            Content="Datenbank sichern…"
                            Margin="0,0,8,0"/>

                    <!-- Jetzt updaten -->
                    <Button x:Name="UpdateButton"
                            Click="UpdateButton_Click"
                            Style="{StaticResource IconTextButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Tag="CloudDownload"
                            Content="Jetzt updaten"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
