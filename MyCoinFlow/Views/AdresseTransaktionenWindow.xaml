<Window x:Class="MyCoinFlow.Views.AdresseTransaktionenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Titel}"
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel>

        <!-- Linke Seitenleiste: Filter & Aktionen (vertikal, platzsparend) -->
        <Border DockPanel.Dock="Left"
                Width="320"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" Orientation="Vertical">

                    <!-- Überschrift -->
                    <TextBlock Text="Filter und Aktionen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- Betrag -->
                    <TextBlock Text="Betrag" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="130"
                                 Margin="0,0,6,0"
                                 materialDesign:HintAssist.Hint="min"
                                 Text="{Binding FilterMinBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="130"
                                 materialDesign:HintAssist.Hint="max"
                                 Text="{Binding FilterMaxBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Datum -->
                    <TextBlock Text="Datum" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker Width="145"
                                    Margin="0,0,6,0"
                                    materialDesign:HintAssist.Hint="von"
                                    SelectedDate="{Binding FilterVon, UpdateSourceTrigger=PropertyChanged}"/>
                        <DatePicker Width="145"
                                    materialDesign:HintAssist.Hint="bis"
                                    SelectedDate="{Binding FilterBis, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Konto -->
                    <TextBlock Text="Konto" Margin="0,12,0,4"/>
                    <ComboBox Width="290"
                              IsEditable="True"
                              ItemsSource="{Binding KontenLookup}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Anzeige"
                              SelectedValue="{Binding FilterKontoId, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Geldinstitut -->
                    <TextBlock Text="Geldinstitut" Margin="0,12,0,4"/>
                    <ComboBox Width="290"
                              ItemsSource="{Binding Geldinstitute}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding FilterGeldinstitutId, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Aktionen -->
                    <StackPanel Margin="0,16,0,0" Orientation="Vertical">
                        <Button Content="Filter anwenden"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ApplyFilterCommand}"/>

                        <Button Content="Zurücksetzen"
                                Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ResetFilterCommand}"/>

                        <Separator Margin="0,8,0,8"/>

                        <!-- Drucken und Schließen: bewusst unten -->
                        <Button Click="Print_Click"
                                ToolTip="Drucken (A4 Querformat)"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,6,0"/>
                                <TextBlock Text="Drucken"/>
                            </StackPanel>
                        </Button>

                        <Button Content="Schließen"
                                Margin="0,8,0,0"
                                Click="Close_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>

                    <!-- Zusammenfassung -->
                    <Border Margin="0,16,0,0" Padding="8"
        Background="{DynamicResource MaterialDesignPaper}"
        BorderBrush="{DynamicResource MaterialDesignDivider}"
        BorderThickness="1"
        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Einnahmen -->
                                <RowDefinition Height="Auto"/>
                                <!-- Ausgaben -->
                                <RowDefinition Height="Auto"/>
                                <!-- Linie -->
                                <RowDefinition Height="Auto"/>
                                <!-- Saldo -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Einnahmen -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Einnahmen" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummeEinnahmenText}" TextAlignment="Right"/>

                            <!-- Ausgaben -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ausgaben" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummeAusgabenText}" TextAlignment="Right"/>

                            <!-- Unterlinie über die volle Breite -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2"
                Margin="0,6,0,6"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"/>

                            <!-- Saldo -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Saldo" FontWeight="Bold" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SaldoText}" TextAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                    </Border>


                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Hauptbereich rechts: Tabelle -->
        <Grid Margin="12">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      SelectionUnit="FullRow"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                <DataGrid.Resources>
                    <Style x:Key="TrimLeft" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                    <Style x:Key="TrimRight" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat={}{0:yyyy-MM-dd}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Einnahmen" Binding="{Binding Einnahmen, StringFormat={}{0:N2}}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ausgaben" Binding="{Binding Ausgaben, StringFormat={}{0:N2}}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Geldinstitut" Binding="{Binding GeldinstitutName}" Width="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
