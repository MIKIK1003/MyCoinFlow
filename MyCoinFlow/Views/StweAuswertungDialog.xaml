<base:BaseWindow x:Class="MyCoinFlow.Views.StweAuswertungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Auswertung – Eigentümer"
        Width="1100"
        Height="700"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Filter -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="{Binding TitleText}" />

            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding Von, UpdateSourceTrigger=PropertyChanged}" />

            <DatePicker Grid.Column="4"
                        SelectedDate="{Binding Bis, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Aktualisieren"
                        Click="Refresh_Click"
                        Padding="14,8"
                        Margin="0,0,10,0"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Print_Click"
                        Padding="14,8"
                        ToolTip="Drucken (PDF über Druckerauswahl)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Drucken"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Summen pro Eigentümer" />
                    <DataGrid x:Name="OwnerGrid"
                              ItemsSource="{Binding OwnerRows}"
                              SelectedItem="{Binding SelectedOwnerRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,8,0,0"
                              SelectionChanged="OwnerGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Eigentümer" Binding="{Binding EigentuemerName}" Width="2*"/>
                            <DataGridTextColumn Header="Summe" Binding="{Binding Summe}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right -->
            <Border Grid.Column="2" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Text="{Binding DetailTitle}" />
                    <DataGrid ItemsSource="{Binding DetailRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="120"/>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="3*"/>
                            <DataGridTextColumn Header="Schlüssel" Binding="{Binding Schluessel}" Width="150"/>
                            <DataGridTextColumn Header="Betrag" Binding="{Binding Betrag}" Width="120"/>
                            <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</base:BaseWindow>