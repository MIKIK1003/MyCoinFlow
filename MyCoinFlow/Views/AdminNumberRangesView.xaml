<UserControl x:Class="MyCoinFlow.Views.AdminNumberRangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal">
            <Button Click="Neu_Click" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusCircleOutline" Margin="0,0,6,0"/>
                    <TextBlock Text="Neu"/>
                </StackPanel>
            </Button>
            <Button Click="Speichern_Click" Margin="0,0,8,0" Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Margin="0,0,6,0"/>
                    <TextBlock Text="Speichern"/>
                </StackPanel>
            </Button>
            <Button Click="Loeschen_Click" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,6,0"/>
                    <TextBlock Text="Löschen"/>
                </StackPanel>
            </Button>
            <Button Click="Reload_Click" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0,0,6,0"/>
                    <TextBlock Text="Neu laden"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="RulesGrid" Grid.Row="2"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Single"
              IsReadOnly="False"
              materialDesign:DataGridAssist.CellPadding="12"
              materialDesign:DataGridAssist.ColumnHeaderPadding="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Von (Nr.)"
                            Binding="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"
                            Width="120"/>
                <DataGridTextColumn Header="Bis (Nr.)"
                            Binding="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"
                            Width="120"/>

                <DataGridComboBoxColumn Header="Richtung"
                                SelectedItemBinding="{Binding Richtung, UpdateSourceTrigger=PropertyChanged}"
                                Width="150"/>

                <!-- NEU: Bezeichnung (nur Anzeige, feste Auswahl) -->
                <DataGridComboBoxColumn Header="Bezeichnung"
                                SelectedItemBinding="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}"
                                Width="260"/>

                <DataGridCheckBoxColumn Header="Ist Budgetkonto"
                                Binding="{Binding IstBudgetkonto, UpdateSourceTrigger=PropertyChanged}"
                                Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Hinweis -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <materialDesign:PackIcon Kind="InformationOutline" Margin="0,0,8,0"/>
            <TextBlock Text="Spezifischste Regel gewinnt (kleinster Bereich). Bezeichnung dient aktuell nur der Verständlichkeit."
                 Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
