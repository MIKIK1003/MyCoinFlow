<UserControl x:Class="MyCoinFlow.Views.AdminNumberRangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (vereinheitlicht) -->
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="archiveplus"
                    Content="Neu"
                    Margin="0,0,10,0"
                    Click="Neu_Click"/>

            <Button Style="{StaticResource IconTextButton}"
                    Tag="archiveedit"
                    Content="Speichern"
                    Margin="0,0,10,0"
                    Click="Speichern_Click"/>

            <Button Style="{StaticResource IconTextButton.Danger}"
                    Tag="archiveminus"
                    Content="Löschen"
                    Margin="0,0,10,0"
                    Click="Loeschen_Click"/>

            <Button Style="{StaticResource IconTextButton}"
                    Tag="archiverefresh"
                    Content="Neu laden"
                    Click="Reload_Click"/>
        </StackPanel>

        <!-- Abstand -->
        <Border Grid.Row="1"/>

        <!-- Grid -->
        <DataGrid x:Name="RulesGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  materialDesign:DataGridAssist.CellPadding="12"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12">

            <DataGrid.Resources>
                <!-- rechte Ausrichtung für Zahlen (optional, Standard wie in anderen Views) -->
                <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Padding" Value="0,0,8,0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Von (Nr.)"
                                    Binding="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Bis (Nr.)"
                                    Binding="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>

                <DataGridComboBoxColumn Header="Richtung"
                                        SelectedItemBinding="{Binding Richtung, UpdateSourceTrigger=PropertyChanged}"
                                        Width="150"/>

                <!-- Bezeichnung (nur Anzeige, feste Auswahl) -->
                <DataGridComboBoxColumn Header="Bezeichnung"
                                        SelectedItemBinding="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}"
                                        Width="260"/>

                <DataGridCheckBoxColumn Header="Ist Budgetkonto"
                                        Binding="{Binding IstBudgetkonto, UpdateSourceTrigger=PropertyChanged}"
                                        Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Hinweis -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <materialDesign:PackIcon Kind="InformationOutline"
                                     Style="{StaticResource DefaultIconStyle}"/>
            <TextBlock Text="Spezifischste Regel gewinnt (kleinster Bereich). Bezeichnung dient aktuell nur der Verständlichkeit."
                       Margin="0,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
