<UserControl x:Class="MyCoinFlow.Views.AdminNumberRangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== LINKS: SIDEBAR ================== -->
        <Border Grid.Column="0"
        Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Aktionen"
                       Style="{StaticResource SidebarSectionHeader}"/>

                    <TextBlock Text="Nummernkreise"
                       Style="{StaticResource SidebarGroupHeader}"
                       Margin="0,0,0,8"/>

                    <Button Style="{StaticResource IconTextButton}"
                    Tag="archiveplus"
                    Content="Neu"
                    MinHeight="40"
                    Margin="0,0,0,10"
                    Click="Neu_Click"/>

                    <Button Style="{StaticResource IconTextButton}"
                    Tag="archiveedit"
                    Content="Speichern"
                    MinHeight="40"
                    Margin="0,0,0,10"
                    Click="Speichern_Click"/>

                    <Button Style="{StaticResource IconTextButton.Danger}"
                    Tag="archiveminus"
                    Content="Löschen"
                    MinHeight="40"
                    Margin="0,0,0,10"
                    Click="Loeschen_Click"/>

                    <Button Style="{StaticResource IconTextButton}"
                    Tag="archiverefresh"
                    Content="Neu laden"
                    MinHeight="40"
                    Margin="0,0,0,0"
                    Click="Reload_Click"/>

                    <Separator Margin="0,14,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                         Style="{StaticResource DefaultIconStyle}"
                                         VerticalAlignment="Top"
                                         Margin="0,1,8,0"/>
                        <TextBlock Text="Spezifischste Regel gewinnt (kleinster Bereich). Bezeichnung dient aktuell nur der Verständlichkeit."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                           Margin="0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================== RECHTS: CONTENT ================== -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <DataGrid x:Name="RulesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      IsReadOnly="False"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="{x:Null}"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      materialDesign:DataGridAssist.CellPadding="12"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12">

                <DataGrid.Resources>
                    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="Padding" Value="0,0,8,0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Von (Nr.)"
                                        Binding="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"
                                        ElementStyle="{StaticResource RightAlignedCell}"/>
                    <DataGridTextColumn Header="Bis (Nr.)"
                                        Binding="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"
                                        ElementStyle="{StaticResource RightAlignedCell}"/>

                    <DataGridComboBoxColumn Header="Richtung"
                                            SelectedItemBinding="{Binding Richtung, UpdateSourceTrigger=PropertyChanged}"
                                            Width="150"/>

                    <DataGridComboBoxColumn Header="Bezeichnung"
                                            SelectedItemBinding="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}"
                                            Width="260"/>

                    <DataGridCheckBoxColumn Header="Ist Budgetkonto"
                                            Binding="{Binding IstBudgetkonto, UpdateSourceTrigger=PropertyChanged}"
                                            Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

        </Border>

    </Grid>
</UserControl>