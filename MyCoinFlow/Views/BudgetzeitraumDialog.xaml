<Window x:Class="MyCoinFlow.Views.BudgetzeitraumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Budgetzeitraum bearbeiten"
        Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Formular -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bezeichnung -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bezeichnung:" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="BezeichnungBox"
                     Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,8"/>

            <!-- Startdatum -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Startdatum:" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartdatumPicker"
                        Grid.Row="1" Grid.Column="1"
                        Margin="0,0,0,8"/>

            <!-- Enddatum -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Enddatum:" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <DatePicker x:Name="EnddatumPicker"
                        Grid.Row="2" Grid.Column="1"
                        Margin="0,0,0,8"/>

            <!-- Aktiv -->
            <CheckBox x:Name="AktivCheckBox"
                      Grid.Row="3" Grid.ColumnSpan="2"
                      Content="Aktiv"
                      Margin="0,4,0,0"/>
        </Grid>

        <!-- Footer-Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="ContentSaveCheckOutline"
                    Content="Speichern"
                    Margin="0,0,10,0"
                    Click="Speichern_Click"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    Click="Abbrechen_Click"/>
        </StackPanel>
    </Grid>
</Window>
