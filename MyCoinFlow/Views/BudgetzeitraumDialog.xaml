<Window x:Class="MyCoinFlow.Views.BudgetzeitraumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budgetzeitraum bearbeiten"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bezeichnung:" Grid.Row="0" />
        <TextBox x:Name="BezeichnungBox" Grid.Row="1" />

        <TextBlock Text="Startdatum:" Grid.Row="2" Margin="0,10,0,0" />
        <DatePicker x:Name="StartdatumPicker" Grid.Row="3" />

        <TextBlock Text="Enddatum:" Grid.Row="4" Margin="0,10,0,0" />
        <DatePicker x:Name="EnddatumPicker" Grid.Row="5" />

        <CheckBox x:Name="AktivCheckBox"
                  Content="Aktiv"
                  Grid.Row="6"
                  Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal"
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Speichern" Width="100" Margin="0,0,10,0" Click="Speichern_Click"/>
            <Button Content="Abbrechen" Width="100" Click="Abbrechen_Click"/>
        </StackPanel>
    </Grid>
</Window>
