<UserControl x:Class="MyCoinFlow.Views.TransaktionSetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="Transaktion Sets"
                       DockPanel.Dock="Left"/>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding NeuesSetAusTransaktionCommand}"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlaylistPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Set aus Transaktion"/>
                </StackPanel>
            </Button>

            <Button DockPanel.Dock="Right"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Command="{Binding ShowAuswertungCommand}"
        Padding="14,8"
        Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartBoxOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Auswertung…"/>
                </StackPanel>
            </Button>


            <Button DockPanel.Dock="Right"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Command="{Binding SetVerteilenCommand}"
        Padding="14,8"
        Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FormatListChecks" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Verteilen…"/>
                </StackPanel>
            </Button>


        </DockPanel>

        <!-- Filter -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Liegenschaften}"
                      SelectedItem="{Binding SelectedLiegenschaft}"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="Liegenschaft" />

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Sets -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Sets}"
                  SelectedItem="{Binding SelectedSet}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,6,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="120"/>
                <DataGridTextColumn Header="Betrag" Binding="{Binding Betrag}" Width="120"/>
                <DataGridTextColumn Header="Titel" Binding="{Binding Titel}" Width="3*"/>
                <DataGridTextColumn Header="Verteilt" Binding="{Binding Verteilt}" Width="120"/>
                <DataGridTextColumn Header="Rest" Binding="{Binding Rest}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding IsClosed}" Width="100"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
