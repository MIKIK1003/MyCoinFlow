<Window x:Class="MyCoinFlow.Views.GeldinstitutTransaktionenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Transaktionen – Geldinstitut"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel>

        <!-- FILTERBAR / KOPF -->
        <Border DockPanel.Dock="Top" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Betrag min/max -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Betrag" />
                    <TextBox Width="100" Margin="0,0,6,0" materialDesign:HintAssist.Hint="min"
                             Text="{Binding FilterMinBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="100" materialDesign:HintAssist.Hint="max"
                             Text="{Binding FilterMaxBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Datum -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Datum" />
                    <DatePicker Width="145" Margin="0,0,6,0"
                                SelectedDate="{Binding FilterVon, UpdateSourceTrigger=PropertyChanged}"/>
                    <DatePicker Width="145"
                                SelectedDate="{Binding FilterBis, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Adresse -->
                <StackPanel Orientation="Horizontal" Grid.Column="4">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Adresse" />
                    <ComboBox Width="220" IsEditable="True"
                              ItemsSource="{Binding Adressen}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding FilterAdresseId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Konto -->
                <StackPanel Orientation="Horizontal" Grid.Column="6">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Budgetkonto" />
                    <ComboBox Width="260"
                              ItemsSource="{Binding KontenLookup}"
                              SelectedValuePath="Id" DisplayMemberPath="Anzeige"
                              SelectedValue="{Binding FilterKontoId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Actions (rechts) -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"
                               Text="{Binding SummaryText}"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            ToolTip="Drucken (A4 Querformat)"
                            Click="Print_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="Drucken"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Anwenden" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ApplyFilterCommand}"/>
                    <Button Content="Zurücksetzen" Margin="0,0,8,0"
                            Command="{Binding ResetFilterCommand}"/>
                    <Button Content="Schliessen" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GRID -->
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
          Margin="12" RowHeaderWidth="0"
          SelectionUnit="FullRow"
          materialDesign:DataGridAssist.CellPadding="8"
          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Resources>
                <!-- Einzeilig + Ellipsis + Left -->
                <Style x:Key="TrimLeft" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                </Style>
                <!-- Einzeilig + Ellipsis + Right -->
                <Style x:Key="TrimRight" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Konto: halb so breit (vorher 2*) -->
                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="*" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Datum: 40% schmaler (vorher 110) -->
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat={}{0:yyyy-MM-dd}}" Width="66">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Beträge: unverändert -->
                <DataGridTextColumn Header="Einnahmen" Binding="{Binding Einnahmen, StringFormat={}{0:N2}}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ausgaben" Binding="{Binding Ausgaben, StringFormat={}{0:N2}}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Adresse: halb (vorher 220 -> 110), einzeilig + Ellipsis -->
                <DataGridTextColumn Header="Adresse" Binding="{Binding AdresseName}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Notiz: füllt Rest, einzeilig + Ellipsis -->
                <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
