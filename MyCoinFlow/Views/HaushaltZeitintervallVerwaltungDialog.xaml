<base:BaseWindow x:Class="MyCoinFlow.Views.HaushaltZeitintervallVerwaltungDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
                 Title="Zeitintervalle"
                 Width="720"
                 Height="520"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zeitintervalle verwalten"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <DataGrid x:Name="IntervallGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Bezeichnung"
                                    Binding="{Binding Bezeichnung}"
                                    Width="220"/>

                <DataGridTextColumn Header="Tage"
                                    Binding="{Binding Tage}"
                                    Width="90"/>

                <DataGridTextColumn Header="Bemerkung"
                                    Binding="{Binding Bemerkung}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4"
                   LastChildFill="False">

            <Button Content="Neu"
                    Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Neu_Click"/>

            <Button Content="Bearbeiten"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Bearbeiten_Click"/>

            <Button Content="Löschen"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="Loeschen_Click"/>

            <Button Content="Schließen"
                    Width="120"
                    Click="Schliessen_Click"/>
        </DockPanel>
    </Grid>
</base:BaseWindow>