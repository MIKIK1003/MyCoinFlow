<UserControl x:Class="MyCoinFlow.Views.CreditCardImportMappingView"
             xmlns:helpers="clr-namespace:MyCoinFlow.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    
        <UserControl.Resources>
            <!-- DataContext der View als Proxy verfügbar machen -->
            <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        </UserControl.Resources>
        
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="CreditCardOutline" Width="26" Height="26" Foreground="DarkViolet" Margin="0,0,8,0"/>
            <TextBlock Text="Kreditkarten-Import · Feld-Mapping" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Auswahl & Aktionen -->
        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                <ComboBox Width="260"
                          ItemsSource="{Binding Schemas}"
                          SelectedItem="{Binding SelectedSchema}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Schema auswählen"/>

                <TextBox Width="260" Margin="12,0,0,0"
                         Text="{Binding SelectedSchema.Name, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Schema-Name"/>

                <Button Command="{Binding NewSchemaCommand}" Margin="12,0,0,0"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Neues Schema"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSchemaCommand}" Margin="12,0,0,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding CanDeleteSelectedSchema}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Löschen"/>
                    </StackPanel>
                </Button>

                <Border Margin="20,0,0,0" Padding="6,2" CornerRadius="4" BorderThickness="1" BorderBrush="#DDD">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Master:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding MasterHeaders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,0" Padding="4,2" CornerRadius="3" Background="#F2F2F2">
                                        <TextBlock Text="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Mapping-Tabelle -->
            <DataGrid ItemsSource="{Binding FieldMappings}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Master-Feld (links)"
                                            SelectedItemBinding="{Binding MasterHeader, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding Data.MasterHeaders, Source={StaticResource VmProxy}}"
                                            Width="*"/>
                    <DataGridTextColumn Header="Header im neuen Excel (rechts)"
                                        Binding="{Binding SourceHeader, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Stellvertreter (Fallback)"
                                        Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                        Width="2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Fußleiste -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding SuggestFromSampleCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Aus Musterdatei vorschlagen"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}" Margin="12,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="{Binding CanSave}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Speichern"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
