<UserControl x:Class="MyCoinFlow.Views.CreditCardImportMappingView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinHeight="360" MinWidth="760">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titel -->
            <RowDefinition Height="Auto"/>
            <!-- Kopfzeile -->
            <RowDefinition Height="*"/>
            <!-- Tabelle -->
            <RowDefinition Height="Auto"/>
            <!-- Hinweis -->
        </Grid.RowDefinitions>

        <!-- Titel -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="CreditCardOutline"
                                     Width="24" Height="24"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     Margin="0,0,8,0"/>
            <TextBlock Text="Kreditkarten-Import – Schema"
                       VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- Kopfzeile: Schema-Auswahl | Schema-Name | Neu | Speichern | Löschen -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Schema:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox  Grid.Column="1"
                       x:Name="SchemaCombo"
                       IsEditable="False"
                       DisplayMemberPath="Name"
                       SelectedValuePath="Id"
                       SelectionChanged="SchemaCombo_SelectionChanged"
                       Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <TextBox   Grid.Column="3"
                       x:Name="SchemaNameBox"
                       materialDesign:HintAssist.Hint="Schema-Name"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       TextChanged="SchemaNameBox_TextChanged"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="NewSchema_Click"
                        Style="{StaticResource IconTextButton}"
                        Tag="Plus"
                        Content="Neu"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                        Click="SaveSchema_Click"
                        Style="{StaticResource IconTextButton}"
                        Tag="ContentSave"
                        Content="Speichern"
                        Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton"
                        Click="DeleteSchema_Click"
                        Style="{StaticResource IconTextButton}"
                        Tag="DeleteForever"
                        Content="Löschen"/>
            </StackPanel>
        </Grid>

        <!-- Mapping-Tabelle -->
        <DataGrid Grid.Row="2"
                  x:Name="GridMappings"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  Margin="0,8,0,8"
                  RowHeaderWidth="0"
                  IsReadOnly="False"
                  ItemsSource="{Binding Rows, ElementName=Root}">
            <DataGrid.Columns>
                <!-- Masterfeld: Dropdown (sichtbar + editierbar) -->
                <DataGridComboBoxColumn Header="Masterfeld"
                                        Width="2*"
                                        SelectedItemBinding="{Binding MasterHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding MasterHeaders, ElementName=Root}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding MasterHeaders, ElementName=Root}"/>
                            <Setter Property="IsEditable" Value="False"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>

                <!-- Quelldatei-Feld -->
                <DataGridTextColumn Header="Quelldatei-Feld"
                                    Width="2*"
                                    Binding="{Binding SourceHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Fallback -->
                <DataGridTextColumn Header="Fallback"
                                    Width="2*"
                                    Binding="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="Masterfelder per Dropdown wählen. Speichern legt/überschreibt die Mappings zum gewählten Schema."/>
    </Grid>
</UserControl>
