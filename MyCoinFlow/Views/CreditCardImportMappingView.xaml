<UserControl x:Class="MyCoinFlow.Views.CreditCardImportMappingView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinHeight="360" MinWidth="760">

    <!-- Wichtig: kein Außen-Margin, damit kein zusätzlicher „Layer“ entsteht -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== LINKS: SIDEBAR ================== -->
        <Border Grid.Column="0"
        Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- exakt wie Kontenplan -->
                    <TextBlock Text="Aktionen"
                       Style="{StaticResource SidebarSectionHeader}"/>

                    <TextBlock Text="Kreditkarten"
                       Style="{StaticResource SidebarGroupHeader}"
                       Margin="0,0,0,8"/>

                    <!-- Schema (kein GroupHeader mehr, damit es nicht „tiefer“ wirkt als Kontenplan) -->
                    <TextBlock Text="Schema"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                    <TextBlock Text="Schema auswählen"
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                       Margin="0,0,0,6"/>

                    <ComboBox x:Name="SchemaCombo"
                      IsEditable="False"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="SchemaCombo_SelectionChanged"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      MinHeight="36"/>

                    <TextBox x:Name="SchemaNameBox"
                     Margin="0,12,0,0"
                     materialDesign:HintAssist.Hint="Schema-Name"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     TextChanged="SchemaNameBox_TextChanged"/>

                    <Separator Margin="0,14,0,12"/>

                    <!-- Aktionen (ohne zweite Überschrift "Aktionen") -->
                    <Button Click="NewSchema_Click"
                    Style="{StaticResource IconTextButton}"
                    Tag="Plus"
                    Content="Neu"
                    MinHeight="40"
                    Margin="0,0,0,10"/>

                    <Button x:Name="SaveButton"
                    Click="SaveSchema_Click"
                    Style="{StaticResource IconTextButton}"
                    Tag="ContentSave"
                    Content="Speichern"
                    MinHeight="40"
                    Margin="0,0,0,10"/>

                    <Button x:Name="DeleteButton"
                    Click="DeleteSchema_Click"
                    Style="{StaticResource IconTextButton.Danger}"
                    Tag="DeleteForever"
                    Content="Löschen"
                    MinHeight="40"/>

                    <Separator Margin="0,14,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                         Style="{StaticResource DefaultIconStyle}"
                                         VerticalAlignment="Top"
                                         Margin="0,1,8,0"/>
                        <TextBlock Text="Masterfelder per Dropdown wählen. Speichern legt oder überschreibt die Mappings zum gewählten Schema."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================== RECHTS: CONTENT ================== -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="CreditCardOutline"
                                             Width="24" Height="24"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Kreditkarten-Import – Schema"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="GridMappings"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          HeadersVisibility="Column"
                          Margin="0"
                          RowHeaderWidth="0"
                          IsReadOnly="False"
                          ItemsSource="{Binding Rows, ElementName=Root}"
                          materialDesign:DataGridAssist.CellPadding="8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                          RowHeight="40"
                          Background="{DynamicResource MaterialDesignPaper}"
                          RowBackground="{DynamicResource MaterialDesignPaper}"
                          AlternatingRowBackground="{x:Null}">
                    <DataGrid.Columns>

                        <DataGridComboBoxColumn Header="Masterfeld"
                                                Width="2*"
                                                SelectedItemBinding="{Binding MasterHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding MasterHeaders, ElementName=Root}"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding MasterHeaders, ElementName=Root}"/>
                                    <Setter Property="IsEditable" Value="False"/>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>

                        <DataGridTextColumn Header="Quelldatei-Feld"
                                            Width="2*"
                                            Binding="{Binding SourceHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn Header="Fallback"
                                            Width="2*"
                                            Binding="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</UserControl>