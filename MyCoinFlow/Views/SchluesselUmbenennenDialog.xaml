<base:BaseWindow x:Class="MyCoinFlow.Views.SchluesselUmbenennenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Schlüssel umbenennen"
        Width="520"
        Height="220"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Schlüssel umbenennen"
                   FontSize="18"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="2"
                   Text="{Binding AlteBezeichnung}"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   TextWrapping="Wrap"/>

        <TextBox Grid.Row="4"
                 Text="{Binding NeueBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Neue Bezeichnung"
                 Margin="0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Abbrechen"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Width="120"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>