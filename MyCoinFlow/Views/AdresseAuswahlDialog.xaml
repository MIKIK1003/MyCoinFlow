<Window x:Class="MyCoinFlow.Views.AdresseAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Adresse wählen / anlegen"
        Width="520"
        MinWidth="520"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollbar verhindert Abschneiden; SizeToContent passt Höhe an -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0,0,0,8">

                <!-- Vorhandene Adresse wählen -->
                <TextBlock Text="Vorhandene Adresse wählen:" Margin="0,0,0,6"/>
                <ComboBox x:Name="AdrBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Height="32"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                <Separator Margin="0,12,0,12"/>

                <!-- Neue Adresse anlegen -->
                <TextBlock Text="Neue Adresse anlegen:" Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Name" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="NeuNameBox" Width="360"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IBAN" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="NeuIbanBox" Width="360"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="AccountPlus"
                        Content="Neu anlegen"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Click="NeuAnlegen_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer-Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    Margin="0,0,8,0"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="CheckBold"
                    Content="Übernehmen"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
