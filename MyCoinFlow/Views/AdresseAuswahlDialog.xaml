<Window x:Class="MyCoinFlow.Views.AdresseAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adresse wählen / anlegen"
        Width="520"
        MinWidth="520"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollbar verhindert Abschneiden; SizeToContent passt Höhe an -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0,0,0,8" >
                <TextBlock Text="Vorhandene Adresse wählen:" Margin="0,0,0,6"/>
                <ComboBox x:Name="AdrBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Height="32"/>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="Neue Adresse anlegen:" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Name" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="NeuNameBox" Width="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IBAN" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="NeuIbanBox" Width="360"/>
                </StackPanel>

                <Button Content="Neu anlegen"
                        Width="120"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Click="NeuAnlegen_Click"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Click="Abbrechen_Click"/>
            <Button Content="Übernehmen" IsDefault="True" Width="120" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
