<base:BaseWindow x:Class="MyCoinFlow.Views.LiegenschaftNeuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Liegenschaft anlegen"
        Width="520"
        Height="420"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Neue Liegenschaft" />

        <TextBox Grid.Row="2"
                 x:Name="NameBox"
                 materialDesign:HintAssist.Hint="Name (z. B. MFH Musterstrasse 12)"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4"
                 materialDesign:HintAssist.Hint="Strasse"
                 Text="{Binding Strasse, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     materialDesign:HintAssist.Hint="PLZ"
                     Text="{Binding PLZ, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Grid.Column="2"
                     materialDesign:HintAssist.Hint="Ort"
                     Text="{Binding Ort, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBox Grid.Row="8"
                 materialDesign:HintAssist.Hint="Notiz"
                 AcceptsReturn="True"
                 Height="90"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Abbrechen"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>