<UserControl x:Class="MyCoinFlow.Views.BudgetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MyCoinFlow.Helpers">
    <UserControl.Resources>
        <helpers:DecimalOrNullConverter x:Key="DecOrNull" />
    </UserControl.Resources>

    <Grid Margin="20">
        <DataGrid x:Name="GridBudget"
              ItemsSource="{Binding Zeilen}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="False"
              SelectionUnit="FullRow"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              CellEditEnding="GridBudget_CellEditEnding"
              RowEditEnding="GridBudget_RowEditEnding"
              materialDesign:DataGridAssist.CellPadding="8,6,8,6"
              materialDesign:DataGridAssist.ColumnHeaderPadding="8,6,8,6">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr."           Width="80"  Binding="{Binding Kontonummer}"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Art"           Width="*"    Binding="{Binding Art}"          IsReadOnly="True"/>
                <DataGridTextColumn Header="Gruppe"        Width="*"    Binding="{Binding Gruppe}"       IsReadOnly="True"/>
                <DataGridTextColumn Header="Untergruppe"   Width="*"    Binding="{Binding Untergruppe}"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Detail"        Width="2*"   Binding="{Binding Detail}"       IsReadOnly="True"/>

                <!-- Editierbar: Budget (gültig -> sofort speichern; ungültig -> ignorieren) -->
                <DataGridTextColumn Header="Budget" Width="120">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,10,0"/>
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>

                    <!-- HIER: CHF-Format (C2) verwenden, Converter nur fürs Parsen -->
                    <DataGridTextColumn.Binding>
                        <Binding Path="Budgetwert"
                 Converter="{StaticResource DecOrNull}"
                 UpdateSourceTrigger="LostFocus"
                 StringFormat="{}{0:C2}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>





            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
