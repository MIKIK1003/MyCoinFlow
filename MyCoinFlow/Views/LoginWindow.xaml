<Window x:Class="MyCoinFlow.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MyCoinFlow – Anmeldung"
        Height="640" Width="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <!-- lokale, sichere UI-Defaults (keine neuen App-Keys nötig) -->
        <Style x:Key="LoginLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="LoginHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LoginSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LINKS: Hero -->
        <Border x:Name="HeroPanel"
                Grid.Column="0"
                CornerRadius="18"
                Padding="22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7A673AB7" Offset="0.0"/>
                    <GradientStop Color="#2A673AB7" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Direction="270"/>
            </Border.Effect>

            <Grid>
                <!-- Glow -->
                <Ellipse x:Name="PiggyGlow"
                         Width="170" Height="170"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="-14,0,0,0"
                         Opacity="0.22"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55673AB7" Offset="0.0"/>
                            <GradientStop Color="#00673AB7" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="22"/>
                    </Ellipse.Effect>
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Wasserzeichen -->
                <materialDesign:PackIcon Kind="PiggyBank"
                                         Opacity="0.08"
                                         Width="240" Height="240"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,-26,-18"/>

                <!-- Inhalt -->
                <StackPanel VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PiggyBank"
                                             Width="66" Height="66"
                                             Foreground="{StaticResource AppBrandBrush}"
                                             Margin="0,0,0,10"/>

                    <TextBlock Text="MyCoinFlow"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Deine smarte Übersicht"
                               Style="{StaticResource LoginHint}"
                               Margin="0,0,0,16"/>

                    <!-- kleine Benefits (nur Optik) -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                     Width="18" Height="18"
                                                     Foreground="{StaticResource AppBrandBrush}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Mandant wählen und anmelden"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                     Width="18" Height="18"
                                                     Foreground="{StaticResource AppBrandBrush}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Lokal, schnell, übersichtlich"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                     Width="18" Height="18"
                                                     Foreground="{StaticResource AppBrandBrush}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Lizenz und Benutzerführung integriert"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="made by brugilimSoft"
                           FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="4,0,0,4"/>
            </Grid>

            <Border.RenderTransform>
                <TranslateTransform X="-16"/>
            </Border.RenderTransform>
        </Border>

        <!-- RECHTS: Login Card -->
        <Border x:Name="LoginCard"
                Grid.Column="2"
                CornerRadius="18"
                Padding="22"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.20" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Anmeldung"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Wähle den Mandanten und melde dich an. Zusätzliche Bereiche erscheinen nur, wenn erforderlich."
                               Style="{StaticResource LoginHint}"/>
                </StackPanel>

                <!-- Form -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Left">

                        <!-- Mandant -->
                        <TextBlock Text="Datenbank (Mandant)" Style="{StaticResource LoginLabel}"/>
                        <ComboBox x:Name="DbCombo"
                                  Width="360"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,18"/>

                        <!-- Login Titel -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="ShieldLockOutline"
                                                     Style="{StaticResource DefaultIconStyle}"
                                                     Width="26" Height="26"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Login"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LoginSectionTitle}"
                                       Margin="0"/>
                        </StackPanel>

                        <!-- Login Felder -->
                        <TextBox x:Name="LoginUserBox"
                                 Width="360"
                                 HorizontalAlignment="Left"
                                 materialDesign:HintAssist.Hint="Benutzername"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12"/>

                        <PasswordBox x:Name="LoginPwdBox"
                                     Width="360"
                                     HorizontalAlignment="Left"
                                     materialDesign:HintAssist.Hint="Passwort"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Margin="0,0,0,14"/>

                        <Button x:Name="LoginButton"
                                IsDefault="True"
                                Width="360"
                                HorizontalAlignment="Left"
                                Style="{StaticResource IconTextButton}"
                                Tag="LoginVariant"
                                Content="Anmelden"
                                Margin="0,0,0,10"
                                Click="Login_Click"/>

                        <!-- Status -->
                        <TextBlock x:Name="StatusText"
                                   Width="360"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Aktivierung Panel -->
                        <Border x:Name="LicensePanel"
        Width="360"
        Background="{DynamicResource MaterialDesignCardBackground}"
        CornerRadius="12"
        Padding="14"
        Margin="0,0,0,16"
        Visibility="Collapsed">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="ShieldKeyOutline"
                                     Style="{StaticResource DefaultIconStyle}"
                                     Width="22" Height="22"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>
                                    <TextBlock Text="Aktivierung erforderlich"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Für den ersten Start wird eine gültige Lizenzdatei oder eine 30-Tage-Testversion benötigt."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   Margin="0,0,0,12"/>

                                <Button x:Name="ImportLicenseFileButton"
                Width="360"
                HorizontalAlignment="Left"
                Style="{StaticResource IconTextButton}"
                Tag="FileImport"
                Content="Lizenzdatei importieren"
                Margin="0,0,0,10"
                Click="ImportLicenseFileButton_Click"/>

                                <Button x:Name="StartTrialButton"
                Width="360"
                HorizontalAlignment="Left"
                Style="{StaticResource IconTextButton}"
                Tag="ClockStart"
                Content="30 Tage testen"
                Margin="0,0,0,10"
                Click="StartTrialButton_Click"/>

                                <Expander Header="Alter MCF1-Lizenzschlüssel"
                  Margin="0,4,0,10">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBox x:Name="LicenseKeyBox"
                         Width="360"
                         HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="Lizenzschlüssel (MCF1-...)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10"/>

                                        <Button x:Name="SaveLicenseButton"
                        Width="360"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IconTextButton}"
                        Tag="KeyPlus"
                        Content="MCF1-Key speichern"
                        Margin="0,0,0,10"
                        Click="SaveLicenseButton_Click"/>
                                    </StackPanel>
                                </Expander>

                                <TextBlock x:Name="LicenseStatusText"
                   Width="360"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Erstbenutzer (Code-behind steuert IsEnabled/IsExpanded) -->
                        <Expander Header="Ersten Benutzer anlegen"
                                  x:Name="FirstUserExpander"
                                  IsExpanded="False"
                                  Margin="0,0,0,0">
                            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Left">

                                <TextBox x:Name="NewUserBox"
                                         Width="360"
                                         HorizontalAlignment="Left"
                                         materialDesign:HintAssist.Hint="Benutzername (3–32, A-Z, a-z, 0-9, ., _, -)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,12"/>

                                <PasswordBox x:Name="NewPwd1Box"
                                             Width="360"
                                             HorizontalAlignment="Left"
                                             materialDesign:HintAssist.Hint="Passwort"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             Margin="0,0,0,12"/>

                                <PasswordBox x:Name="NewPwd2Box"
                                             Width="360"
                                             HorizontalAlignment="Left"
                                             materialDesign:HintAssist.Hint="Passwort wiederholen"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             Margin="0,0,0,14"/>

                                <Button Click="CreateFirstUser_Click"
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource IconTextButton}"
                                        Tag="AccountPlus"
                                        Content="Anlegen"/>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border.RenderTransform>
                <TranslateTransform X="16"/>
            </Border.RenderTransform>
        </Border>
    </Grid>

    <!-- Animationen -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeroPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.30"/>
                    <DoubleAnimation Storyboard.TargetName="HeroPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-16" To="0" Duration="0:0:0.30"/>

                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.05" Duration="0:0:0.30"/>
                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="16" To="0" BeginTime="0:0:0.05" Duration="0:0:0.30"/>

                    <DoubleAnimation Storyboard.TargetName="PiggyGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.10" To="0.30"
                                     Duration="0:0:1.7"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="PiggyGlow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="1.00" To="1.07"
                                     Duration="0:0:1.7"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="PiggyGlow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="1.00" To="1.07"
                                     Duration="0:0:1.7"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
