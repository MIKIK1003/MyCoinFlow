<base:BaseWindow x:Class="MyCoinFlow.Views.AddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Adresse" Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Formular -->
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name*" Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="Straße" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="StrasseBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="PLZ" Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="PLZBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="Ort" Grid.Row="3" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="OrtBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="Land" Grid.Row="4" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="LandBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="Typ" Grid.Row="5" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="TypBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="IBAN" Grid.Row="6" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="IbanBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="Notiz" Grid.Row="7" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBox x:Name="NotizBox" Grid.Row="7" Grid.Column="1" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox x:Name="IstBudgetiertCheck"
                      Grid.Row="0"
                      Content="Reine Standard-Einnahmen Adresse->Bank mit Standard-Einnahmenkonto"
                      Margin="0,0,0,8"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock Text="Standard-Einnahmenkonto (optional)" Margin="0,0,0,4"/>
                <ComboBox x:Name="StandardEinnahmenKontoBox"
                          DisplayMemberPath="Anzeige"
                          SelectedValuePath="Id"
                          IsEditable="False"
                          MinWidth="280"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconTextButton}"
                        Tag="Close"
                        Content="Abbrechen"
                        IsCancel="True"
                        Margin="0,0,10,0"/>
                <Button Style="{StaticResource IconTextButton}"
                        Tag="CheckBold"
                        Content="OK"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</base:BaseWindow>