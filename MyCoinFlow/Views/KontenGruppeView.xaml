<UserControl x:Class="MyCoinFlow.Views.KontenGruppeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Neu -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <TextBox Width="220"
                     Text="{Binding NeueBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Neue Bezeichnung"/>
            <Button Content="Hinzufügen"
                    Command="{Binding HinzufuegenCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Liste -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding KontenGruppen}"
                 SelectedItem="{Binding AusgewaehlteGruppe, Mode=TwoWay}"
                 DisplayMemberPath="Bezeichnung"/>

        <!-- Ändern -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
            <TextBox Width="220"
                     Text="{Binding BearbeiteteBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Bezeichnung ändern"/>
            <Button Content="Ändern"
                    Command="{Binding BearbeitenCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Löschen -->
        <Button Grid.Row="3" Content="Löschen"
                Command="{Binding LoeschenCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
