<Window x:Class="MyCoinFlow.Views.KontoAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Konto wählen"
        Height="180" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Formular -->
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Bitte Konto wählen:" Margin="0,0,0,6"/>
            <ComboBox x:Name="KontoBox"
                      DisplayMemberPath="Anzeige"
                      SelectedValuePath="Id"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      MinWidth="320"
                      Height="32"/>
        </StackPanel>

        <!-- Footer-Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    Margin="0,0,8,0"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="CheckBold"
                    Content="Übernehmen"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
