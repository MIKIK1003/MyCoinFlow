<base:BaseWindow x:Class="MyCoinFlow.Views.SchluesselNeuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Schlüssel anlegen"
        Width="520"
        Height="300"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Neuer Schlüssel"/>

        <TextBox Grid.Row="2"
                 x:Name="NameBox"
                 materialDesign:HintAssist.Hint="Name (z. B. Allgemein MEA)"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <ComboBox Grid.Row="4"
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding Modus}"
                  materialDesign:HintAssist.Hint="Modus">
            <ComboBoxItem Content="Fix % (manuell)" Tag="FIX"/>
            <ComboBoxItem Content="MEA (automatisch)" Tag="MEA"/>
            <ComboBoxItem Content="Energie (Zählerbasiert)" Tag="ENERGIE"/>
        </ComboBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Abbrechen"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>