<UserControl x:Class="MyCoinFlow.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== LINKS: SIDEBAR ================== -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Filter und Aktionen"
                               FontSize="18" Margin="0,0,0,12"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                    <!-- Suche -->
                    <TextBlock Text="Suche" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <TextBox x:Name="SearchBox"
                             MinHeight="40"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Kontoname, Gruppe, Detail…"
                             TextChanged="Filter_TextChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{x:Static ApplicationCommands.NotACommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Datum -->
                    <TextBlock Text="Datum" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="von" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                            <DatePicker x:Name="DateFromPicker" MinHeight="36"
                                        SelectedDateChanged="Filter_DateChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="bis" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                            <DatePicker x:Name="DateToPicker" MinHeight="36"
                                        SelectedDateChanged="Filter_DateChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Konto -->
                    <TextBlock Text="Konto" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <ComboBox x:Name="KontoCombo"
                              MinHeight="36"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding KontenListeFlach}"
                              SelectionChanged="Filter_SelectionChanged"
                              materialDesign:HintAssist.Hint="Konto wählen…">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Kontonummer, StringFormat={}{0:D4}}"/>
                                    <TextBlock Text="  —  " />
                                    <TextBlock Text="{Binding Detail}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Suche-Aktionen -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Magnify"
                                Content="Suchen"
                                MinHeight="40"
                                Margin="0,0,8,0"
                                Width="109"
                                IsDefault="True"
                                Click="ApplySearch_Click"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="CloseCircle"
                                Content="Leeren"
                                MinHeight="40"
                                Width="109"
                                Click="ClearSearch_Click"/>
                    </StackPanel>

                    <!-- Ansicht -->
                    <TextBlock Text="Ansicht" Margin="0,20,0,8"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <CheckBox Content="Tabellenansicht"
                              IsChecked="{Binding IstTabellenAnsicht, Mode=TwoWay}"/>

                    <!-- Aktionen -->
                    <TextBlock Text="Kontenplan" Margin="0,20,0,8"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <StackPanel>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="invoicetextplus" Content="Neu"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding NeuerEintragCommand}"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="invoicetextedit" Content="Bearbeiten"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding BearbeitenEintragCommand}"/>
                        <Button Style="{StaticResource IconTextButton.Danger}"
                                Tag="invoicetextremove" Content="Löschen"
                                MinHeight="40"
                                Command="{Binding LoeschenEintragCommand}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================== RECHTS: INHALT ================== -->
        <Grid Grid.Column="1">
            <!-- Baum -->
            <TreeView x:Name="AccountsTree"
                      Grid.Row="0"
                      ItemsSource="{Binding KontoplanKnotenListe}"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      Visibility="{Binding IstBaumAnsicht, Converter={StaticResource BoolToVis}}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Kinder}">
                        <TextBlock Text="{Binding AnzeigeText}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Tabelle -->
            <DataGrid x:Name="AccountsGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding KontenListeFlach}"
                      Visibility="{Binding IstTabellenAnsicht, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionUnit="FullRow"
                      SelectionChanged="AccountsGrid_SelectionChanged"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      RowHeight="40">

                <DataGrid.Resources>
                    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="Padding" Value="0,0,8,0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- Icon: Transaktionen zeigen -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="42" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Transaktionen dieses Kontos anzeigen"
                                        Click="OpenKontoTransaktionen_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Kind="FileDocumentMultipleOutline"
                                        Style="{StaticResource DefaultIconStyle}"
                                        Width="24" Height="24"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Spalten -->
                    <DataGridTextColumn Header="Nr."         Binding="{Binding Kontonummer}" Width="80"/>
                    <DataGridTextColumn Header="Art"         Binding="{Binding Art}" Width="120"/>
                    <DataGridTextColumn Header="Gruppe"      Binding="{Binding Gruppe}" Width="160"/>
                    <DataGridTextColumn Header="Untergruppe" Binding="{Binding Untergruppe}" Width="160"/>
                    <DataGridTextColumn Header="Detail"      Binding="{Binding Detail}" Width="*"/>
                    <DataGridTextColumn Header="Budget"  Binding="{Binding Budgetwert, StringFormat={}{0:C}}" Width="110"
                                        ElementStyle="{StaticResource RightAlignedCell}"/>
                    <DataGridTextColumn Header="Gebucht" Binding="{Binding Gebucht,    StringFormat={}{0:C}}" Width="110"
                                        ElementStyle="{StaticResource RightAlignedCell}"/>
                    <DataGridTextColumn Header="Δ"       Binding="{Binding Differenz,  StringFormat={}{0:C}}" Width="110"
                                        ElementStyle="{StaticResource RightAlignedCell}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
