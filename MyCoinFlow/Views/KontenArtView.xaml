<UserControl x:Class="MyCoinFlow.Views.KontenArtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Neu -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Ändern -->
            <RowDefinition Height="Auto"/>
            <!-- Löschen -->
        </Grid.RowDefinitions>

        <!-- Neu -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="260"
                     Text="{Binding NeueBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Neue Bezeichnung"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="PlusCircleOutline"
                    Content="Hinzufügen"
                    Command="{Binding HinzufuegenCommand}"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Liste -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding KontenArten}"
                 SelectedItem="{Binding AusgewaehlteArt, Mode=TwoWay}"
                 DisplayMemberPath="Bezeichnung"/>

        <!-- Ändern -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox Width="260"
                     Text="{Binding BearbeiteteBezeichnung, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Bezeichnung ändern"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Pencil"
                    Content="Ändern"
                    Command="{Binding BearbeitenCommand}"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Löschen -->
        <Button Grid.Row="3"
                Style="{StaticResource IconTextButton.Danger}"
                Tag="DeleteForever"
                Content="Löschen"
                Command="{Binding LoeschenCommand}"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
