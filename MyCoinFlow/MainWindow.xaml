<base:BaseWindow x:Class="MyCoinFlow.MainWindow"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:MyCoinFlow.Services"
        mc:Ignorable="d"
        Title="MyCoinFlow"
        Height="900"
        Width="1800"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        x:Name="RootWindow">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="NavTileButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTileIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>

        <Style x:Key="NavGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
            <Setter Property="Margin" Value="4,18,0,6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}"
                Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="MyCoinFlow"
                                   Style="{StaticResource SidebarSectionHeader}"/>

                        <TextBlock Text="Finanzen"
                                   Style="{StaticResource NavGroupHeader}"/>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowDashboardCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="ViewDashboard"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowTransactionsCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="SwapHorizontal"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Transaktionen" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowAccountsCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="FileTreeOutline"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Kontenplan" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowInstitutionsCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="BankOutline"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Geldinstitute" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowAddressesCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="AccountBoxOutline"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Adressen" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowBudgetsCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="HandCoin"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Budget" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="Immobilien"
                                   Style="{StaticResource NavGroupHeader}"/>

                        <Button x:Name="NavStweSetsButton"
                                Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowTransaktionSetsCommand}"
                                Click="LicensedNavButton_Click"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="PlaylistPlus"
                             Style="{StaticResource NavTileIcon}"/>

                                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                                    <TextBlock Text="STWE"
                   VerticalAlignment="Center"/>

                                    <materialDesign:PackIcon x:Name="NavStweLockIcon"
                                 Kind="LockOutline"
                                 Width="20"
                                 Height="20"
                                 Margin="10,2,0,0"
                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavLiegenschaftenButton"
                                Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowLiegenschaftenCommand}"
                                Click="LicensedNavButton_Click"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="HomeCityOutline"
                             Style="{StaticResource NavTileIcon}"/>

                                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                                    <TextBlock Text="Liegenschaften"
                   VerticalAlignment="Center"/>

                                    <materialDesign:PackIcon x:Name="NavLiegenschaftenLockIcon"
                                 Kind="LockOutline"
                                 Width="20"
                                 Height="20"
                                 Margin="10,2,0,0"
                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="Module"
                                   Style="{StaticResource NavGroupHeader}"/>

                        <Button x:Name="NavWealthButton"
                                Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowVermoegenCommand}"
                                Click="LicensedNavButton_Click"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="ChartLine"
                             Style="{StaticResource NavTileIcon}"/>

                                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                                    <TextBlock Text="Wealth"
                   VerticalAlignment="Center"/>

                                    <materialDesign:PackIcon x:Name="NavWealthLockIcon"
                                 Kind="LockOutline"
                                 Width="20"
                                 Height="20"
                                 Margin="10,2,0,0"
                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavHomeButton"
        Style="{StaticResource NavTileButton}"
        Command="{Binding ShowHaushaltCommand}"
        Click="LicensedNavButton_Click"
        Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="HomeOutline"
                                 Style="{StaticResource NavTileIcon}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Haushalt" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon x:Name="NavHomeLockIcon"
                                     Kind="LockOutline"
                                     Width="20"
                                     Height="20"
                                     Margin="10,2,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavDmsButton"
        Style="{StaticResource NavTileButton}"
        Command="{Binding ShowDmsCommand}"
        Click="LicensedNavButton_Click"
        Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline"
                                 Style="{StaticResource NavTileIcon}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DMS" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon x:Name="NavDmsLockIcon"
                                     Kind="LockOutline"
                                     Width="20"
                                     Height="20"
                                     Margin="10,2,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                                    <materialDesign:PackIcon Kind="Sync"
                                     Width="18" Height="18"
                                     Margin="10,2,0,0"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5"
                                     ToolTip="DMS-Arbeitsordner: Verarbeitung läuft"
                                     DataContext="{x:Static services:DmsWatcherService.Instance}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <RotateTransform/>
                                        </materialDesign:PackIcon.RenderTransform>
                                        <materialDesign:PackIcon.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(materialDesign:PackIcon.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </materialDesign:PackIcon.Triggers>
                                    </materialDesign:PackIcon>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavAbosButton"
        Style="{StaticResource NavTileButton}"
        Command="{Binding ShowAbosCommand}"
        Click="LicensedNavButton_Click"
        Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="Autorenew"
                                 Style="{StaticResource NavTileIcon}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Abos" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon x:Name="NavAbosLockIcon"
                                     Kind="LockOutline"
                                     Width="20"
                                     Height="20"
                                     Margin="10,2,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="System"
                                   Style="{StaticResource NavGroupHeader}"/>

                        <Button Style="{StaticResource NavTileButton}"
                                Command="{Binding ShowAdminCommand}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="Cog"
                                                         Style="{StaticResource NavTileIcon}"/>
                                <TextBlock Text="Einstellungen" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ExitButton"
                            Style="{StaticResource IconTextButton.Danger}"
                            Tag="Power"
                            Content="Beenden"
                            ToolTip="MyCoinFlow beenden"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                               Text="{Binding ElementName=RootWindow, Path=VersionText,
                                              FallbackValue=v0.0.0, TargetNullValue=v0.0.0}"/>
                </Grid>

            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.073"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.999"/>
                </TransformGroup>
            </ContentControl.RenderTransform>
        </ContentControl>

    </Grid>
</base:BaseWindow>