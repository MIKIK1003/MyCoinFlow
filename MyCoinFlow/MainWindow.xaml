<Window x:Class="MyCoinFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:MyCoinFlow.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MyCoinFlow"
        Height="900"
        Width="1800"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        x:Name="RootWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LINKS: Hauptmenü (optisch vereinheitlicht) -->
        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}"
                Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menü -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="MyCoinFlow"
                                   Style="{StaticResource SidebarSectionHeader}"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="ViewDashboard"
                                Content="Dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="SwapHorizontal"
                                Content="Transaktionen"
                                Command="{Binding ShowTransactionsCommand}"
                                Margin="0,0,0,8"/>

                        <!-- ✅ PLUS -->
                        <Button x:Name="NavStweSetsButton"
                                Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="PlaylistPlus"
                                Content="STWE-Sets"
                                Command="{Binding ShowTransaktionSetsCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="FileTreeOutline"
                                Content="Kontenplan"
                                Command="{Binding ShowAccountsCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="BankOutline"
                                Content="Geldinstitute"
                                Command="{Binding ShowInstitutionsCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="AccountBoxOutline"
                                Content="Adressen"
                                Command="{Binding ShowAddressesCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="HandCoin"
                                Content="Budget"
                                Command="{Binding ShowBudgetsCommand}"
                                Margin="0,0,0,8"/>

                        <!-- ✅ PLUS -->
                        <Button x:Name="NavLiegenschaftenButton"
                                Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="HomeCityOutline"
                                Content="Liegenschaften"
                                Command="{Binding ShowLiegenschaftenCommand}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource NavIconButton_Emphasis}"
                                Tag="Cog"
                                Content="Einstellungen"
                                Command="{Binding ShowAdminCommand}"
                                Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ExitButton"
                            Style="{StaticResource IconTextButton.Danger}"
                            Tag="Power"
                            Content="Beenden"
                            ToolTip="MyCoinFlow beenden"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                               Text="{Binding ElementName=RootWindow, Path=VersionText,
                                              FallbackValue=v0.0.0, TargetNullValue=v0.0.0}"/>
                </Grid>

            </Grid>
        </Border>

        <!-- RECHTS: Inhalt (unverändert) -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.073"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.999"/>
                </TransformGroup>
            </ContentControl.RenderTransform>
        </ContentControl>

    </Grid>
</Window>
