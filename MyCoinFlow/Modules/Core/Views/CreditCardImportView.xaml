<UserControl x:Class="MyCoinFlow.Views.CreditCardImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="700">

    <!-- Ressourcen -->
    <UserControl.Resources>
        <!-- Rechts ausgerichteter Text -->
        <Style x:Key="RightAlignText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Summen -->
            <RowDefinition Height="*"/>
            <!-- Grid -->
        </Grid.RowDefinitions>

        <!-- ======= Toolbar (vereinheitlicht) ======= -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LINKS: Aktionen + Batch-Auswahl -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">

                <Button Style="{StaticResource IconTextButton}"
                        Tag="FileImport"
                        Content="Excel wählen…"
                        Margin="0,0,10,0"
                        Command="{Binding DateiWaehlenCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="PlayCircle"
                        Content="Buchen"
                        Margin="0,0,10,0"
                        Command="{Binding BuchenCommand}"/>

                <!-- Batch verwerfen -->
                <Button Style="{StaticResource IconTextButton.Danger}"
                        Tag="DeleteForever"
                        Content="Batch verwerfen"
                        Margin="10,0,0,0"
                        ToolTip="Import-Batch verwerfen"
                        Command="{Binding BatchVerwerfenCommand}"/>

                <!-- Batch-Auswahl + Laden + Aktualisieren -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Batch:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox Width="380"
                              ItemsSource="{Binding Batches}"
                              DisplayMemberPath="Anzeige"
                              SelectedItem="{Binding AusgewaehlterBatch}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Download"
                            Content="Laden"
                            Margin="6,0,0,0"
                            Command="{Binding BatchLadenCommand}"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Refresh"
                            Content="Aktualisieren"
                            Margin="6,0,0,0"
                            ToolTip="Batchliste aktualisieren"
                            Command="{Binding BatchesNeuLadenCommand}"/>
                </StackPanel>

                <!-- Filter -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox Width="140"
                              SelectedValue="{Binding FilterModus}"
                              SelectedValuePath="Content"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="Alle"/>
                        <ComboBoxItem Content="Offen"/>
                        <ComboBoxItem Content="Zugewiesen"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- RECHTS: Verrechnungskonto + Geldinstitut -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Verrechnungskonto:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox Width="320" Margin="0,0,20,0"
                          ItemsSource="{Binding KreditkartenKonten}"
                          DisplayMemberPath="Anzeige"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding AusgleichsKontoId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                <TextBlock Text="Geldinstitut:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox Width="240"
                          ItemsSource="{Binding Geldinstitute}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding AusgewaehltesGeldinstitutId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
            </StackPanel>
        </Grid>

        <!-- ======= Summenleiste ======= -->
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" CornerRadius="6"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="Summe Liste:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SummeListe, StringFormat={}{0:N2}}" Style="{StaticResource RightAlignText}" Width="120"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock Text="Zugeordnet:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SummeZugeordnet, StringFormat={}{0:N2}}" Style="{StaticResource RightAlignText}" Width="120"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Left">
                    <TextBlock Text="Offen:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SummeOffen, StringFormat={}{0:N2}}" Style="{StaticResource RightAlignText}" Width="120"/>
                </StackPanel>

                <!-- Abrechnungssumme -->
                <StackPanel Orientation="Horizontal" Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Abrechnungssumme:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Width="120"
                             Text="{Binding Abrechnungssumme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <!-- Differenz -->
                <StackPanel Orientation="Horizontal" Grid.Column="4" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Differenz:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DifferenzZurAbrechnung, StringFormat={}{0:N2}}"
                               Style="{StaticResource RightAlignText}" Width="120"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======= Liste ======= -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ZeilenView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="40"
                  materialDesign:DataGridAssist.CellPadding="6"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12"
                  FrozenColumnCount="3"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- pro Zeile löschen (immer sichtbar, fixe Breite) -->
                <DataGridTemplateColumn Header="" Width="52" MinWidth="52" MaxWidth="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Zeile löschen"
                                    Command="{Binding DataContext.ZeileLoeschenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding .}">
                                <materialDesign:PackIcon Kind="TrashCanOutline"
                                                         Width="20" Height="20"/>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Datum / Betrag / Debit-Kredit -->
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Betrag" Binding="{Binding Betrag, StringFormat={}{0:N2}}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Debit/Kredit" Binding="{Binding DebitKredit}" Width="110"/>

                <!-- Zuordnen-Icon (sichtbar wenn KontoId == null), fixe Breite -->
                <DataGridTemplateColumn Header="" Width="52" MinWidth="52" MaxWidth="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Zuordnen"
                                    Command="{Binding DataContext.ZuweisenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding .}">
                                <materialDesign:PackIcon Kind="FolderCog"
                                                         Style="{StaticResource DefaultIconStyle}"
                                                         Width="20" Height="20"/>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KontoId}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Ändern-Icon (sichtbar wenn KontoId != null), fixe Breite -->
                <DataGridTemplateColumn Header="" Width="52" MinWidth="52" MaxWidth="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Zuordnung ändern"
                                    Command="{Binding DataContext.ZuweisenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding .}">
                                <materialDesign:PackIcon Kind="PencilBox"
                                                         Style="{StaticResource DefaultIconStyle}"
                                                         Width="20" Height="20"/>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KontoId}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Beschreibung / Händler / Kategorie -->
                <DataGridTextColumn Header="Beschreibung"    Binding="{Binding Beschreibung}" Width="3*"/>
                <DataGridTextColumn Header="Händler"         Binding="{Binding Haendler}"      Width="2*"/>
                <DataGridTextColumn Header="Händlerkategorie" Binding="{Binding Kategorie}"   Width="2*"/>

                <!-- Konto-Text -->
                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
