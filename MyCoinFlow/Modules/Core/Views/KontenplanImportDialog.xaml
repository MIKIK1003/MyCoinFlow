<Window x:Class="MyCoinFlow.Views.KontenplanImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kontenplan aus Excel importieren"
        Width="1700" MinWidth="900"
        Height="780" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Background="{DynamicResource MaterialDesignPaper}">

    <!-- Seitliches Layout wie bei den anderen Dialogen -->
    <DockPanel Margin="16">

        <!-- Sidebar links: Datei & Optionen -->
        <Border DockPanel.Dock="Left"
                Width="320"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" Orientation="Vertical">

                    <TextBlock Text="Datei &amp; Optionen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- Pfad -->
                    <TextBlock Text="Quelldatei" Margin="0,0,0,6"/>
                    <TextBox x:Name="PfadBox"
                             IsReadOnly="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,8"/>

                    <!-- Aktionen -->
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="FileSearchOutline"
                            Content="Datei wählen…"
                            Click="DateiWaehlen_Click"/>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Refresh"
                            Content="Vorschau aktualisieren"
                            Margin="0,8,0,0"
                            Click="Vorschau_Click"/>

                    <Separator Margin="0,12,0,12"/>

                    <!-- Import-Optionen -->
                    <CheckBox x:Name="OnlyNewBox"
                              Content="Nur neue anlegen"
                              Margin="0,0,0,8"/>

                    <CheckBox x:Name="BudgetChk"
                              Content="BudgetJ importieren"
                              Margin="0,0,0,8"
                              Checked="BudgetChk_Toggled"
                              Unchecked="BudgetChk_Toggled"/>

                    <TextBlock Text="Zeitraum" Margin="0,6,0,4"/>
                    <ComboBox x:Name="ZeitraumBox"
                              IsEnabled="False"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              DisplayMemberPath="Bezeichnung"
                              SelectedValuePath="Id"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Hauptbereich rechts -->
        <DockPanel>

            <!-- Fußzeile unten -->
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0">
                <TextBlock x:Name="SummaryText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Close"
                            Content="Abbrechen"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="Abbrechen_Click"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="FileImport"
                            Content="Import starten"
                            Width="160"
                            IsDefault="True"
                            Click="Import_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Preview-Tabelle -->
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Warning}"/>
                        <Setter Property="Background" Value="{x:Null}"/>
                        <Style.Triggers>
                            <!-- leicht rot bei Fehler -->
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#FFFDECEA"/>
                            </DataTrigger>
                            <!-- leicht gelb bei Dubletten in Datei -->
                            <DataTrigger Binding="{Binding DuplicateKontoInFile}" Value="True">
                                <Setter Property="Background" Value="#FFFFF7E6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNo}" Width="50"/>
                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="90"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/>

                    <DataGridTextColumn Header="ArtN" Binding="{Binding ArtN}" Width="80"/>
                    <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="220"/>
                    <DataGridTextColumn Header="Art (Bezeichnung)" Binding="{Binding ArtBezeichnung}" Width="220"/>

                    <DataGridTextColumn Header="Gruppe" Binding="{Binding Gruppe}" Width="180"/>
                    <DataGridTextColumn Header="Untergruppe" Binding="{Binding Untergruppe}" Width="180"/>

                    <DataGridTextColumn Header="BudgetJ" Binding="{Binding BudgetInfo}" Width="110"/>

                    <DataGridTextColumn Header="Art↴" Binding="{Binding ActionArt}" Width="70"/>
                    <DataGridTextColumn Header="Gruppe↴" Binding="{Binding ActionGruppe}" Width="80"/>
                    <DataGridTextColumn Header="Untergruppe↴" Binding="{Binding ActionUntergruppe}" Width="110"/>
                    <DataGridTextColumn Header="Konto↴" Binding="{Binding ActionKonto}" Width="80"/>

                    <DataGridTextColumn Header="Hinweis" Binding="{Binding Warning}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </DockPanel>
</Window>
