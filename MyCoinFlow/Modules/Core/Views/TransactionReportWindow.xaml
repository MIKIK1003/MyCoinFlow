<base:BaseWindow x:Class="MyCoinFlow.Views.TransactionReportWindow"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Transaktionsbericht"
        Width="1800"
        Height="940"
        MinWidth="1250"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Bericht steuern" Style="{StaticResource SidebarSectionHeader}"/>

                    <TextBlock Text="Berichtsname" Style="{StaticResource SidebarGroupHeader}"/>
                    <TextBox Text="{Binding Berichtstitel, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             MinHeight="40"/>

                    <TextBlock Text="Budgetzeitraum" Style="{StaticResource SidebarGroupHeader}"/>
                    <ComboBox ItemsSource="{Binding Budgetzeitraeume}"
                              SelectedItem="{Binding AusgewaehlterBudgetzeitraum}"
                              DisplayMemberPath="Bezeichnung"
                              MinHeight="40"/>

                    <TextBlock Text="Auswertungszeitraum" Style="{StaticResource SidebarGroupHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="von" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding AuswertungVon}" MinHeight="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="bis" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding AuswertungBis}" MinHeight="36"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Berichtsart" Style="{StaticResource SidebarGroupHeader}"/>
                    <ComboBox ItemsSource="{Binding Berichtsarten}"
                              SelectedItem="{Binding AusgewaehlteBerichtsart}"
                              DisplayMemberPath="Display"
                              MinHeight="40"/>

                    <TextBlock Text="Gruppierung" Style="{StaticResource SidebarGroupHeader}"/>
                    <ComboBox ItemsSource="{Binding Gruppierungen}"
                              SelectedItem="{Binding AusgewaehlteGruppierung}"
                              DisplayMemberPath="Display"
                              MinHeight="40"/>

                    <TextBlock Text="Nummernkreise" Style="{StaticResource SidebarGroupHeader}"/>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" Padding="8" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Nummernkreise}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Anzeige}"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="CheckboxMultipleMarkedOutline"
                            Content="Nummernkreise anwenden"
                            Command="{Binding NummernkreiseAnwendenCommand}"
                            Margin="0,8,0,0"/>

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock Text="Konten" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding AusgewaehlteKontenAnzahl, StringFormat={}{0} gewählt}"/>
                    </DockPanel>

                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button Content="Alle" Command="{Binding AlleKontenCommand}" Margin="0,0,4,0"/>
                        <Button Content="Keine" Command="{Binding KeineKontenCommand}" Margin="2,0"/>
                        <Button Content="Budget" Command="{Binding NurBudgetkontenCommand}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <DataGrid ItemsSource="{Binding Konten}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Height="260"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="34"/>
                            <DataGridTextColumn Header="Nr." Binding="{Binding Kontonummer}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Detail}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Art" Binding="{Binding RichtungText}" Width="75" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Style="{StaticResource IconTextButton}"
                            Tag="ChartBoxOutline"
                            Content="Auswerten"
                            Command="{Binding AuswertenCommand}"
                            IsDefault="True"
                            MinHeight="46"
                            Margin="0,14,0,0"/>

                    <Separator Margin="0,28,0,10"/>
                    <TextBlock Text="Berichtsaktionen" Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,8"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Finance"
                            Content="Budget an Hochrechnung anpassen…"
                            IsEnabled="{Binding KannBudgetAnpassen}"
                            Click="AdjustBudget_Click"
                            Margin="0,0,0,8"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Printer"
                            Content="Drucken / PDF"
                            IsEnabled="{Binding HatErgebnis}"
                            Click="Print_Click"
                            Margin="0,0,0,8"/>
                    <Button Style="{StaticResource IconTextButton}"
                            Tag="Close"
                            Content="Schliessen"
                            Click="Close_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Berichtsvorschau" FontSize="24"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,12"/>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource SidebarCard}" Margin="0,0,6,0">
                    <TextBlock Text="{Binding AusgabenZusammenfassung}" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource SidebarCard}" Margin="3,0">
                    <TextBlock Text="{Binding EinnahmenZusammenfassung}" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource SidebarCard}" Margin="6,0,0,0">
                    <TextBlock Text="{Binding NettoZusammenfassung}" TextWrapping="Wrap"/>
                </Border>
            </UniformGrid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Ergebniszeilen}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      FrozenColumnCount="3">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Konto}" Width="70">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.KontoSpaltenTitel,
                                                      RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="Richtung" Binding="{Binding Richtung}" Width="85"/>
                    <DataGridTextColumn Header="Budget Jahr" Binding="{Binding BudgetJahr, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Soll Zeitraum" Binding="{Binding SollZeitraum, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Ist Zeitraum" Binding="{Binding IstZeitraum, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Hochrechnung" Binding="{Binding HochrechnungJahr, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Δ Zeitraum" Binding="{Binding DeltaZeitraum, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Δ Jahr" Binding="{Binding DeltaJahr, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Erfüllung %" Binding="{Binding ErfuellungProzent, StringFormat={}{0:N1}}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="Spotlight" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpotlightBasis}" Foreground="Gray"/>
                </DockPanel>
                <TabControl MaxHeight="205">
                    <TabItem Header="Top 5 Ausgaben">
                        <DataGrid ItemsSource="{Binding GroessteAusgaben}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Rang}" Width="38"/>
                                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="80"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*"/>
                                <DataGridTextColumn Header="Ist / Budget" Binding="{Binding Betrag, StringFormat={}{0:N2}}" Width="125"/>
                                <DataGridTemplateColumn Header="Ist-Anteil" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding AnteilProzent}"
                                                             Height="18" Opacity="0.45"/>
                                                <TextBlock Text="{Binding AnteilProzent, StringFormat={}{0:N1} %}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Hochrechnung Jahr" Binding="{Binding HochrechnungJahr, StringFormat={}{0:N0}}" Width="140"/>
                                <DataGridTemplateColumn Header="Jahresanteil" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding HochrechnungAnteilProzent}"
                                                             Height="18" Opacity="0.45"/>
                                                <TextBlock Text="{Binding HochrechnungAnteilProzent, StringFormat={}{0:N1} %}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Top 5 Einnahmen">
                        <DataGrid ItemsSource="{Binding GroessteEinnahmen}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Rang}" Width="38"/>
                                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="80"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*"/>
                                <DataGridTextColumn Header="Ist / Budget" Binding="{Binding Betrag, StringFormat={}{0:N2}}" Width="125"/>
                                <DataGridTemplateColumn Header="Ist-Anteil" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding AnteilProzent}"
                                                             Height="18" Opacity="0.45"/>
                                                <TextBlock Text="{Binding AnteilProzent, StringFormat={}{0:N1} %}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Hochrechnung Jahr" Binding="{Binding HochrechnungJahr, StringFormat={}{0:N0}}" Width="140"/>
                                <DataGridTemplateColumn Header="Jahresanteil" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding HochrechnungAnteilProzent}"
                                                             Height="18" Opacity="0.45"/>
                                                <TextBlock Text="{Binding HochrechnungAnteilProzent, StringFormat={}{0:N1} %}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Kritische Abweichungen">
                        <DataGrid ItemsSource="{Binding GroessteAbweichungen}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="80"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*"/>
                                <DataGridTextColumn Header="Richtung" Binding="{Binding Richtung}" Width="100"/>
                                <DataGridTextColumn Header="Δ Jahr" Binding="{Binding DeltaJahr, StringFormat={}{0:N2}}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <TextBlock Text="{Binding SpotlightZusammenfassung}" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="4" Background="{DynamicResource MaterialDesignPaper}"
                    Padding="10" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</base:BaseWindow>
