<UserControl x:Class="MyCoinFlow.Views.InstitutionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="1100">

    <Grid Margin="20">
        <!-- Sidebar links + Tabelle rechts -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== SIDEBAR LINKS ================== -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Filter und Aktionen"
                               FontSize="18" Margin="0,0,0,12"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                    <!-- Buttons (wie bisher) -->
                    <StackPanel Orientation="Vertical">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="BankPlus"
                                Content="Neues Geldinstitut"
                                Margin="0,0,0,8"
                                Command="{Binding NeuCommand}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="bank"
                                Content="Bearbeiten"
                                Margin="0,0,0,8"
                                Command="{Binding BearbeitenCommand}"/>

                        <Button Style="{StaticResource IconTextButton.Danger}"
                                Tag="bankremove"
                                Content="Löschen"
                                Command="{Binding LoeschenCommand}"/>
                    </StackPanel>

                    <!-- Abgrenzungsdatum -->
                    <TextBlock Text="Abgrenzungsdatum" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <DatePicker SelectedDate="{Binding Abgrenzungsdatum}" Width="160" MinHeight="36"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================== TABELLE RECHTS (UNVERÄNDERT) ================== -->
        <DataGrid Grid.Column="1"
                  x:Name="InstituteGrid"
                  ItemsSource="{Binding Institute}"
                  SelectedItem="{Binding AusgewaehltesInstitut}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="White"
                  RowBackground="White"
                  MouseDoubleClick="InstituteGrid_MouseDoubleClick"
                  FrozenColumnCount="1"
                  materialDesign:DataGridAssist.CellPadding="8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                  RowHeaderWidth="0">
            

            <DataGrid.Resources>
                <!-- Rechtsbündige Zahlen -->
                <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="Padding" Value="0,0,8,0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>

                <!-- Transaktionen anzeigen (links, nur Icon, fix & frozen) -->
                <DataGridTemplateColumn Header="" Width="52" MinWidth="52" MaxWidth="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Transaktionen dieses Geldinstituts anzeigen"
                                    Click="OpenTransaktionen_Click"
                                    HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline"
                                                         Style="{StaticResource DefaultIconStyle}"
                                                         Width="24" Height="24"/>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"        Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="BIC"         Binding="{Binding BIC}" Width="*"/>
                <DataGridTextColumn Header="IBAN"        Binding="{Binding IBAN}" Width="*"/>
                <DataGridTextColumn Header="Kontonummer" Binding="{Binding KontoNummer}" Width="*"/>
                <DataGridTextColumn Header="Notiz"       Binding="{Binding Notiz}" Width="2*"/>

                <!-- Anfangswerte -->
                <DataGridTextColumn Header="Anfangsbestand"
                                    Binding="{Binding Anfangsbestand, StringFormat=F2}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    Width="*"/>
                <DataGridTextColumn Header="ab Datum"
                                    Binding="{Binding Anfangsdatum, StringFormat=d}"
                                    Width="*"/>

                <!-- Berechnet -->
                <DataGridTextColumn Header="Gebucht (bis Abgrenzung)"
                                    Binding="{Binding Gebucht, StringFormat=F2}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    Width="*"/>
                <DataGridTextColumn Header="Schlussaldo"
                                    Binding="{Binding Schlussaldo, StringFormat=F2}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
