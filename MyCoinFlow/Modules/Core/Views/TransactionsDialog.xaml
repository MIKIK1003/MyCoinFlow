<base:BaseWindow x:Class="MyCoinFlow.Views.TransactionsDialog"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Neue Buchung"
        Height="880" Width="770"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <!-- Grundtheme -->
    <Window.Resources>
        <!-- Headline-Stil -->
        <Style x:Key="HeadlineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label-Stil -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyMediumBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Karten-Style für Radiobuttons -->
        <Style x:Key="TypeRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="Icon"
                                                         Width="26" Height="26"
                                                         Kind="{TemplateBinding Tag}"/>

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="56"/>
        </Style>

        <!-- Einheitlicher ComboBox-Stil -->
        <Style x:Key="BigCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="MinHeight" Value="40"/>
        </Style>

        <!-- Einheitlicher TextBox-Stil -->
        <Style x:Key="BigTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="ContentSave"
                    Content="Speichern"
                    IsDefault="True"
                    Click="Buchen_Click"/>
        </StackPanel>

        <!-- Inhalt -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" >

                <!-- Header -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock Text="Buchung erfassen"
                               Style="{StaticResource HeadlineText}"/>
                    <TextBlock Text="Wähle zuerst den Buchungstyp. Felder werden automatisch aktiviert/deaktiviert."
                               Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"/>
                </StackPanel>

                <!-- Typ-Auswahl -->
                <Border CornerRadius="12" Padding="12" Margin="0,0,0,12"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Zeile 1: Radio-Buttons -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <RadioButton x:Name="TypeBankToKonto"
                                         GroupName="TxnType"
                                         Style="{StaticResource TypeRadioStyle}"
                                         Tag="{x:Static materialDesign:PackIconKind.BankTransferOut}"
                                         Content="Bank → Konto"
                                         Checked="TxnType_Checked"/>
                            <RadioButton x:Name="TypeKontoToKonto"
                                         GroupName="TxnType"
                                         Style="{StaticResource TypeRadioStyle}"
                                         Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}"
                                         Content="Konto → Konto"
                                         Checked="TxnType_Checked"/>
                            <RadioButton x:Name="TypeKontoToBank"
                                         GroupName="TxnType"
                                         Style="{StaticResource TypeRadioStyle}"
                                         Tag="{x:Static materialDesign:PackIconKind.BankTransferIn}"
                                         Content="Konto → Bank"
                                         Checked="TxnType_Checked"/>
                            <RadioButton x:Name="TypeAdresseToBank"
                                         GroupName="TxnType"
                                         Style="{StaticResource TypeRadioStyle}"
                                         Tag="{x:Static materialDesign:PackIconKind.AccountCash}"
                                         Content="Adresse → Bank"
                                         Checked="TxnType_Checked"/>
                        </StackPanel>

                        <!-- Zeile 2: Haken – aktiv nutzbar -->
                        <CheckBox x:Name="BudgetEinnahmeBox"
                                  Grid.Row="1"
                                  Content="Budgetierte Einnahme"
                                  Margin="4,10,0,0"
                                  HorizontalAlignment="Left"
                                  Checked="BudgetCheck_Changed"
                                  Unchecked="BudgetCheck_Changed"/>
                    </Grid>
                </Border>

                <!-- Hinweis aktiver Budgetzeitraum (optional sichtbar) -->
                <Border x:Name="TxnBudgetHint"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Alert"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxnBudgetHintText"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Formularkarte -->
                <Border CornerRadius="12" Padding="16"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">

                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Datum -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Datum" Style="{StaticResource FieldLabel}"/>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <DatePicker x:Name="DatumBox"
                Margin="0,0,0,6"
                materialDesign:HintAssist.Hint="Bankdatum (Buchungsdatum)"
                SelectedDate="{x:Null}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- NEU: Zeilenlabel links -->
                                <TextBlock Grid.Column="0"
               Text="Budgetdatum"
               Style="{StaticResource FieldLabel}"
               Margin="0,6,0,0"/>

                                <DockPanel Grid.Column="1" LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                ToolTip="Budgetdatum löschen"
                Style="{StaticResource MaterialDesignToolButton}"
                Padding="4"
                Click="BudgetDatumClear_Click">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18"/>
                                    </Button>

                                    <DatePicker x:Name="BudgetDatumBox"
                    materialDesign:HintAssist.Hint="Budgetdatum (optional)"
                    Margin="0,2,0,0" SelectedDate="{x:Null}"/>
                                </DockPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Betrag -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Betrag" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BetragBox"
                                 Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                 Style="{StaticResource BigTextBox}"
                                 materialDesign:HintAssist.Hint="z. B. 125.50"
                                 materialDesign:TextFieldAssist.HasClearButton="True"/>

                        <!-- Bank (Geldinstitut) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Geldinstitut" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="BankBox"
                                  Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                  Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  materialDesign:HintAssist.Hint="Bankkonto wählen"/>

                        <!-- Von-Konto (Budgetkonto) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Von-Konto" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VonKontoBox"
                                  Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                  Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Anzeige"
                                  SelectedValuePath="Id"
                                  materialDesign:HintAssist.Hint="Budgetkonto (Quelle)"/>

                        <!-- Nach-Konto (Budgetkonto) -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nach-Konto" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="NachKontoBox"
                                  Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                                  Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Anzeige"
                                  SelectedValuePath="Id"
                                  materialDesign:HintAssist.Hint="Budgetkonto (Ziel)"/>

                        <!-- Adresse -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Adresse" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="AdresseBox"
                                  Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                                  Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  materialDesign:HintAssist.Hint="optional, z. B. Lieferant/Dienstleister"/>

                        <!-- Notiz -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Notiz" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NotizBox"
                                 Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                                 Style="{StaticResource BigTextBox}"
                                 materialDesign:HintAssist.Hint="freiwillig (wird gespeichert)"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="84"/>

                        <!-- Hinweise -->
                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <materialDesign:PackIcon Kind="InformationOutline" Margin="0,0,8,0"/>
                            <TextBlock Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}">
                                Felder werden je nach Buchungstyp aktiviert. 
                                Beispiel: Bei „Bank → Konto“ wähle Bank und Nach-Konto.
                            </TextBlock>
                        </StackPanel>

                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:BaseWindow>