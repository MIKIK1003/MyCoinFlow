<UserControl x:Class="MyCoinFlow.Views.AddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="16">
        <!-- Sidebar links + Tabelle rechts -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR LINKS ============ -->
        <Border Grid.Column="0"
                Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Filter und Aktionen"
                               Style="{StaticResource SidebarSectionHeader}"/>

                    <!-- Suche -->
                    <TextBlock Text="Suche"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SearchBox"
                             MinHeight="40"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Name, PLZ/Ort, IBAN, Notiz…"
                             KeyDown="SearchBox_KeyDown"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Magnify"
                                Content="Suchen"
                                MinHeight="40"
                                Margin="0,0,10,0"
                                Width="118"
                                Click="ApplySearch_Click"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="CloseCircle"
                                Content="Leeren"
                                MinHeight="40"
                                Width="118"
                                Click="ClearSearch_Click"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,12"/>

                    <!-- Aktionen -->
                    <TextBlock Text="Aktionen Adressen"
                               Style="{StaticResource SidebarGroupHeader}"
                               Margin="0,0,0,8"/>

                    <StackPanel>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Accountboxplusoutline"
                                Content="Neue Adresse"
                                MinHeight="40"
                                Margin="0,0,0,10"
                                Command="{Binding NeuCommand}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="accountboxeditoutline"
                                Content="Bearbeiten"
                                MinHeight="40"
                                Margin="0,0,0,10"
                                Command="{Binding BearbeitenCommand}"/>

                        <Button Style="{StaticResource IconTextButton.Danger}"
                                Tag="accountremove"
                                Content="Löschen"
                                MinHeight="40"
                                Command="{Binding LoeschenCommand}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ RECHTS: TABELLE (funktional unverändert) ============ -->
        <Border Grid.Column="2"
                CornerRadius="{StaticResource AppCornerRadius.Card}"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12">

            <DataGrid x:Name="AddressesGrid"
                      ItemsSource="{Binding Adressen}"
                      SelectedItem="{Binding AusgewaehlteAdresse}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      FrozenColumnCount="1"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      RowHeight="40"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="{x:Null}">

                <!-- Header-Farbe wie Sidebar -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Resources>
                    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="Padding" Value="0,0,8,0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- Transaktionen (Icon links) -->
                    <DataGridTemplateColumn Header="" Width="52" MinWidth="52" MaxWidth="52" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button ToolTip="Transaktionen der Adresse anzeigen und drucken"
                                        Command="{Binding DataContext.ZeigeAdresseTransaktionenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="0"
                                        HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="FileDocumentMultipleOutline"
                                                             Style="{StaticResource DefaultIconStyle}"
                                                             Width="24" Height="24"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Daten-Spalten – exakt wie zuvor -->
                    <DataGridTextColumn Header="Name"       Binding="{Binding Name}"     Width="2*"/>
                    <DataGridTextColumn Header="IBAN"       Binding="{Binding IBAN}"     Width="*"/>
                    <DataGridTextColumn Header="Typ"        Binding="{Binding Typ}"      Width="*"/>
                    <DataGridTextColumn Header="Straße"     Binding="{Binding Strasse}"  Width="*"/>
                    <DataGridTextColumn Header="PLZ"        Binding="{Binding PLZ}"      Width="Auto"/>
                    <DataGridTextColumn Header="Ort"        Binding="{Binding Ort}"      Width="*"/>
                    <DataGridTextColumn Header="Land"       Binding="{Binding Land}"     Width="Auto"/>
                    <DataGridTextColumn Header="Notiz"      Binding="{Binding Notiz}"    Width="2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
