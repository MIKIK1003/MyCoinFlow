<UserControl x:Class="MyCoinFlow.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <UserControl.Resources>
        <!-- NEU: benötigt für Visibility-Binding des Override-Icons -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR LINKS: Filter & Aktionen ============ -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Überschrift -->
                    <TextBlock Text="Filter und Aktionen"
                               FontSize="18" Margin="0,0,0,12"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                    <!-- Suche -->
                    <TextBlock Text="Suche" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                    <TextBox MinHeight="40"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Suchen (Text, Nr., Betrag, Konto, OCR)"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplySearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Datum -->
                    <TextBlock Text="Datum" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="von" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                            <DatePicker SelectedDate="{Binding FilterVon}" MinHeight="36">
                                <!-- ENTER im DatePicker ist unzuverlässig; wir triggern auf Datum-Änderung -->
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedDateChanged">
                                        <i:InvokeCommandAction Command="{Binding ApplySearchCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DatePicker.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplySearchCommand}"/>
                                </DatePicker.InputBindings>
                            </DatePicker>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="bis" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                            <DatePicker SelectedDate="{Binding FilterBis}" MinHeight="36">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedDateChanged">
                                        <i:InvokeCommandAction Command="{Binding ApplySearchCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DatePicker.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplySearchCommand}"/>
                                </DatePicker.InputBindings>
                            </DatePicker>
                        </StackPanel>
                    </Grid>

                    <!-- Adresse -->
                    <TextBlock Text="Adresse" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>
                    <TextBox MinHeight="36"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Name enthält…"
                             Text="{Binding FilterAdresse, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplySearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Suche-Aktionen -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Magnify"
                                Content="Suchen"
                                MinHeight="40"
                                Margin="0,0,8,0"
                                IsDefault="True"
                                Command="{Binding ApplySearchCommand}" Width="109"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="CloseCircle"
                                Content="Leeren"
                                MinHeight="40"
                                Command="{Binding ClearSearchCommand}" Width="109"/>
                    </StackPanel>

                    <!-- Aktionen -->
                    <TextBlock Text="Aktionen" Margin="0,20,0,8"
                               Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                    <StackPanel>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="invoiceplus" Content="Buchung"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding NeuBuchungCommand}"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="invoiceedit" Content="Bearbeiten"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding BearbeitenCommand}"/>
                        <Button Style="{StaticResource IconTextButton.Danger}"
                                Tag="invoiceremove" Content="Löschen"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding LoeschenCommand}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="ContentDuplicate" Content="Duplikate…"
                                ToolTip="Sucht Transaktionen mit gleichem Datum und Betrag und erlaubt das gezielte Löschen der Doppelten"
                                MinHeight="40" Margin="0,0,0,16"
                                Command="{Binding DuplikateCommand}"/>

                        <TextBlock Text="Import" Margin="0,20,0,8"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="fileimport" Content="Bankimport…"
                                MinHeight="40" Margin="0,0,0,8"
                                Command="{Binding OpenBankImportCommand}"/>
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="creditcard" Content="Kreditkarten"
                                MinHeight="40" Margin="0,0,0,16"
                                Click="OpenCreditCardImport_Click"/>

                        <TextBlock Text="Berichte" Margin="0,20,0,8"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="ChartBoxOutline" Content="Transaktionsbericht…"
                                ToolTip="Ausgewählte Konten nach Budget, Ist und Jahreshochrechnung auswerten"
                                MinHeight="40"
                                Command="{Binding OpenReportCommand}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ RECHTS: Liste ============ -->
        <Grid Grid.Column="1">
            <DataGrid x:Name="TransaktionenGrid"
                      ItemsSource="{Binding Transaktionen}"
                      SelectedItem="{Binding AusgewaehlteTransaktion}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionChanged="TransaktionenGrid_SelectionChanged">

                <!-- Treffer-Hinweis als Tooltip pro Zeile -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding SearchHitInfo}"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Buchungstext im Web recherchieren"
                                  Command="{Binding PlacementTarget.DataContext.WebRechercheCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Magnify"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>

                    <!-- Aktionen (PDF) – links als erste Spalte -->
                    <DataGridTemplateColumn Header="" Width="200" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- PDF Anhängen -->
                                    <Button ToolTip="PDF Anhängen"
                                            Command="{Binding DataContext.AttachPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="0"
                                            HorizontalAlignment="Right">
                                        <materialDesign:PackIcon
                                            Kind="FilePlusOutline"
                                            Style="{StaticResource DefaultIconStyle}"
                                            Width="24" Height="24"/>
                                    </Button>

                                    <!-- Öffnen (Icon wechselt / Badge ab 2) -->
                                    <Button ToolTip="PDF Öffnen"
                                            ToolTipService.ToolTip="{Binding AttachmentsTooltip}"
                                            IsEnabled="{Binding HasAttachments}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            Content="{Binding}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <materialDesign:PackIcon x:Name="IconPdf"
                                                                             Kind="filedocumentcheckoutline"
                                                                             Style="{StaticResource DefaultIconStyle}"
                                                                             Width="24" Height="24"
                                                                             Visibility="Collapsed"/>
                                                    <materialDesign:PackIcon x:Name="IconEmpty"
                                                                             Kind="DotsVertical"
                                                                             Style="{StaticResource DefaultIconStyle}"
                                                                             Width="24" Height="24"
                                                                             Visibility="Visible"/>
                                                    <Border x:Name="Badge"
                                                            Background="{DynamicResource PrimaryHueMidBrush}"
                                                            CornerRadius="8"
                                                            Width="16" Height="16"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="-4,-4,0,0"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="{Binding AttachmentCount}"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                        <Setter TargetName="IconPdf"   Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="IconEmpty" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasMultipleAttachments}" Value="True">
                                                        <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <!-- Anhänge verwalten … -->
                                    <Button ToolTip="Anhänge Verwalten"
                                            Command="{Binding DataContext.ManageAttachmentsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="0"
                                            HorizontalAlignment="Right">
                                        <materialDesign:PackIcon
                                            Kind="dotsvertical"
                                            Style="{StaticResource DefaultIconStyle}"
                                            Width="24" Height="24"/>
                                    </Button>

                                    <!-- NEU: Budgetdatum-Override Icon -->
                                    <Button ToolTip="{Binding BudgetDatumTooltip}"
        Visibility="{Binding HasBudgetDatumOverride, Converter={StaticResource BoolToVis}}"
        Style="{StaticResource MaterialDesignFlatButton}"
        Padding="0"
        HorizontalAlignment="Right"
        IsHitTestVisible="False">
                                        <materialDesign:PackIcon
        Kind="CalendarAlert"
        Style="{StaticResource DefaultIconStyle}"
        Width="24" Height="24"/>
                                    </Button>




                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Daten-Spalten -->
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Transaktions-#" Binding="{Binding Id}" Width="110"/>
                    <DataGridTextColumn Header="Von"   Binding="{Binding VonAnzeige}" Width="*"/>
                    <DataGridTextColumn Header="Nach"  Binding="{Binding NachAnzeige}" Width="*"/>
                    <DataGridTextColumn Header="Betrag" Binding="{Binding Betrag, StringFormat={}{0:C2}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Adresse"      Binding="{Binding AdresseName}" Width="*"/>
                    <DataGridTextColumn Header="Geldinstitut" Binding="{Binding BankName}"    Width="*"/>
                    <DataGridTextColumn Header="Notiz"        Binding="{Binding Notiz}"      Width="2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
