<base:BaseWindow x:Class="MyCoinFlow.Views.InstitutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Geldinstitut"
        Height="550" Width="520"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Formular -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- unverändert -->
            <TextBlock Text="Name*" Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>

            <TextBlock Text="BIC" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="BicBox" Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>

            <TextBlock Text="IBAN" Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="IbanBox" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>

            <TextBlock Text="Kontonummer" Grid.Row="3" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="KtoBox" Grid.Row="3" Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>

            <TextBlock Text="Notiz" Grid.Row="4" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBox x:Name="NotizBox" Grid.Row="4" Grid.Column="1"
                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

            <TextBlock Text="Anfangsbestand" Grid.Row="5" Grid.Column="0" Margin="0,10,10,8" VerticalAlignment="Center"/>
            <TextBox x:Name="AnfangsbestandBox" Grid.Row="5" Grid.Column="1"
                     Margin="0,10,0,8"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     HorizontalContentAlignment="Right"/>

            <TextBlock Text="ab Datum" Grid.Row="6" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <DatePicker x:Name="AnfangsdatumPicker"
                        Grid.Row="6" Grid.Column="1"/>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    IsCancel="True"
                    Margin="0,0,10,0"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="CheckBold"
                    Content="OK"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>