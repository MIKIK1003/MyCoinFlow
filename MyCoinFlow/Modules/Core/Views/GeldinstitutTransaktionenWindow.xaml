<base:BaseWindow x:Class="MyCoinFlow.Views.GeldinstitutTransaktionenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding Titel}"
        Height="700" Width="1200"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <base:BaseWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </base:BaseWindow.Resources>

    <DockPanel>

        <!-- Linke Seitenleiste: Fix wie im Adressen-Fenster -->
        <Border DockPanel.Dock="Left"
                Width="320"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" Orientation="Vertical">

                    <TextBlock Text="Filter und Aktionen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- Betrag -->
                    <TextBlock Text="Betrag" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="min"
                                 Text="{Binding FilterMinBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="max"
                                 Text="{Binding FilterMaxBetrag, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Datum -->
                    <TextBlock Text="Datum" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0"
                                    materialDesign:HintAssist.Hint="von"
                                    SelectedDate="{Binding FilterVon, UpdateSourceTrigger=PropertyChanged}"/>
                        <DatePicker Grid.Column="2"
                                    materialDesign:HintAssist.Hint="bis"
                                    SelectedDate="{Binding FilterBis, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                        <!-- Adresse -->
                    <TextBlock Text="Adresse" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding Adressen}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding FilterAdresseId, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              HorizontalAlignment="Stretch"/>

                    <!-- Konto -->
                    <TextBlock Text="Konto" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding KontenLookup}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Anzeige"
                              SelectedValue="{Binding FilterKontoId, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              HorizontalAlignment="Stretch"/>

                    <!-- Aktionen -->
                    <StackPanel Margin="0,16,0,0" Orientation="Vertical">
                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Filter"
                                Content="Filter anwenden"
                                Command="{Binding ApplyFilterCommand}"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="FilterRemove"
                                Content="Zurücksetzen"
                                Margin="0,8,0,0"
                                Command="{Binding ResetFilterCommand}"/>

                        <Separator Margin="0,8,0,8"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Edit"
                                Content="Bearbeiten"
                                Margin="0,8,0,0"
                                Click="Edit_Click"/>

                        <Separator Margin="0,8,0,8"/>


                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Printer"
                                Content="Drucken"
                                ToolTip="Drucken (A4 Querformat)"
                                Click="Print_Click"/>

                        <Button Style="{StaticResource IconTextButton}"
                                Tag="Close"
                                Content="Schließen"
                                Margin="0,8,0,0"
                                Click="Close_Click"/>
                    </StackPanel>

                    <!-- Zusammenfassung -->
                    <Border Margin="0,16,0,0" Padding="8"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Einnahmen -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Einnahmen" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummeEinnahmenText}" TextAlignment="Right"/>

                            <!-- Ausgaben -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ausgaben" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummeAusgabenText}" TextAlignment="Right"/>

                            <!-- Unterlinie über volle Breite -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2"
                                    Margin="0,6,0,6"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,1,0,0"/>

                            <!-- Saldo -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Saldo" FontWeight="Bold" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SaldoText}" TextAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Tabelle rechts -->
        <Grid Margin="12">
            <DataGrid x:Name="TransGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      SelectionUnit="FullRow"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                <DataGrid.Resources>
                    <Style x:Key="TrimLeft" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                    <Style x:Key="TrimRight" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button ToolTip="{Binding BudgetDatumTooltip}"
                    Visibility="{Binding HasBudgetDatumOverride, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0"
                    IsHitTestVisible="False">

                                    <materialDesign:PackIcon
                    Kind="CalendarAlert"
                    Width="22"
                    Height="22"/>
                                </Button>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat={}{0:yyyy-MM-dd}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Einnahmen" Binding="{Binding Einnahmen, StringFormat={}{0:N2}}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ausgaben" Binding="{Binding Ausgaben, StringFormat={}{0:N2}}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimRight}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Adresse" Binding="{Binding AdresseName}" Width="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrimLeft}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</base:BaseWindow>
