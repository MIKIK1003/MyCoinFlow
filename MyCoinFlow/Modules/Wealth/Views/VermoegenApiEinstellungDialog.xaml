<base:BaseWindow x:Class="MyCoinFlow.Views.VermoegenApiEinstellungDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
                 Title="Kursdaten-API"
                 Width="620"
                 Height="360"
                 SizeToContent="Manual"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kursdaten-API"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">

            <TextBox MinHeight="40"
                     IsReadOnly="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Anbieter"
                     Text="{Binding Model.ApiProvider}"
                     Margin="0,0,0,12"/>

            <TextBox x:Name="ApiKeyBox"
                     MinHeight="40"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="EODHD API-Key"
                     Text="{Binding Model.ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <CheckBox Content="API verwenden"
                      IsChecked="{Binding Model.Aktiv, Mode=TwoWay}"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Der API-Key wird lokal in der MyCoinFlow-Datenbank gespeichert."
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="ContentSave"
                    Content="Speichern"
                    Width="130"
                    IsDefault="True"
                    Click="Speichern_Click"
                    Margin="0,0,10,0"/>

            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Abbrechen"
                    Width="130"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>