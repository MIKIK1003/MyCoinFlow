<base:BaseWindow x:Class="MyCoinFlow.Views.DmsAssignTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Transaktion zuweisen"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HinweisText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"/>

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="BetragBox"
                     Grid.Column="0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Betrag"
                     Margin="0,0,8,0"/>

            <DatePicker x:Name="VonPicker"
                        Grid.Column="1"
                        materialDesign:HintAssist.Hint="Von"
                        Margin="0,0,8,0"/>

            <DatePicker x:Name="BisPicker"
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="Bis"
                        Margin="0,0,8,0"/>

            <TextBox x:Name="SuchTextBox"
                     Grid.Column="3"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Adresse, Bank, Notiz…"
                     Margin="0,0,8,0"
                     KeyDown="SuchTextBox_KeyDown"/>

            <Button Grid.Column="4"
                    Style="{StaticResource IconTextButton}"
                    Tag="Magnify"
                    Content="Suchen"
                    Click="Suchen_Click"/>
        </Grid>

        <DataGrid x:Name="GridKandidaten"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding DatumAnzeige}" Width="90"/>
                <DataGridTextColumn Header="Betrag" Binding="{Binding BetragAnzeige}" Width="100"/>
                <DataGridTextColumn Header="Adresse / Bank" Binding="{Binding WerAnzeige}" Width="*"/>
                <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconTextButton}"
                    Tag="Close"
                    Content="Keine Zuordnung"
                    Margin="0,0,10,0"
                    Click="KeineZuordnung_Click"/>
            <Button Style="{StaticResource IconTextButton}"
                    Tag="CheckBold"
                    Content="Zuweisen"
                    IsDefault="True"
                    Click="Zuweisen_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>
