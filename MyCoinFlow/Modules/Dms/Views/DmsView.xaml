<UserControl x:Class="MyCoinFlow.Views.DmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <!-- Sidebar | Divider | Suchleiste + Tabelle -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== SIDEBAR ================== -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel>
                <TextBlock Text="DMS"
                           Style="{StaticResource SidebarSectionHeader}"/>

                <!-- Gruppe: Erfassen -->
                <TextBlock Text="Erfassen"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,8"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="Scanner"
                        Content="Scannen"
                        ToolTip="Papierdokument über den angeschlossenen Scanner einlesen und in den Arbeitsordner legen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding ScannenCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="Upload"
                        Content="Dokument hochladen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding HochladenCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="History"
                        Content="Verlauf"
                        ToolTip="Zeigt eine Historie aller automatisch verarbeiteten Dokumente – das Fenster kann offen bleiben, während in der App weitergearbeitet wird"
                        MinHeight="40"
                        Command="{Binding VerlaufAnzeigenCommand}"/>

                <Separator Margin="0,14,0,12"/>

                <!-- Gruppe: Dokument -->
                <TextBlock Text="Dokument"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,8"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="FileEye"
                        Content="Öffnen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding OeffnenCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="Pencil"
                        Content="Bearbeiten"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding BearbeitenCommand}"/>

                <Button Style="{StaticResource IconTextButton.Danger}"
                        Tag="Delete"
                        Content="Löschen"
                        MinHeight="40"
                        Command="{Binding LoeschenCommand}"/>

                <Separator Margin="0,14,0,12"/>

                <!-- Gruppe: Transaktions-Zuordnung -->
                <TextBlock Text="Transaktions-Zuordnung"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,8"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="LinkVariant"
                        Content="Transaktion zuweisen"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding TransaktionZuweisenCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="Refresh"
                        Content="Suche erneut"
                        ToolTip="Automatisches Matching für das ausgewählte Dokument erneut versuchen (z. B. wenn die Buchung erst jetzt erfasst wurde)"
                        MinHeight="40" Margin="0,0,0,8"
                        Command="{Binding SucheErneutCommand}"/>

                <Button Style="{StaticResource IconTextButton}"
                        Tag="Magnify"
                        Content="Alle automatisch suchen"
                        ToolTip="Automatisches Matching für alle noch nicht zugeordneten Dokumente erneut versuchen"
                        MinHeight="40"
                        Command="{Binding AlleErneutSuchenCommand}"/>

                <Separator Margin="0,14,0,12"/>

                <TextBlock Text="Kategorie"
                           Style="{StaticResource SidebarGroupHeader}"
                           Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Kategorien}"
                          SelectedItem="{Binding KategorieFilter}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          MinHeight="40"/>
            </StackPanel>
        </Border>

        <!-- ================== INHALT ================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconTextButton}"
                        Tag="Magnify"
                        Content="Suchen"
                        Margin="8,0,0,0"
                        Command="{Binding SuchenCommand}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Volltextsuche (Dateiname, Titel, Kategorie, Inhalt)"
                         MinHeight="40">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SuchenCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!-- Arbeitsordner-Verarbeitung: nur sichtbar, während der Watcher gerade aktiv ist -->
            <Border Grid.Row="2"
                    Padding="10"
                    CornerRadius="8"
                    Margin="0,0,0,12"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Visibility="{Binding WatcherIsBusy, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon DockPanel.Dock="Left"
                                             Kind="Sync"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             RenderTransformOrigin="0.5,0.5">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform/>
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(materialDesign:PackIcon.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Verarbeite:"/>
                        <Run Text="{Binding WatcherCurrentFile, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" – "/>
                        <Run Text="{Binding WatcherPhase, Mode=OneWay}"/>
                        <Run Text=" · noch "/>
                        <Run Text="{Binding WatcherQueueCount, Mode=OneWay}"/>
                        <Run Text=" in Warteschlange"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding Dokumente}"
                      SelectedItem="{Binding AusgewaehltesDokument}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      RowHeaderWidth="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="{x:Null}">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Überfällige Rechnungen (rot) bzw. ablaufende/abgelaufene Garantien (gelb/orange)
                     farblich hervorheben, damit sie im Grid sofort auffallen. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstGarantieBaldAblaufend}" Value="True">
                                <Setter Property="Background" Value="#FFFFF9E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IstGarantieAbgelaufen}" Value="True">
                                <Setter Property="Background" Value="#FFFFF0D9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IstUeberfaellig}" Value="True">
                                <Setter Property="Background" Value="#FFFDECEA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- Neu-Icon: frisch importierte, noch nicht angeklickte Dokumente -->
                    <DataGridTemplateColumn Header="" Width="40" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="NewBox"
                                                         Width="22" Height="22"
                                                         Foreground="{StaticResource AppBrandBrush}"
                                                         ToolTip="Neu importiert – Zeile anklicken, um die Markierung zu entfernen"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IstNeu, Converter={StaticResource BoolToVisConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="140"/>
                    <DataGridTextColumn Header="Adresse" Binding="{Binding AdresseAnzeige}" Width="140"/>
                    <DataGridTextColumn Header="Betrag" Binding="{Binding BetragAnzeige}" Width="90"/>
                    <DataGridTextColumn Header="Verknüpft mit" Binding="{Binding VerknuepftMitAnzeige}" Width="140"/>
                    <DataGridTextColumn Header="Fällig am" Binding="{Binding FaelligAnzeige}" Width="90"
                                        ToolTipService.ToolTip="30 Tage ab erkanntem Dokumentdatum – rot, falls noch keine Transaktion zugeordnet und überfällig"/>
                    <DataGridTextColumn Header="Garantie bis" Binding="{Binding GarantieAnzeige}" Width="130"/>
                    <DataGridTextColumn Header="Größe" Binding="{Binding SizeDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding ImportedAtUtc, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding OcrStatus}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
