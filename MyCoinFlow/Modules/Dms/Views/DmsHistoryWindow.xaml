<base:BaseWindow x:Class="MyCoinFlow.Views.DmsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="DMS – Verarbeitungs-Historie"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="Automatisch verarbeitete Dokumente (neueste zuerst)"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <Button x:Name="AktualisierenButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconTextButton}"
                    Tag="Refresh"
                    Content="Aktualisieren"
                    Click="AktualisierenButton_Click"/>
        </DockPanel>

        <DataGrid Grid.Row="2"
                  x:Name="HistorieGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  materialDesign:DataGridAssist.CellPadding="8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                  RowHeaderWidth="0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="{x:Null}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding ZeitpunktAnzeige}" Width="150"/>
                <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Ergebnis}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</base:BaseWindow>
