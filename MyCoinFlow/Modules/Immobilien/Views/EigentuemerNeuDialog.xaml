<base:BaseWindow x:Class="MyCoinFlow.Views.EigentuemerNeuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Eigentümer anlegen"
        Width="520"
        Height="400"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Neuer Eigentümer"/>

        <TextBox Grid.Row="2" x:Name="NameBox"
                 materialDesign:HintAssist.Hint="Name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox Grid.Row="4"
                 materialDesign:HintAssist.Hint="E-Mail"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox Grid.Row="6"
                 materialDesign:HintAssist.Hint="Telefon"
                 Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox Grid.Row="8"
                 materialDesign:HintAssist.Hint="Notiz"
                 AcceptsReturn="True" Height="80"
                 TextWrapping="Wrap"
                 Text="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Abbrechen" Click="Abbrechen_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="Speichern" Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>