<base:BaseWindow x:Class="MyCoinFlow.Views.SchluesselZeilenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Schlüssel-Zeilen bearbeiten"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="{Binding TitleText}"
                       DockPanel.Dock="Left"/>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Zeile löschen"
                    Click="DeleteRow_Click"
                    Margin="8,0,0,0"/>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Zeile hinzufügen"
                    Click="AddRow_Click"/>
        </DockPanel>

        <DataGrid Grid.Row="2"
                  x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  CellEditEnding="Grid_CellEditEnding">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Einheit (optional)" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EinheitBezeichnung}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Einheiten, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Bezeichnung"
                                      SelectedValue="{Binding EinheitId, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="220"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Eigentümer / Fallback" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EigentuemerName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Owners, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding EigentuemerId, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="220"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Anteil (%)"
                    Binding="{Binding AnteilProzent,
                                      UpdateSourceTrigger=LostFocus,
                                      ConverterCulture=de-CH,
                                      StringFormat={}{0:0.####}}"
                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" LastChildFill="False" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Left"
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                       Text="{Binding SumInfo}"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Abbrechen"
                        Click="Cancel_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Speichern"
                        Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</base:BaseWindow>