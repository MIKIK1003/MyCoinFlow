<base:BaseWindow x:Class="MyCoinFlow.Views.EigentumZuordnenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Eigentümer zuordnen"
        Width="520"
        Height="340"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Eigentümer zuordnen"/>

        <ComboBox Grid.Row="2"
                  x:Name="OwnerBox"
                  ItemsSource="{Binding Owners}"
                  SelectedItem="{Binding SelectedOwner}"
                  DisplayMemberPath="Name"
                  materialDesign:HintAssist.Hint="Eigentümer" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding Von}" />
            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding Bis}" />
        </Grid>

        <TextBlock Grid.Row="6"
                   Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                   Text="Von ist Pflicht. Bis kann leer bleiben (aktuell gültig)."
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Abbrechen"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>