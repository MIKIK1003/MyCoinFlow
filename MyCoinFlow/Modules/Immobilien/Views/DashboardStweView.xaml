<UserControl x:Class="MyCoinFlow.Views.DashboardStweView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock Text="{Binding Header}"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       DockPanel.Dock="Left"/>

            <Button Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    DockPanel.Dock="Right">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
            </Button>
        </DockPanel>

        <!-- NEU: Debug/Status-Zeile -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- 2x2 Blatt für 4 Charts -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Row="0" Grid.Column="0" Padding="12" Margin="0,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Energie kWh (Rechnung / Interne / Solar direkt) – Q1–Q4"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding EnergieKwhSeries}"
                                        XAxes="{Binding EnergieKwhXAxes}"
                                        YAxes="{Binding EnergieKwhYAxes}"
                                        LegendPosition="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="0" Grid.Column="1" Padding="12" Margin="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Solar-Anteil % – Q1–Q4"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding SolarAnteilSeries}"
                                        XAxes="{Binding SolarAnteilXAxes}"
                                        YAxes="{Binding SolarAnteilYAxes}"
                                        LegendPosition="Hidden"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Grid.Column="0" Padding="12" Margin="0,8,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="kWh pro Eigentümer (direkt + anteilig ALLG+HEIZ)"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding KwhProOwnerSeries}"
                                        XAxes="{Binding KwhProOwnerXAxes}"
                                        YAxes="{Binding KwhProOwnerYAxes}"
                                        LegendPosition="Hidden"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Grid.Column="1" Padding="12" Margin="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="CHF pro Eigentümer (aus Verteilung / SetLines)"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding ChfProOwnerSeries}"
                                        XAxes="{Binding ChfProOwnerXAxes}"
                                        YAxes="{Binding ChfProOwnerYAxes}"
                                        LegendPosition="Hidden"/>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
