<base:BaseWindow x:Class="MyCoinFlow.Views.EinheitNeuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:base="clr-namespace:MyCoinFlow.UI.Base"
        Title="Einheit anlegen"
        Width="520"
        Height="500"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="Neue Einheit" />

        <TextBox Grid.Row="2"
                 x:Name="BezBox"
                 materialDesign:HintAssist.Hint="Bezeichnung (z. B. Whg 3.2)"
                 Text="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4"
                 materialDesign:HintAssist.Hint="Typ (z. B. Wohnung, Garage, Keller)"
                 Text="{Binding Typ, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     materialDesign:HintAssist.Hint="MEA (‰)"
                     Text="{Binding MeaPromille, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Grid.Column="2"
                     materialDesign:HintAssist.Hint="Fläche (m²)"
                     Text="{Binding FlaecheM2, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBox Grid.Row="8"
                 materialDesign:HintAssist.Hint="Notiz"
                 AcceptsReturn="True"
                 Height="90"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Notiz, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Abbrechen"
                    Click="Abbrechen_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Speichern"
                    Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</base:BaseWindow>