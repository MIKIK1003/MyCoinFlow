<UserControl x:Class="MyCoinFlow.Views.HaushaltView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidebarCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Haushalt" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Filter" FontWeight="SemiBold" Margin="0,6,0,6"/>

                    <ComboBox ItemsSource="{Binding Standorte}"
                              SelectedItem="{Binding SelectedStandort}"
                              DisplayMemberPath="Bezeichnung"
                              Margin="0,0,0,10"/>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Standorte" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding NeuerStandortCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Standort neu"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding StandortBearbeitenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Standort bearbeiten"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding StandortLoeschenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Standort löschen"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Navigation" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding KannZurueckZuRaeumen}" Command="{Binding ZurueckZuRaeumenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zurück zu Räume"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding IsObjektAnsicht}" Command="{Binding ZurueckZumRaumCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zurück zum Raum"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Räume" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding IsRaeumeAnsicht}" Command="{Binding NeuerRaumCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Raum neu"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding HatAusgewaehltenRaum}" Command="{Binding RaumBearbeitenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Raum bearbeiten"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding HatAusgewaehltenRaum}" Command="{Binding RaumLoeschenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Raum löschen"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Objekte" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding IsRaumAnsicht}" Command="{Binding NeuesObjektCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Objekt neu"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding HatAusgewaehltesObjekt}" Command="{Binding ObjektBearbeitenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Objekt bearbeiten"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding HatAusgewaehltesObjekt}" Command="{Binding ObjektLoeschenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Objekt löschen"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Konfiguration" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding KategorienVerwaltenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShapeOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Kategorien"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding ArbeitsanweisungenVerwaltenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Tätigkeiten"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding ZeitintervalleVerwaltenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Zeitintervalle"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6,0,10"/>

                    <TextBlock Text="Aufgaben" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding AufgabenAktualisierenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Aufgaben aktualisieren"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" Command="{Binding AufgabenAnzeigenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardListOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Aufgaben anzeigen"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,8" Margin="0,0,0,8" IsEnabled="{Binding HatAusgewaehlteAufgabe}" Command="{Binding AufgabeErledigenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Aufgabe erledigen"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Titel}" FontSize="26" FontWeight="SemiBold"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource MaterialDesignBodySecondaryBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Row="4" Text="{Binding InhaltsTitel}" FontSize="20" FontWeight="SemiBold"/>

            <Grid Grid.Row="6">

                <ItemsControl ItemsSource="{Binding Raeume}" Visibility="{Binding RaeumeVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="230"
                                    Height="140"
                                    Margin="0,0,14,14"
                                    Command="{Binding DataContext.RaumOeffnenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">

                                <Button.InputBindings>
                                    <MouseBinding MouseAction="RightClick"
                                                  Command="{Binding DataContext.RaumMarkierenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Button.InputBindings>

                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{Binding StandortBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Opacity" Value="0.72"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <materialDesign:PackIcon Grid.Row="0"
                                                             Kind="{Binding Icon}"
                                                             Width="34"
                                                             Height="34"
                                                             HorizontalAlignment="Left"
                                                             Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Bezeichnung}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding StandortBezeichnung}"
                                               FontSize="12"
                                               Opacity="0.8"/>

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding ObjektAnzahlText}"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Objekte}" Visibility="{Binding RaumVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="220"
                                    Height="130"
                                    Margin="0,0,14,14"
                                    Command="{Binding DataContext.ObjektOeffnenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">

                                <Button.InputBindings>
                                    <MouseBinding MouseAction="RightClick"
                                                  Command="{Binding DataContext.ObjektMarkierenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Button.InputBindings>

                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{Binding StandortBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Opacity" Value="0.72"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <materialDesign:PackIcon Grid.Row="0"
                                                             Kind="{Binding Icon}"
                                                             Width="34"
                                                             Height="34"
                                                             Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Bezeichnung}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding TaetigkeitText}"
                                               FontSize="13"
                                               Opacity="0.85"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Visibility="{Binding ObjektVisibility}"
                        Background="{DynamicResource MaterialDesignPaper}"
                        Padding="22"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                    <StackPanel>

                        <materialDesign:PackIcon Kind="{Binding GeoeffnetesObjekt.Icon}"
                                                 Width="46"
                                                 Height="46"
                                                 Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding GeoeffnetesObjekt.Bezeichnung}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding GeoeffnetesObjekt.Kategorie}"
                                   Margin="0,4,0,22"
                                   Opacity="0.75"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tätigkeit" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.ArbeitsanweisungBezeichnung}"/>

                            <TextBlock Grid.Row="2" Text="Zeitintervall" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.ZeitintervallBezeichnung}"/>

                            <TextBlock Grid.Row="4" Text="Aktivierung" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.VorlaufTage,StringFormat={}{0} Tage vorher}"/>

                            <TextBlock Grid.Row="6" Text="Status" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.AufgabenStatus}"/>

                            <TextBlock Grid.Row="8" Text="Aktiv ab" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.AktivAbText}"/>

                            <TextBlock Grid.Row="10" Text="Fällig am" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="10" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.FaelligAmText}"/>

                            <TextBlock Grid.Row="12" Text="Letzte Ausführung" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="12" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.LetzteAusfuehrungText}"/>

                            <TextBlock Grid.Row="14" Text="Hersteller" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="14" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.Hersteller}"/>

                            <TextBlock Grid.Row="16" Text="Modell" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="16" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.Modell}"/>

                            <TextBlock Grid.Row="18" Text="Bemerkung" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="18" Grid.Column="1"
                                       Text="{Binding GeoeffnetesObjekt.Bemerkung}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Button Content="Als erledigt markieren"
                                Width="220"
                                Height="42"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ObjektAlsErledigtMarkierenCommand}"/>

                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Aufgaben}"
              Visibility="{Binding AufgabenVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="300"
                    Height="160"
                    Margin="0,0,14,14"
                    Command="{Binding DataContext.AufgabeMarkierenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">

                                <Button.Style>
                                    <Style TargetType="Button"
                           BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="#F2F2F2"/>
                                        <Setter Property="Foreground" Value="Black"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                                <Setter Property="Opacity"
                                        Value="0.72"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="{Binding StatusIcon}"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="{Binding StatusBrush}"
                                                 Margin="0,2,8,0"/>

                                        <TextBlock Text="{Binding StatusAmpelText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding Titel}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding RestTageText}"
                                   FontSize="13"
                                   Opacity="0.8"
                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2"
      Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Aktiv ab"
                   FontSize="11"
                   Opacity="0.7"/>
                                            <TextBlock Text="{Binding AktivAbText}"
                   FontSize="13"
                   FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Fällig"
                   FontSize="11"
                   Opacity="0.7"/>
                                            <TextBlock Text="{Binding FaelligAmText}"
                   FontSize="13"
                   FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
            Width="36"
            Height="36"
            Padding="0"
            ToolTip="Aufgabe erledigen"
            Command="{Binding DataContext.AufgabeDirektErledigenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Check"
                                 Width="20"
                                 Height="20"/>
                                        </Button>
                                    </Grid>




                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Grid>
    </Grid>
</UserControl>