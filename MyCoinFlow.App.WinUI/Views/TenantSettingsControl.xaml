<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.TenantSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Mandanten und Benutzer" FontSize="24" FontWeight="SemiBold"/>
  <TabView Grid.Row="1" IsAddTabButtonVisible="False">
   <TabViewItem Header="Neu anlegen"><ScrollViewer Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="12"><TextBlock Text="Neuen Mandanten anlegen (leer – Schema nur)" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="NewTenantNameBox" Header="Datenbankname"/><Button Content="Anlegen (leer)" HorizontalAlignment="Left" Click="OnCreateTenantClick"/></StackPanel></ScrollViewer></TabViewItem>
   <TabViewItem Header="Daten kopieren"><ScrollViewer Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="10"><TextBlock Text="Daten zwischen Datenbanken kopieren (Quelle → Ziel)" FontSize="17" FontWeight="SemiBold"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="SourceDatabaseBox" Header="Quelle (DB)" IsEditable="True"/><ComboBox x:Name="TargetDatabaseBox" Grid.Column="1" Header="Ziel (DB)" IsEditable="True"/></Grid><CheckBox x:Name="CopyNumberRangesBox" Content="Nummernkreise" IsChecked="True"/><CheckBox x:Name="CopyAccountsBox" Content="Kontenstruktur" IsChecked="True"/><CheckBox x:Name="CopyAddressesBox" Content="Adressen" IsChecked="True"/><CheckBox x:Name="CopyAliasesBox" Content="Aliase" IsChecked="True"/><CheckBox x:Name="CopyInstitutionsBox" Content="Geldinstitute (ohne Anfangsbestand)" IsChecked="True"/><CheckBox x:Name="CopyImportBox" Content="Import-Schema und Mapping" IsChecked="True"/><CheckBox x:Name="CopyCategoryBox" Content="Kategorie → Konto" IsChecked="True"/><CheckBox x:Name="CopyBudgetBox" Content="Budgetzeitraum (aktuelles Jahr)" IsChecked="True"/><Button Content="Ausführen" HorizontalAlignment="Left" Click="OnCopyClick"/></StackPanel></ScrollViewer></TabViewItem>
   <TabViewItem Header="Benutzer"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ActiveDatabaseText" VerticalAlignment="Center"/><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Aktualisieren" Click="OnRefreshUsersClick"/><AppBarButton Label="Neuer Benutzer" Click="OnAddUserClick"/><AppBarButton Label="Passwort zurücksetzen" Click="OnResetPasswordClick"/><AppBarButton Label="Aktiv/Inaktiv" Click="OnToggleActiveClick"/><AppBarButton Label="Admin/Standard" Click="OnToggleAdminClick"/></CommandBar></Grid><ListView x:Name="UsersList" Grid.Row="1"><ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Username" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="E-Mail" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Aktiv" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Admin" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Erstellt" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Username}"/><TextBlock Grid.Column="1" Text="{Binding Email}"/><CheckBox Grid.Column="2" IsChecked="{Binding IsActive}" IsHitTestVisible="False"/><CheckBox Grid.Column="3" IsChecked="{Binding IsAdmin}" IsHitTestVisible="False"/><TextBlock Grid.Column="4" Text="{Binding CreatedAt}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></TabViewItem>
  </TabView>
  <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
