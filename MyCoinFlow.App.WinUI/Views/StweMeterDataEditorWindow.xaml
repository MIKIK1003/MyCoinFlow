<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow x:Class="MyCoinFlow.WinUI.Views.StweMeterDataEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:window="using:MyCoinFlow.WinUI" xmlns:converters="using:MyCoinFlow.WinUI.Converters" Title="Zählerdaten">
    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources><converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/><converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Die Erfassungs- und Validierungslogik entspricht der bisherigen Zählermaske" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"><AppBarButton Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Abbrechen" Click="OnCancelClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8BB;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14"><Grid ColumnSpacing="14" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="210"/><ColumnDefinition Width="170"/><ColumnDefinition Width="210"/><ColumnDefinition Width="170"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Erfassungsart" VerticalAlignment="Center"/><ComboBox x:Name="ModeBox" Grid.Column="1" SelectionChanged="OnModeChanged"><ComboBoxItem Content="Differenz (Zählerstand)"/><ComboBoxItem Content="Monatswerte (kWh)"/></ComboBox>
            <TextBlock Grid.Column="2" Text="Anzahl Monate" VerticalAlignment="Center"/><NumberBox x:Name="MonthsBox" Grid.Column="3" Minimum="1" Maximum="120" SpinButtonPlacementMode="Inline" ValueChanged="OnMonthsChanged"/>
            <TextBlock Grid.Column="4" Text="Erfasst am" VerticalAlignment="Center"/><CalendarDatePicker x:Name="DatePicker" Grid.Column="5"/>
            <TextBlock Grid.Row="1" Text="Rechnung kWh total" VerticalAlignment="Center"/><TextBox x:Name="InvoiceBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Gutschrift CHF (optional)" VerticalAlignment="Center"/><TextBox x:Name="CreditBox" Grid.Row="1" Grid.Column="3" TextAlignment="Right"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Rückspeisung kWh (optional)" VerticalAlignment="Center"/><TextBox x:Name="FeedInBox" Grid.Row="1" Grid.Column="5" TextAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="Notiz" VerticalAlignment="Top"/><TextBox x:Name="NoteBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" AcceptsReturn="True" MinHeight="58"/>
        </Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0"><ListView x:Name="RowsList" SelectionMode="None"><ListView.Header><Grid Padding="12,9" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="2.6*"/></Grid.ColumnDefinitions><TextBlock Text="Typ" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Zähler" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Einheit" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Wert" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="2.6*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Type}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding UnitText}" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding NewText, Mode=TwoWay}" Visibility="{Binding IsDifference, Converter={StaticResource BoolToVisibility}}" MaxWidth="220" HorizontalAlignment="Left" TextAlignment="Right"/><StackPanel Grid.Column="3" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}" Spacing="6"><ItemsControl ItemsSource="{Binding Months}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,10,6" Spacing="2"><TextBlock Text="{Binding Label}" FontSize="11"/><TextBox Width="85" Text="{Binding Text, Mode=TwoWay}" TextAlignment="Right"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding MonthsInfo}" FontWeight="SemiBold"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Warning"/>
    </Grid>
</window:PersistentWindow>
