<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.PathsSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Dateianhänge und OCR" FontSize="24" FontWeight="SemiBold"/>
  <TabView Grid.Row="1" IsAddTabButtonVisible="False">
   <TabViewItem Header="Verzeichnisse"><ScrollViewer Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="880" HorizontalAlignment="Left" Spacing="12"><TextBlock Text="Dokumentenablage" FontSize="17" FontWeight="SemiBold"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="AttachmentRootBox" Header="Zielordner"/><TextBox x:Name="MaxMbBox" Grid.Column="1" Header="Max. MB"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Ordner erstellen" Click="OnCreateAttachmentFolderClick"/><Button Content="Im Explorer öffnen" Click="OnOpenAttachmentFolderClick"/><Button Content="OneDrive-Ordner vorschlagen" Click="OnSuggestOneDriveClick"/></StackPanel><TextBlock Text="DMS-Arbeitsordner" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBox x:Name="WorkFolderBox" Header="Arbeitsordner"/><CheckBox x:Name="WatcherEnabledBox" Content="Automatische Verarbeitung aktiv"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Arbeitsordner erstellen" Click="OnCreateWorkFolderClick"/><Button Content="Arbeitsordner öffnen" Click="OnOpenWorkFolderClick"/><Button Content="Speichern" Click="OnSavePathsClick"/></StackPanel><Button Content="Dateinamen vereinheitlichen" HorizontalAlignment="Left" Click="OnMigrateNamesClick"/></StackPanel></ScrollViewer></TabViewItem>
   <TabViewItem Header="OCR"><ScrollViewer Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="880" HorizontalAlignment="Left" Spacing="12"><TextBlock Text="OCR" FontSize="17" FontWeight="SemiBold"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TesseractPathBox" Header="Pfad zu tesseract.exe"/><Button Grid.Column="1" Content="Durchsuchen…" VerticalAlignment="Bottom" Click="OnBrowseTesseractClick"/></Grid><TextBox x:Name="LanguagesBox" Header="Sprachen"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="OCR speichern" Click="OnSaveOcrClick"/><Button Content="Index aktualisieren" Click="OnReindexClick"/></StackPanel></StackPanel></ScrollViewer></TabViewItem>
   <TabViewItem Header="Datenbank"><ScrollViewer Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="880" HorizontalAlignment="Left" Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Datenbank" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Aktualisieren" Click="OnRefreshStatsClick"/></Grid><Grid ColumnSpacing="12" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Datenbankname"/><TextBlock x:Name="DatabaseNameText" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Datengröße"/><TextBlock x:Name="DatabaseSizeText" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="Datenlimit"/><TextBlock x:Name="DatabaseLimitText" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Dateianhänge"/><TextBlock x:Name="AttachmentCountText" Grid.Row="3" Grid.Column="1"/><TextBlock Grid.Row="4" Text="Dokumente mit Text"/><TextBlock x:Name="AttachmentTextCountText" Grid.Row="4" Grid.Column="1"/><TextBlock Grid.Row="5" Text="Textdaten"/><TextBlock x:Name="TextSizeText" Grid.Row="5" Grid.Column="1"/></Grid><ProgressBar x:Name="DatabaseUsageBar" Minimum="0" Maximum="100"/><TextBlock x:Name="DatabaseUsageText"/></StackPanel></ScrollViewer></TabViewItem>
  </TabView>
  <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
