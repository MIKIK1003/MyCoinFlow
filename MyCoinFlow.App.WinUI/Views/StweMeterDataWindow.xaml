<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow x:Class="MyCoinFlow.WinUI.Views.StweMeterDataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:window="using:MyCoinFlow.WinUI" Title="Zählerdaten">
    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Zählerstände oder Monatswerte je Erfassungszeitpunkt" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"><AppBarButton Label="Aktualisieren" Click="OnRefreshClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Neu" Click="OnNewClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Schließen" Click="OnCloseClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8BB;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
        <ListView x:Name="SetsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped"><ListView.Header><Grid Padding="10,8" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="Erfasst am" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Erfassungsart" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Monate" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Rechnung kWh" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Rückspeisung" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Gutschrift CHF" FontWeight="SemiBold"/><TextBlock Grid.Column="6" Text="Notiz" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}"/><TextBlock Grid.Column="1" Text="{Binding TypeText}"/><TextBlock Grid.Column="2" Text="{Binding MonthsText}"/><TextBlock Grid.Column="3" Text="{Binding InvoiceKwhText}"/><TextBlock Grid.Column="4" Text="{Binding FeedInText}"/><TextBlock Grid.Column="5" Text="{Binding CreditText}"/><TextBlock Grid.Column="6" Text="{Binding Note}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="True" IsClosable="True"/>
    </Grid>
</window:PersistentWindow>
