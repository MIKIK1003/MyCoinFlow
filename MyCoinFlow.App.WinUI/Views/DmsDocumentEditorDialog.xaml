<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.DmsDocumentEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Dokument organisieren">

    <Grid Padding="20,16,20,18" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource MyCoinFlowAccentSoftBrush}" CornerRadius="12" Padding="17,13">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11" Background="#CBEAE7">
                    <FontIcon Glyph="&#xE8A5;" FontSize="21" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="WindowHeadingText" Text="Dokument organisieren" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Identität, Inhalt und Arbeitsablauf sind nach Themen geordnet. Die Dokumentdatei selbst bleibt unverändert."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Background="#F4F0FA" Padding="17">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="#E3D8F5">
                            <FontIcon Glyph="&#xE8EC;" FontSize="17" Foreground="#684CB9" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dokument und Einordnung" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Datei, Titel, Art und Absender" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FilePanel" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" Header="Datei" IsReadOnly="True" />
                        <Button x:Name="SelectFileButton" Grid.Column="1" Content="Datei wählen" VerticalAlignment="Bottom" Click="OnSelectFileClick" />
                    </Grid>
                    <TextBox x:Name="TitleBox" Header="Titel" MaxLength="200"
                             PlaceholderText="Aussagekräftige Bezeichnung für Suche und Export" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <CalendarDatePicker x:Name="DocumentDatePicker" Header="Dokumentdatum" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="DocumentTypeBox" Grid.Column="1" Header="Belegart" HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryBox" Header="Kategorie" IsEditable="True" HorizontalAlignment="Stretch" />
                        <Button x:Name="DeleteCategoryButton" Grid.Column="1" Content="Löschen" VerticalAlignment="Bottom"
                                ToolTipService.ToolTip="Kategorie löschen" Click="OnDeleteCategoryClick" />
                    </Grid>
                    <ComboBox x:Name="AddressBox" Header="Adresse / Absender" DisplayMemberPath="Name"
                              SelectedValuePath="Id" HorizontalAlignment="Stretch" />

                    <Border Padding="12,10" CornerRadius="9" Background="#E3F2EE">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Foreground="#147D72" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <CheckBox x:Name="TaxDocumentBox" Content="Steuerunterlage oder Steuerbeilage" FontWeight="SemiBold" />
                                <TextBlock Text="Erscheint zusätzlich in der Steuersammlung und kann in den gemeinsamen Steuerordner kopiert werden."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Background="#EDF5FA" Padding="17">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="#D8EAF4">
                            <FontIcon Glyph="&#xE8C7;" FontSize="17" Foreground="#357999" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Inhalt und Buchungsbezug" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Beschreibung, Suchbegriffe und Betrag" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="DescriptionBox" Header="Beschreibung" PlaceholderText="Worum geht es in diesem Dokument?"
                             MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Height="190" />
                    <TextBox x:Name="KeywordsBox" Header="Schlagwörter" PlaceholderText="Mit Komma trennen" MaxLength="1000" />
                    <TextBox x:Name="AmountBox" Header="Rechnungsbetrag" PlaceholderText="z. B. 84.60" TextAlignment="Right" />

                    <Border Padding="13,11" CornerRadius="9" Background="#DCECF5">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8EC;" Foreground="#357999" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Verknüpfung und Betrag" FontWeight="SemiBold" />
                                <TextBlock x:Name="LinkInfoText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="#FFF5E8" Padding="17">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="#F7E3C5">
                            <FontIcon Glyph="&#xE823;" FontSize="17" Foreground="#B06C1F" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Workflow und Aufbewahrung" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Bearbeitung, Fristen und interne Hinweise" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkflowStatusBox" Header="Bearbeitungsstatus" HorizontalAlignment="Stretch" />
                        <TextBox x:Name="ResponsibleBox" Grid.Column="1" Header="Verantwortlich" MaxLength="128" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <CheckBox x:Name="DueActiveBox" Content="Frist setzen" Checked="OnDueChanged" Unchecked="OnDueChanged" />
                            <CalendarDatePicker x:Name="DueDatePicker" Header="Fällig am" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <CheckBox x:Name="RetainActiveBox" Content="Aufbewahren bis" Checked="OnRetainChanged" Unchecked="OnRetainChanged" />
                            <CalendarDatePicker x:Name="RetainDatePicker" Header="Aufbewahrungsende" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="12,10" CornerRadius="9" Background="#FBE9CF">
                        <StackPanel Spacing="5">
                            <CheckBox x:Name="WarrantyBox" Content="Garantieschein" Checked="OnWarrantyChanged" Unchecked="OnWarrantyChanged" />
                            <CalendarDatePicker x:Name="WarrantyDatePicker" Header="Garantie-Ablaufdatum" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="NoteBox" Header="Interne Notiz" PlaceholderText="Hinweise zur Bearbeitung oder Aufbewahrung"
                             AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="180" />
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar x:Name="InlineInfo" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <TextBlock Text="Position und Grösse werden beim Schliessen gespeichert." VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Abbrechen" HorizontalAlignment="Stretch" Click="OnCancelClick" />
            <Button Grid.Column="2" Content="Speichern" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
        </Grid>
    </Grid>
</window:PersistentWindow>
