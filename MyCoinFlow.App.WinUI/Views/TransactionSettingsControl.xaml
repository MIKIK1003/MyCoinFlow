<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.TransactionSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Transaktionen" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Schnellwahl-Konten und bestehende Lernzuordnungen" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Aktualisieren" Click="OnRefreshClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="SaveButton" Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="ImportCategoriesButton" Label="Kategorien aus Musterdatei" Visibility="Collapsed" Click="OnImportCategoriesClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8B5;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <TabView x:Name="Sections" Grid.Row="1" IsAddTabButtonVisible="False" SelectionChanged="OnTabChanged">
   <TabViewItem Header="Schnellwahl-Konten" Tag="Quick"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Die ausgewählten Konten erscheinen im Zuordnungsdialog als Schnellwahl-Buttons. Dies gilt nur für den angemeldeten Benutzer." TextWrapping="Wrap"/><ListView x:Name="QuickAccountsList" Grid.Row="1"><ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="8,5"/></DataTemplate></ListView.ItemTemplate></ListView></Grid></TabViewItem>
   <TabViewItem Header="Gelernte Zuordnungen" Tag="Learned"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Adress-Aliase" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="AliasFilterBox" Grid.Row="1" PlaceholderText="Adresse oder Text filtern" TextChanged="OnAliasFilterChanged"/><ListView x:Name="AliasesList" Grid.Row="2"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AdresseName}"/><TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Modus}"/><Button Grid.Column="3" Content="Löschen" Tag="{Binding Id}" Click="OnAliasDeleteClick"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid><Grid Grid.Column="1" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Buchungsregeln" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="RuleFilterBox" Grid.Row="1" PlaceholderText="Adresse, Muster oder Konto filtern" TextChanged="OnRuleFilterChanged"/><ListView x:Name="RulesList" Grid.Row="2"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AdresseName}"/><TextBlock Grid.Column="1" Text="{Binding TextPattern}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding KontoAnzeige}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding BelegAnzahl}"/><Button Grid.Column="4" Content="Löschen" Tag="{Binding Id}" Click="OnRuleDeleteClick"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Grid></TabViewItem>
   <TabViewItem Header="Kategorie-Konten" Tag="Categories"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Standardkonto je Kreditkarten-Kategorie. Es greift beim Kreditkarten-Import, wenn keine Adresse oder Regel zutrifft." TextWrapping="Wrap"/><ListView x:Name="CategoryAccountsList" Grid.Row="1"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Category}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}" DisplayMemberPath="Anzeige" SelectedValuePath="Id" SelectedValue="{Binding AccountId, Mode=TwoWay}" IsEditable="True"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></TabViewItem>
  </TabView>
  <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
