<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.DmsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="Dokumentenmanagement" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Dokumente finden, prüfen, verknüpfen und nachvollziehbar versionieren" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FunctionBarStyle}">
            <ScrollViewer x:Name="FunctionBarScroller" Padding="0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FunctionGroupsPanel" Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="DOKUMENTE" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <Grid x:Name="DocumentActionsGrid">
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnRefreshClick" ToolTipService.ToolTip="Dokumentenbestand aktualisieren"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="Aktualisieren" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnScanClick" ToolTipService.ToolTip="Dokument über den konfigurierten Arbeitsordner scannen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8A9;" FontSize="16" /><TextBlock Text="Scannen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button Style="{StaticResource FunctionPrimaryButtonStyle}" Click="OnUploadClick" ToolTipService.ToolTip="Neues Dokument hochladen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE898;" FontSize="16" /><TextBlock Text="Hochladen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="TaxFolderButton" Style="{StaticResource FunctionButtonStyle}" ToolTipService.ToolTip="Steuerunterlagen übertragen oder Zielordner ändern">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="Steuerordner" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel>
                                <Button.Flyout><MenuFlyout Placement="Bottom"><MenuFlyoutItem x:Name="UpdateTaxFolderMenuItem" Text="Jetzt aktualisieren" Click="OnExportTaxDocumentsClick" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Zielordner wählen oder ändern …" Click="OnSelectTaxFolderClick" /></MenuFlyout></Button.Flyout>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnHistoryClick" ToolTipService.ToolTip="DMS-Verlauf anzeigen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE81C;" FontSize="16" /><TextBlock Text="Verlauf" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                        </Grid>
                    </StackPanel>

                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />

                    <StackPanel>
                        <TextBlock Text="MARKIERTES DOKUMENT" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <Grid x:Name="SelectedDocumentActionsGrid">
                            <Button x:Name="OpenButton" Style="{StaticResource FunctionPrimaryButtonStyle}" IsEnabled="False" Click="OnOpenClick" ToolTipService.ToolTip="Markiertes Dokument öffnen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8E5;" FontSize="16" /><TextBlock Text="Öffnen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="EditButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnEditClick" ToolTipService.ToolTip="Dokument organisieren und Metadaten bearbeiten"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE70F;" FontSize="16" /><TextBlock Text="Organisieren" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="FavoriteButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnFavoriteClick"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE734;" FontSize="16" /><TextBlock x:Name="FavoriteButtonText" Text="Als Favorit" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="NewVersionButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnNewVersionClick" ToolTipService.ToolTip="Neue Dokumentversion hinzufügen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="Neue Version" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="OpenVersionButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnOpenVersionClick" ToolTipService.ToolTip="In der Dokumentakte markierte Version öffnen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE81C;" FontSize="16" /><TextBlock Text="Version öffnen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="DeleteButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick" ToolTipService.ToolTip="Dokument ins wiederherstellbare Archiv verschieben"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74D;" FontSize="16" /><TextBlock Text="Entfernen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                        </Grid>
                    </StackPanel>

                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />

                    <StackPanel>
                        <TextBlock Text="ZUORDNUNG" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <Grid x:Name="AssignmentActionsGrid">
                            <Button x:Name="AssignButton" Style="{StaticResource FunctionPrimaryButtonStyle}" IsEnabled="False" Click="OnAssignClick" ToolTipService.ToolTip="Markiertes Dokument einer Transaktion zuweisen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8EC;" FontSize="16" /><TextBlock Text="Transaktion zuweisen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="GoToTransactionButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnGoToTransactionClick" ToolTipService.ToolTip="Zur bereits verknüpften Transaktion wechseln"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72A;" FontSize="16" /><TextBlock Text="Zur Transaktion" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="UnlinkButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnUnlinkClick" ToolTipService.ToolTip="Bestehende Transaktionsverknüpfung lösen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock Text="Verknüpfung lösen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button x:Name="RetryButton" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Click="OnRetryClick" ToolTipService.ToolTip="Automatische Zuordnung für das markierte Dokument erneut suchen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="Suche erneut" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnRetryAllClick" ToolTipService.ToolTip="Automatische Zuordnung für alle Dokumente erneut suchen"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE895;" FontSize="16" /><TextBlock Text="Alle automatisch suchen" Style="{StaticResource FunctionButtonLabelStyle}" /></StackPanel></Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,14,0">
                        <TextBlock Text="ÜBERSICHT" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock x:Name="DocumentsCountText" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Dokumente" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock x:Name="NewCountText" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Neu" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock x:Name="OverdueCountText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MyCoinFlowDangerBrush}" /><TextBlock Text="Überfällig" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock x:Name="FavoritesCountText" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Favoriten" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />
                        <TextBlock Text="SUCHE UND SICHT" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="SearchBox" Header="Volltextsuche" PlaceholderText="Titel, Inhalt, Tags, Adresse …" KeyDown="OnSearchKeyDown" />
                        <ComboBox x:Name="GroupBox" Header="Gruppieren nach" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />
                        <ComboBox x:Name="CategoryBox" Header="Kategorie" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />
                        <ComboBox x:Name="StatusBox" Header="Bearbeitungsstatus" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />
                        <ToggleSwitch x:Name="FavoritesOnlyBox" Header="Schnellfilter" OffContent="Alle Dokumente" OnContent="Nur Favoriten" Toggled="OnFilterChanged" />
                        <CheckBox x:Name="OverdueOnlyBox" Content="Nur überfällige" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                        <CheckBox x:Name="UnlinkedOnlyBox" Content="Nur noch nicht verknüpfte" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                        <Button Content="Suchen" HorizontalAlignment="Stretch" Click="OnSearchClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Dokumentenbestand" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Die Gruppen lassen sich einzeln auf- und zuklappen." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <TextBlock x:Name="CounterText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border x:Name="WatcherPanel" Grid.Row="1" Margin="12,0,12,10" Padding="12,9"
                            CornerRadius="7" Background="{StaticResource MyCoinFlowAccentSoftBrush}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="18" Height="18" IsActive="True" IsIndeterminate="True" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Verarbeite: " /><Run x:Name="WatcherFileText" FontWeight="SemiBold" />
                                <Run Text=" · " /><Run x:Name="WatcherPhaseText" /><Run x:Name="WatcherQueueText" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="GroupsList" Grid.Row="2" SelectionMode="None" Padding="8,0,8,8" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0,3" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="False" HorizontalAlignment="Stretch">
                                    <Expander.Header><Grid Padding="4,2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Expander.Header>
                                    <ListView ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnDocumentSelectionChanged" DoubleTapped="OnDocumentDoubleTapped" Loaded="OnDocumentListLoaded" HorizontalContentAlignment="Stretch">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="12,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="108" /><ColumnDefinition Width="135" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><TextBlock Text="{Binding FileType}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                    <StackPanel Grid.Column="1" Spacing="2"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Favorite}" Foreground="{StaticResource MyCoinFlowAccentBrush}" /><TextBlock Text="{Binding TaxMarker}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MyCoinFlowAccentBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Text="{Binding Keywords}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Duplicate}" FontSize="11" Foreground="{StaticResource MyCoinFlowDangerBrush}" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding Date}" /><TextBlock Text="{Binding Version}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                                    <StackPanel Grid.Column="3"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding Responsible}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock Text="{Binding LinkStatus}" Foreground="{StaticResource MyCoinFlowAccentBrush}" /><TextBlock Text="{Binding Size}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <StackPanel x:Name="EmptyDetailPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="38" Opacity="0.45" HorizontalAlignment="Center" />
                        <TextBlock Text="Dokument auswählen" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Metadaten, Versionen und Aktivitäten erscheinen hier."
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="DetailPanel" Spacing="12" Padding="0,0,14,0">
                        <StackPanel><TextBlock Text="DOKUMENTAKTE" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding TitelAnzeige}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SteuerAnzeige}" FontWeight="SemiBold" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock Text="EINORDNUNG" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding BelegartAnzeige}" /><TextBlock Grid.Column="1" Text="{Binding KategorieAnzeige}" /><TextBlock Grid.Row="1" Text="{Binding BearbeitungsstatusAnzeige}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VerantwortlichAnzeige}" /></Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock Text="FRISTEN UND ZUORDNUNG" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock><Run Text="Fällig: " /><Run Text="{Binding FaelligAnzeige}" /></TextBlock>
                        <TextBlock Text="{Binding AufbewahrungAnzeige}" />
                        <TextBlock><Run Text="Verknüpft mit: " /><Run Text="{Binding VerknuepftMitAnzeige}" /></TextBlock>
                        <TextBlock><Run Text="Adresse: " /><Run Text="{Binding AdresseAnzeige}" /></TextBlock>
                        <TextBlock><Run Text="Betrag: " /><Run Text="{Binding BetragAnzeige}" /></TextBlock>
                        <TextBlock><Run Text="Garantie: " /><Run Text="{Binding GarantieAnzeige}" /></TextBlock>
                        <TextBlock Text="{Binding OcrAnzeige}" />
                        <TextBlock Text="{Binding SchlagwoerterAnzeige}" TextWrapping="Wrap" /><TextBlock Text="{Binding Beschreibung}" TextWrapping="Wrap" /><TextBlock Text="{Binding Notiz}" FontStyle="Italic" TextWrapping="Wrap" />
                        <Expander Header="Versionen" IsExpanded="True"><ListView x:Name="VersionsList" MaxHeight="220" SelectionMode="Single" SelectionChanged="OnVersionSelectionChanged" HorizontalContentAlignment="Stretch"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6,4"><TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding CreatedText}" FontSize="11" /><TextBlock Text="{Binding CommentDisplay}" FontSize="11" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                        <Expander Header="Aktivitätsprotokoll"><ListView x:Name="ActivitiesList" MaxHeight="230"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Expander>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
