<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.AccountEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kontenplan-Eintrag"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="540">
        <ScrollViewer MaxHeight="620" Style="{StaticResource FormScrollViewerStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="DialogHeading" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Kontonummer und bestehende Kontenstruktur erfassen. Die fachliche Zuordnung entspricht unverändert dem bisherigen Kontenplan."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <InfoBar x:Name="EditorError" IsOpen="False" IsClosable="True" Severity="Error" />

                <TextBox x:Name="AccountNumberBox" Header="Kontonummer" InputScope="Number" />
                <ComboBox x:Name="ArtBox" Header="Art" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="GroupBox" Header="Gruppe" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="SubgroupBox" Header="Untergruppe" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                <TextBox x:Name="DetailBox" Header="Detail" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
