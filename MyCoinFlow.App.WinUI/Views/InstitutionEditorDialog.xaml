<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.InstitutionEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Geldinstitut"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="580">
        <ScrollViewer MaxHeight="650" Style="{StaticResource FormScrollViewerStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="DialogHeading" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Bankverbindung und bestehende Anfangswerte erfassen. Salden werden weiterhin nach der bisherigen Buchungslogik berechnet."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <InfoBar x:Name="EditorError" IsOpen="False" IsClosable="True" Severity="Error" />

                <TextBox x:Name="NameBox" Header="Name*" />
                <TextBox x:Name="BicBox" Header="BIC" />
                <TextBox x:Name="IbanBox" Header="IBAN" />
                <TextBox x:Name="AccountNumberBox" Header="Kontonummer" />
                <TextBox x:Name="NoteBox" Header="Notiz" Height="92"
                         AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBox x:Name="InitialBalanceBox" Header="Anfangsbestand" InputScope="Number" />
                <DatePicker x:Name="InitialDatePicker" Header="ab Datum"
                            MinWidth="320" HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
