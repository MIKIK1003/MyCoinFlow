<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.AllocationKeyLinesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Schlüssel-Zeilen"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="760">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
            <Grid ColumnSpacing="10" Padding="8,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="EINHEIT (OPTIONAL)" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="EIGENTÜMER / FALLBACK" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="ANTEIL %" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <ListView x:Name="RowsList" SelectionMode="None" MaxHeight="430">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ElementName=RowsList, Path=DataContext.Units}" DisplayMemberPath="Bezeichnung" SelectedValuePath="Id" SelectedValue="{Binding UnitId, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ElementName=RowsList, Path=DataContext.Owners}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OwnerId, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Text="{Binding PercentageText, Mode=TwoWay}" HorizontalContentAlignment="Right" />
                            <Button Grid.Column="3" Padding="6" Click="OnDeleteRowClick" ToolTipService.ToolTip="Zeile löschen"><FontIcon Glyph="&#xE74D;" /></Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SumText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Zeile hinzufügen" Click="OnAddRowClick" />
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
