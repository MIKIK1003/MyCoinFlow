<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingTextTemplateManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Textbausteine verwalten">

    <Grid x:Name="RootGrid" Padding="24,20,24,18" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseShortcut" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveShortcut" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewShortcut" />
            <KeyboardAccelerator Key="F2" Invoked="OnEditTextShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource EditorWindowHeaderStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <FontIcon Glyph="{StaticResource ActionDocumentIconGlyph}"
                              Foreground="{StaticResource MyCoinFlowAccentBrush}" FontSize="20" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Textbausteine" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Wiederverwendbare Klartext-/Formatsnapshots für Haupt-, Zusatz- und Fusstexte"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Neuer Textbaustein"
                        VerticalAlignment="Center" Click="OnNewClick"
                        AutomationProperties.Name="Neuer Textbaustein" />
            </Grid>
        </Border>

        <InfoBar x:Name="ErrorInfoBar" Grid.Row="1" IsOpen="False"
                 IsClosable="True" Severity="Error" Title="Textbaustein konnte nicht gespeichert werden" />

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ListCard" Style="{StaticResource EditorSectionCardStyle}" Padding="0">
                <Grid>
                    <ListView x:Name="TemplatesList" SelectionMode="Single"
                              SelectionChanged="OnTemplateSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,9" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Preview}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveDisplay}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="300" Spacing="8">
                        <TextBlock Text="Noch keine Textbausteine" FontSize="18"
                                   FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="Legen Sie den ersten Baustein an. Er steht anschließend im Texteditor und im Composer bereit."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EditorCard" Grid.Column="1"
                    Style="{StaticResource EditorSectionCardStyle}">
                <ScrollViewer Style="{StaticResource FormScrollViewerStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="EditorTitle" Text="Textbaustein bearbeiten"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Bezeichnung und Inhalt bleiben mandantenbezogen. Inaktive Bausteine werden nicht mehr zur Auswahl angeboten."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="NameBox" Header="Bezeichnung *" MaxLength="160"
                                 AutomationProperties.Name="Textbaustein-Bezeichnung" />
                        <TextBox x:Name="PreviewBox" Header="Klartext"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="190" PlaceholderText="Noch kein Text erfasst" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Text im Editor öffnen" HorizontalAlignment="Stretch"
                                    Click="OnEditTextClick" AutomationProperties.Name="Text im Editor öffnen" />
                            <ToggleSwitch x:Name="ActiveToggle" Grid.Column="1"
                                          Header="Status" OnContent="Aktiv" OffContent="Inaktiv"
                                          IsOn="True" />
                        </Grid>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Snapshot"
                                 Message="Der Texteditor übernimmt nur erneut geprüfte Klartext-/RTF-Paare. Eine freie Klartextänderung außerhalb des Editors ist bewusst nicht möglich." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="LoadingOverlay" Grid.ColumnSpan="2"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Textbausteine werden geladen …" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EditorWindowFooterStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Strg+N · neu   F2 · Text bearbeiten   Strg+S · speichern   Esc · schliessen"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Schliessen" Width="140" Click="OnCloseClick" />
                    <Button x:Name="SaveButton" Content="Textbaustein speichern" Width="210"
                            Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</window:PersistentWindow>
