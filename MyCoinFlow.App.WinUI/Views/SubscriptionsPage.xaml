<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Zahlungsserien" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Wiederkehrende Einnahmen und Ausgaben, Verträge, Lizenzen und Streaming im Blick"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <AppBarButton Label="Aktualisieren" Click="OnRefreshClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="Serien suchen" Click="OnFindCandidatesClick"><AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="Neue Zahlungen" Click="OnAssignNewPaymentsClick"><AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon></AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="PDF-Bericht" Click="OnPrintClick"><AppBarButton.Icon><FontIcon Glyph="&#xE749;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="Neue Serie" Click="OnNewClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon></AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,13">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#ECE5F9"><FontIcon Glyph="&#xE768;" Foreground="#684CB9" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="ActiveCountText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Aktive Zahlungsserien" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,13">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#DDF2F2"><FontIcon Glyph="&#xE943;" Foreground="#167E91" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="AnnualCostText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Einnahmen pro Jahr" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,13">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#E7F2DF"><FontIcon Glyph="&#xE8C7;" Foreground="#477E35" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="MonthlyCostText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ausgaben pro Jahr" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,13">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#FAEBD6"><FontIcon Glyph="&#xE823;" Foreground="#B06C1F" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="DeadlineCountText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Kündigungen in 90 Tagen" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Serie, Anbieter, Richtung, Kategorie oder Notiz suchen"
                         TextChanged="OnSearchChanged" />
                <ComboBox x:Name="DirectionFilterBox" Grid.Column="1" Header="Richtung" SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="CategoryFilterBox" Grid.Column="2" Header="Serienart" SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="StatusFilterBox" Grid.Column="3" Header="Status" SelectionChanged="OnFilterChanged" />
                <TextBlock x:Name="ResultCountText" Grid.Column="4" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="390" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Padding="16,13" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Serien nach Richtung und Art" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Einnahmen zuerst, danach Ausgaben" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <TextBlock x:Name="ReviewCountText" Grid.Column="1" VerticalAlignment="Center" Foreground="#B06C1F" />
                    </Grid>
                    <ListView x:Name="SubscriptionGroupsList" Grid.Row="1" SelectionMode="None" Padding="8,0,8,8" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,3"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander x:Name="GroupExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Padding="4,3" RowSpacing="5">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="{Binding DirectionSurface}" CornerRadius="7" Padding="7,1"><TextBlock Text="{Binding Direction}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DirectionAccent}"/></Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Expander.Header>
                                    <ListView ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnSubscriptionChanged" DoubleTapped="OnDoubleTapped" Loaded="OnSubscriptionListLoaded" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CategorySurface}" CornerRadius="10" Padding="0" Margin="2" HorizontalAlignment="Stretch">
                                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Background="{Binding CategoryAccent}" CornerRadius="10,0,0,10"/>
                                                        <Grid Grid.Column="1" Margin="7,11,12,11" RowSpacing="7">
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding CategoryGlyph}" Foreground="{Binding CategoryAccent}" FontSize="15"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Provider}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="8" Padding="7,2"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusForeground}"/></Border></Grid>
                                                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><Border Background="{Binding DirectionSurface}" CornerRadius="7" Padding="6,1"><TextBlock Text="{Binding DirectionName}" FontSize="10" Foreground="{Binding DirectionAccent}"/></Border><TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{Binding CategoryAccent}" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding AnnualCost}" FontWeight="SemiBold"/></Grid>
                                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Period}" FontSize="11" Opacity="0.72"/><TextBlock Grid.Column="1" Text="{Binding CancelLine}" FontSize="11" Opacity="0.72"/></Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid x:Name="EmptyDetailPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Zahlungsserie auswählen" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Links eine Serie auswählen oder neu erfassen."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" Style="{StaticResource FormScrollViewerStyle}">
                        <StackPanel Padding="20" Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="DetailDirectionBadge" CornerRadius="9" Padding="9,3"><TextBlock x:Name="DetailDirectionText" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border x:Name="DetailCategoryBadge" CornerRadius="9" Padding="9,3"><TextBlock x:Name="DetailCategoryText" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <Border x:Name="DetailStatusBadge" CornerRadius="9" Padding="9,3"><TextBlock x:Name="DetailStatusText" FontSize="11" FontWeight="SemiBold"/></Border>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailNameText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailProviderText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                                    <AppBarButton x:Name="EditButton" Label="Bearbeiten" Click="OnEditClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="DeleteButton" Label="Löschen" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton>
                                </CommandBar>
                            </Grid>

                            <InfoBar x:Name="SelectionInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#ECE5F9" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="WERT PRO MONAT" FontSize="10" Foreground="#684CB9"/><TextBlock x:Name="DetailMonthlyText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="#DDF2F2" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="WERT PRO JAHR" FontSize="10" Foreground="#167E91"/><TextBlock x:Name="DetailAnnualText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#F6F0E6" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="BISHER TOTAL" FontSize="10" Foreground="#8A6540"/><TextBlock x:Name="DetailHistoricalTotalText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="3" Background="#E7F2DF" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="NÄCHSTE ZAHLUNG" FontSize="10" Foreground="#477E35"/><TextBlock x:Name="DetailNextText" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="4" Background="#F2EDF7" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="ZAHLUNGEN" FontSize="10" Foreground="#684CB9"/><TextBlock x:Name="DetailPaymentCountText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                            </Grid>

                            <Border Background="#FAEBD6" CornerRadius="12" Padding="16">
                                <Grid ColumnSpacing="16" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <FontIcon Grid.RowSpan="3" Glyph="&#xE823;" Foreground="#B06C1F" FontSize="24" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Vertrags- und Kündigungsplanung" FontSize="17" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Spätestens kündigen bis" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailCancelByText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Gewünschtes Vertragsende" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailEndText" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="So kündigen" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailRouteText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Content="Verwaltungsseite" Click="OnHomepageClick"/><Button Content="Kündigung recherchieren" Click="OnResearchClick"/></StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="Zahlungsrhythmus" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailPeriodText" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Letzte Zahlung" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailLastText" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Row="1"><TextBlock Text="Buchungskonto" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailAccountText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Automatische Prüfung" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailIndicatorText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="Notiz" FontSize="11" Opacity="0.7"/><TextBlock x:Name="DetailNoteText" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                            </Border>

                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                                <AppBarButton Label="Als gekündigt markieren" Click="OnCancelSubscriptionClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon></AppBarButton>
                                <AppBarButton Label="Zahlung zuordnen" Click="OnAssignPaymentClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8EC;"/></AppBarButton.Icon></AppBarButton>
                                <AppBarButton Label="Lücken füllen" Click="OnFillGapsClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8F4;"/></AppBarButton.Icon></AppBarButton>
                                <AppBarButton Label="Konten bereinigen" Click="OnCleanAccountsClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton>
                            </CommandBar>

                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <Grid MinWidth="620"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zahlungsverlauf" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="‚Einmalig‘ zählt zum bisherigen Total, aber nicht zu Rhythmus und Jahreswert." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Content="Zuordnung entfernen" Click="OnRemovePaymentClick" VerticalAlignment="Center"/></Grid>
                                </Expander.Header>
                                <ListView x:Name="PaymentsList" MinHeight="160" MaxHeight="300">
                                    <ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/><ColumnDefinition Width="105"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><TextBlock Text="Datum" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Betrag" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Zahlungsart" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Konto" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Zuordnung" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Notiz" FontWeight="SemiBold"/></Grid></ListView.Header>
                                    <ListView.ItemTemplate><DataTemplate><Grid Padding="10,7" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/><ColumnDefinition Width="105"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Date}"/><TextBlock Grid.Column="1" Text="{Binding Amount}"/><CheckBox Grid.Column="2" Content="Einmalig" IsChecked="{Binding IsOneTime, Mode=OneWay}" Tag="{Binding}" Click="OnOneTimeClick" ToolTipService.ToolTip="Zählt einmal zum historischen Total, jedoch nicht zum erwarteten Jahreswert"/><TextBlock Grid.Column="3" Text="{Binding Account}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Assignment}"/><TextBlock Grid.Column="5" Text="{Binding Note}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
