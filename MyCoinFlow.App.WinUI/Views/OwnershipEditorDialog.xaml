<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.OwnershipEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Eigentümer zuordnen"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="560">
        <StackPanel Spacing="12">
            <TextBlock Text="Eigentümer zuordnen" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
            <ComboBox x:Name="OwnerBox" Header="Eigentümer*" DisplayMemberPath="Name" SelectedValuePath="Id" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DatePicker x:Name="FromPicker" Header="Von*" MinWidth="250" HorizontalAlignment="Stretch" />
                <DatePicker x:Name="ToPicker" Grid.Column="1" Header="Bis (optional)" MinWidth="250" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Text="Von ist Pflicht. Bis kann leer bleiben (aktuell gültig)."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</ContentDialog>
