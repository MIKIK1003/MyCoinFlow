<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingArticleEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Artikel / Leistung bearbeiten">

    <Grid x:Name="RootGrid"
          Padding="24,20,24,18"
          RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCancelShortcut" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource EditorWindowHeaderStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <FontIcon Glyph="{StaticResource ActionDocumentIconGlyph}"
                              Foreground="{StaticResource MyCoinFlowAccentBrush}"
                              FontSize="20" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Artikelstammdaten" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadingText"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="* Pflichtfelder"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <InfoBar x:Name="EditorError" Grid.Row="1"
                 IsOpen="False" IsClosable="True" Severity="Error"
                 Title="Speichern nicht möglich" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource FormScrollViewerStyle}">
            <Grid x:Name="EditorContentGrid" Margin="0,4,0,8"
                  ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="BaseDataCard" Grid.RowSpan="2"
                        Style="{StaticResource EditorSectionCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Grunddaten" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Identifikation, Bezeichnung und fachliche Einordnung"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="ArticleNumberBox" Header="Artikelnummer *"
                                 MaxLength="64" AutomationProperties.Name="Artikelnummer" />
                        <TextBlock Text="Manuelle Artikelnummern werden vereinheitlicht und ohne Beachtung der Gross-/Kleinschreibung eindeutig geprüft."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="DesignationBox" Header="Bezeichnung *"
                                 MaxLength="200" AutomationProperties.Name="Bezeichnung" />
                        <TextBox x:Name="DescriptionBox" Header="Beschreibung"
                                 MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" AutomationProperties.Name="Beschreibung" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UnitBox" Header="Einheit *" MaxLength="40"
                                     PlaceholderText="z. B. Stück, Stunde, Monat" />
                            <TextBox x:Name="CategoryBox" Grid.Column="1"
                                     Header="Kategorie *" MaxLength="100" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AccountingCard" Grid.Column="1"
                        Style="{StaticResource EditorSectionCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Verkauf und Kontierung" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Preis, MWST und Standard-Ertragskonto"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <NumberBox x:Name="PriceBox" Header="Verkaufspreis in Basiswährung *"
                                   Minimum="0" SpinButtonPlacementMode="Compact" />
                        <ComboBox x:Name="VatBox" Header="MWST *"
                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="RevenueAccountBox" Header="Standard-Ertragskonto *"
                                  DisplayMemberPath="Display" SelectedValuePath="Id"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Standard-Ertragskonto" />
                        <ComboBox x:Name="ClassificationBox"
                                  Header="Rechtliche Nebenkostenklassifikation *"
                                  DisplayMemberPath="Display" SelectedValuePath="Code"
                                  HorizontalAlignment="Stretch" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Sichere Klassifikation"
                                 Message="Nur „Mögliche Mieter-Nebenkosten“ kann später in einem vollständig dokumentierten Mieter-Kontext angeboten werden. Reparaturen, Erneuerungen und nicht überwälzbare Kosten bleiben beim Eigentümer." />
                    </StackPanel>
                </Border>

                <Border x:Name="StatusCard" Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource EditorSectionCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Sortimentsstatus" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Inaktive Einträge bleiben auffindbar, stehen aber nicht für neue Positionen bereit."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ActiveToggle" Grid.Column="1"
                                      Header="Status" OnContent="Aktiv" OffContent="Inaktiv"
                                      IsOn="True" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource EditorWindowFooterStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Position und Grösse werden beim Schliessen gespeichert."
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CancelButton" Content="Abbrechen" Width="140"
                            Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Content="Speichern" Width="160"
                            Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</window:PersistentWindow>
