<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.StweTransactionSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transaktion für Set auswählen"
    PrimaryButtonText="Übernehmen"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid Width="920" MaxHeight="620" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Eine der zuletzt erfassten Transaktionen auswählen." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ListView x:Name="TransactionsList" Grid.Row="1" SelectionMode="Single" DoubleTapped="OnDoubleTapped">
            <ListView.Header>
                <Grid Padding="10,7" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Datum" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Betrag" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Adresse" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Bank" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Notiz" FontWeight="SemiBold"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate><DataTemplate><Grid Padding="10,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}"/><TextBlock Grid.Column="1" Text="{Binding AmountText}"/><TextBlock Grid.Column="2" Text="{Binding Address}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Bank}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Note}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <InfoBar x:Name="ErrorBar" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning"/>
    </Grid>
</ContentDialog>
