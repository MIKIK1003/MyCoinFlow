<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.CreditCardImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    xmlns:converters="using:MyCoinFlow.WinUI.Converters"
    Title="Kreditkarten-Import">

    <Grid x:Name="RootGrid" Padding="22,18,22,20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:DateToTextConverter x:Key="DateToText" />
            <converters:DecimalToTextConverter x:Key="DecimalToText" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Kreditkarten-Import" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Excel-Abrechnung einlesen, Zuordnungen prüfen und als Batch verbuchen"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                <AppBarButton Label="Excel wählen…" Click="OnChooseFileClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Buchen" Click="OnBookClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Batch verwerfen" Click="OnDiscardBatchClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" Foreground="{StaticResource MyCoinFlowDangerBrush}" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Batch:" VerticalAlignment="Center" />
            <ComboBox x:Name="BatchBox" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Anzeige"
                      SelectionChanged="OnBatchSelectionChanged" />
            <Button Grid.Column="2" Content="Laden" Click="OnLoadBatchClick" />
            <Button Grid.Column="3" Content="Aktualisieren" Click="OnRefreshBatchesClick" />
            <TextBlock Grid.Column="4" Text="Filter:" VerticalAlignment="Center" Margin="10,0,0,0" />
            <ComboBox x:Name="FilterBox" Grid.Column="5" SelectionChanged="OnFilterChanged" />
            <StackPanel Grid.Column="7" Spacing="4">
                <TextBlock Text="Verrechnungskonto" />
                <ComboBox x:Name="ClearingAccountBox" HorizontalAlignment="Stretch" DisplayMemberPath="Anzeige"
                          SelectionChanged="OnClearingAccountChanged" />
            </StackPanel>
            <StackPanel Grid.Column="8" Spacing="4">
                <TextBlock Text="Geldinstitut" />
                <ComboBox x:Name="InstitutionBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                          SelectionChanged="OnInstitutionChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Summe Liste:" />
                    <TextBlock x:Name="TotalText" Width="125" TextAlignment="Right" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Zugeordnet:" />
                    <TextBlock x:Name="AssignedText" Width="125" TextAlignment="Right" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Offen:" />
                    <TextBlock x:Name="OpenText" Width="125" TextAlignment="Right" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" Margin="14,0,0,0">
                    <TextBlock Text="Abrechnungssumme:" VerticalAlignment="Center" />
                    <TextBox x:Name="StatementTotalBox" Width="130" HorizontalContentAlignment="Right"
                             LostFocus="OnStatementTotalLostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" Margin="14,0,0,0">
                    <TextBlock Text="Differenz:" />
                    <TextBlock x:Name="DifferenceText" Width="125" TextAlignment="Right" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="10,9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="1.45*" MinWidth="210" />
                        <ColumnDefinition Width="1.15*" MinWidth="180" />
                        <ColumnDefinition Width="1.1*" MinWidth="170" />
                        <ColumnDefinition Width="1.1*" MinWidth="170" />
                        <ColumnDefinition Width="1.2*" MinWidth="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AKTIONEN" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="DATUM" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="BETRAG" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="DEBIT/KREDIT" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="BESCHREIBUNG" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="HÄNDLER" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="HÄNDLERKATEGORIE" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7" Text="ADRESSE" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="8" Text="KONTO" FontSize="11" FontWeight="SemiBold" />
                </Grid>

                <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,7" ColumnSpacing="8" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="142" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="1.45*" MinWidth="210" />
                                    <ColumnDefinition Width="1.15*" MinWidth="180" />
                                    <ColumnDefinition Width="1.1*" MinWidth="170" />
                                    <ColumnDefinition Width="1.1*" MinWidth="170" />
                                    <ColumnDefinition Width="1.2*" MinWidth="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Width="34" Height="34" Padding="0" Click="OnDeleteRowClick" ToolTipService.ToolTip="Zeile löschen">
                                        <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource MyCoinFlowDangerBrush}" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnAssignRowClick" ToolTipService.ToolTip="Zuordnen"
                                            Visibility="{Binding KontoId, Converter={StaticResource NullToVisibility}}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B7;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                                            <FontIcon Glyph="&#xE713;" FontSize="9" Foreground="#FF7555" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnAssignRowClick" ToolTipService.ToolTip="Zuordnung ändern"
                                            Visibility="{Binding KontoId, Converter={StaticResource NotNullToVisibility}}">
                                        <FontIcon Glyph="&#xE70F;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnWebSearchRowClick" ToolTipService.ToolTip="Buchungstext im Web recherchieren">
                                        <FontIcon Glyph="&#xE721;" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Datum, Converter={StaticResource DateToText}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Betrag, Converter={StaticResource DecimalToText}}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding DebitKredit}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Beschreibung}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Haendler}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding Kategorie}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{Binding Adresse}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{Binding Konto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="True" IsClosable="True" Severity="Informational"
                 Message="Excel-Datei wählen oder einen offenen Batch laden." />
    </Grid>
</window:PersistentWindow>
