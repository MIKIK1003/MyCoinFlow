<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.LicenseSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lizenz" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Lizenzstatus und Modulrechte" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Lizenzdatei importieren" Click="OnImportClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8B5;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="MCF1-Key speichern" Click="OnSaveKeyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <ScrollViewer Grid.Row="1" Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="850" HorizontalAlignment="Left" Spacing="14"><Border Style="{StaticResource CardBorderStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Lizenz" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LicenseInfoText" TextWrapping="Wrap"/><TextBlock Text="Aktive Module" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ModulesText" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource CardBorderStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Lizenzschlüssel" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="LicenseKeyBox" Header="MCF1-Key" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="MCF2-Lizenzen werden über eine Lizenzdatei importiert. Änderungen werden beim nächsten Start wirksam." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></StackPanel></ScrollViewer>
  <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
