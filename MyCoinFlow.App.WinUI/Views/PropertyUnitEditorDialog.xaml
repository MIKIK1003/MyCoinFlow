<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.PropertyUnitEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Einheit"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="560">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
            <TextBox x:Name="NameBox" Header="Bezeichnung*" />
            <TextBox x:Name="TypeBox" Header="Typ" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Name="MeaBox" Header="MEA (‰)" />
                <TextBox x:Name="AreaBox" Grid.Column="1" Header="Fläche (m²)" />
            </Grid>
            <TextBox x:Name="NoteBox" Header="Notiz" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
