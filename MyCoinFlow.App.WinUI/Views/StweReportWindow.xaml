<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow x:Class="MyCoinFlow.WinUI.Views.StweReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:window="using:MyCoinFlow.WinUI" Title="Auswertung – Eigentümer">
    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Summen und aufgeteilte Positionen pro Eigentümer" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"><AppBarButton Label="Aktualisieren" Click="OnRefreshClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Drucken" Click="OnPrintClick"><AppBarButton.Icon><FontIcon Glyph="&#xE749;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Schließen" Click="OnCloseClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8BB;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Datum von" VerticalAlignment="Center"/><CalendarDatePicker x:Name="FromPicker" Grid.Column="1"/><TextBlock Grid.Column="2" Text="Datum bis" VerticalAlignment="Center"/><CalendarDatePicker x:Name="ToPicker" Grid.Column="3"/><TextBlock x:Name="PeriodText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>
        <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Summen pro Eigentümer" FontWeight="SemiBold" Margin="14,12"/><ListView x:Name="OwnersList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnOwnerChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding TotalText}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DetailsHeadingText" Text="Details" FontWeight="SemiBold" Margin="14,12"/><ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="None"><ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><TextBlock Text="Datum" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Titel" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Schlüssel" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Betrag" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Notiz" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Key}"/><TextBlock Grid.Column="3" Text="{Binding AmountText}"/><TextBlock Grid.Column="4" Text="{Binding Note}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True"/>
    </Grid>
</window:PersistentWindow>
