<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.AddressesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyCoinFlow.WinUI.Converters"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Adressen" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Kontakte, Bankverbindungen und Standard-Einnahmenkonten verwalten"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="False" VerticalAlignment="Center">
                <AppBarButton Label="Aktualisieren" Click="OnRefreshClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Neu" Click="OnNewClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False"
                              Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Header="Suche"
                         PlaceholderText="Name, PLZ/Ort, IBAN, Typ oder Notiz …"
                         KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1" Content="Suchen" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Bottom" Click="OnSearchClick">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Grid.Column="2" Content="Leeren" VerticalAlignment="Bottom" Click="OnClearSearchClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Doppelklick öffnet die Transaktionen"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.45*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME / TYP" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="ANSCHRIFT" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="IBAN" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="NOTIZ" FontSize="11" FontWeight="SemiBold" />
                </Grid>

                <ListView x:Name="AddressesList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnAddressSelectionChanged"
                          DoubleTapped="OnAddressDoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1.45*" />
                                </Grid.ColumnDefinitions>
                                <Button Padding="6" ToolTipService.ToolTip="Transaktionen dieser Adresse anzeigen"
                                        Click="OnOpenTransactionsClick">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                </Button>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Background="{StaticResource MyCoinFlowAccentSoftBrush}" CornerRadius="8" Padding="6,1"
                                                Visibility="{Binding Address.IstBudgetiert, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Budgetiert" FontSize="10" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StreetText}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Street}" />
                                    <TextBlock Text="{Binding LocationText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding IbanText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Iban}" />
                                <TextBlock Grid.Column="4" Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Note}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="BusyRing" Grid.RowSpan="2" Width="42" Height="42"
                              IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
