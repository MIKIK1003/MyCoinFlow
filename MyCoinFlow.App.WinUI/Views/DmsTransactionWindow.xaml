<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.DmsTransactionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Transaktion zuweisen">

    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="Transaktion zuweisen" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="HintText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="14,11" CornerRadius="8"
                Background="{StaticResource MyCoinFlowAccentSoftBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="ZU VERKNÜPFENDES DOKUMENT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                    <TextBlock x:Name="DocumentTitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DocumentFileText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DocumentFactsText" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="OpenDocumentButton" Grid.Column="1" Content="Dokument öffnen"
                        VerticalAlignment="Center" Click="OnOpenDocumentClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AmountBox" Header="Betrag" KeyDown="OnSearchKeyDown" />
            <CalendarDatePicker x:Name="FromPicker" Grid.Column="1" Header="Von" />
            <CalendarDatePicker x:Name="ToPicker" Grid.Column="2" Header="Bis" />
            <TextBox x:Name="SearchBox" Grid.Column="3" Header="Adresse, Bank, Notiz…"
                     KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="4" Content="Suchen" VerticalAlignment="Bottom" Click="OnSearchClick" />
        </Grid>

        <CheckBox x:Name="IncludeLinkedBox" Grid.Row="3"
                  Content="Auch bereits verknüpfte Transaktionen anzeigen (z. B. Sammelbuchung mit mehreren Rechnungen)"
                  Checked="OnIncludeLinkedChanged" Unchecked="OnIncludeLinkedChanged" />

        <InfoBar x:Name="MessageBar" Grid.Row="4" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="12,9" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NR." FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="DATUM" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="BETRAG" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="ADRESSE / BANK" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="NOTIZ" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="CandidatesList" Grid.Row="1" SelectionMode="Single"
                          DoubleTapped="OnCandidateDoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Date}" />
                                <TextBlock Grid.Column="2" Text="{Binding Amount}" />
                                <TextBlock Grid.Column="3" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Keine Zuordnung" Click="OnCancelClick" />
            <Button Content="Zuweisen" Style="{StaticResource AccentButtonStyle}" Click="OnAssignClick" />
        </StackPanel>
    </Grid>
</window:PersistentWindow>
