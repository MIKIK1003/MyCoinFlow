<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.AllocationKeyEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Schlüssel"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="520">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
            <TextBox x:Name="NameBox" Header="Name*" />
            <ComboBox x:Name="ModeBox" Header="Modus" SelectedValuePath="Tag">
                <ComboBoxItem Content="Fix % (manuell)" Tag="FIX" />
                <ComboBoxItem Content="MEA (automatisch)" Tag="MEA" />
                <ComboBoxItem Content="Energie (zählerbasiert)" Tag="ENERGIE" />
            </ComboBox>
        </StackPanel>
    </Grid>
</ContentDialog>
