<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.BudgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Budget" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Budgetzeiträume verwalten und Budgetwerte pro Konto erfassen"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="False" VerticalAlignment="Center">
                <AppBarButton Label="Aktualisieren" Click="OnRefreshClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Zeitraum hinzufügen" Click="OnNewClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False"
                              Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ValuesButton" Label="Budget erfassen" IsEnabled="False" Click="OnValuesClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE9D2;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="ResultText"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BEZEICHNUNG" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="STARTDATUM" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="ENDDATUM" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="PeriodsList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,7" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" MinHeight="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StartText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding EndText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding ActiveText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="BusyRing" Grid.RowSpan="2" Width="42" Height="42"
                              IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
