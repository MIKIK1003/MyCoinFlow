<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingPaymentAssignmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="CAMT-Zahlung zuordnen">

    <Grid x:Name="RootGrid" Padding="24,20,24,20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="CAMT-Zahlung zuordnen" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Treffer prüfen, offene Rechnung wählen und Zahlung atomar verbuchen"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnRefreshClick" Style="{StaticResource FunctionButtonStyle}"
                    AutomationProperties.Name="Treffer aktualisieren">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="{StaticResource ActionRefreshIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Treffer aktualisieren" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource EditorSectionCardStyle}" Padding="16">
            <Grid ColumnSpacing="18" RowSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="BETRAG" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="AmountText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="BUCHUNGSDATUM" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="DateText" Grid.Column="3" />
                <TextBlock Grid.Row="1" Text="REFERENZ" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="ReferenceText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ZIELKONTO" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="AccountText" Grid.Row="1" Grid.Column="3" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="GEGENPARTEI" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="CounterpartyText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="MITTEILUNG" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <TextBlock x:Name="NarrativeText" Grid.Row="2" Grid.Column="3" TextWrapping="Wrap"
                           MaxLines="3" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="Zuordnungsstatus" />

        <Border Grid.Row="3" Style="{StaticResource EditorSectionCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="OFFENE RECHNUNGEN" Margin="16,13,16,8"
                           Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                <ListView x:Name="CandidatesList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnCandidateSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="14" MinHeight="68">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.3*" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PaymentReference}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding AmountDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DueDisplay}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ProposalDisplay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateDisplay}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ClarificationTextBox" Header="Notiz für den Klärbestand"
                     PlaceholderText="z. B. Referenz unklar; Rückfrage beim Zahler"
                     MaxLength="500" TextWrapping="Wrap" />
            <Button x:Name="ClarificationButton" Grid.Column="1" VerticalAlignment="Bottom"
                    Click="OnClarificationClick" Style="{StaticResource FunctionButtonStyle}"
                    AutomationProperties.Name="In den Klärbestand übernehmen">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="{StaticResource ActionMessageIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Klärbestand" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                </StackPanel>
            </Button>
            <Button x:Name="BookButton" Grid.Column="2" VerticalAlignment="Bottom"
                    IsEnabled="False" Click="OnBookClick" Style="{StaticResource FunctionPrimaryButtonStyle}"
                    AutomationProperties.Name="Zahlung verbuchen">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="{StaticResource ActionForwardIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Zahlung verbuchen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Schliessen"
                    Click="OnCloseClick" Style="{StaticResource FunctionButtonStyle}" />
        </Grid>
    </Grid>
</window:PersistentWindow>
