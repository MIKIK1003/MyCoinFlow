<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.PropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Liegenschaften" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Einheiten, Eigentum, Verteilschlüssel und Zähler im gemeinsamen Kontext verwalten"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnRefreshClick" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock Text="Aktualisieren" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Der Liegenschaftskontext bleibt für alle darunterliegenden Beziehungen sichtbar. -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" MaxWidth="520" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Liegenschaft" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="PropertyBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id"
                          HorizontalAlignment="Stretch" SelectionChanged="OnPropertyChanged" />
                <TextBlock x:Name="PropertyAddressText" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <CommandBar Grid.Column="3" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                    <AppBarButton Label="Neu" Click="OnNewPropertyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton x:Name="EditPropertyButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditPropertyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton x:Name="DeletePropertyButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeletePropertyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon></AppBarButton>
                </CommandBar>
            </Grid>
        </Border>

        <!-- Sichtbare Beziehungskette: die Auswahl links bestimmt unmittelbar den Inhalt rechts. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Liegenschaft" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PropertyContextTitle" FontWeight="SemiBold" Text="Keine Auswahl" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PropertyContextSubtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <FontIcon Grid.Column="1" Glyph="&#xE72A;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Grid.Column="2" CornerRadius="8" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Ausgewählte Einheit" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="UnitContextTitle" FontWeight="SemiBold" Text="Keine Auswahl" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UnitContextSubtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <FontIcon Grid.Column="3" Glyph="&#xE72A;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Grid.Column="4" CornerRadius="8" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Wirksame Eigentumszuordnung" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="OwnershipContextTitle" FontWeight="SemiBold" Text="Keine Einheit ausgewählt" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OwnershipContextSubtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Rechter Abstand ist der verbindliche Scrollbar-Gutter. -->
            <StackPanel Spacing="14" Margin="0,0,18,0">
                <!-- Einheit und ihre Zuordnungen sind absichtlich eine gemeinsame Arbeitsfläche. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" MinWidth="360" />
                            <ColumnDefinition Width="1.15*" MinWidth="400" />
                        </Grid.ColumnDefinitions>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Einheiten" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UnitsCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False">
                                    <AppBarButton x:Name="NewUnitButton" Label="Einheit hinzufügen" Click="OnNewUnitClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="EditUnitButton" Label="Einheit bearbeiten" IsEnabled="False" Click="OnEditUnitClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="DeleteUnitButton" Label="Einheit löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteUnitClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon></AppBarButton>
                                </CommandBar>
                            </Grid>
                            <ListView x:Name="UnitsList" Grid.Row="1" Height="235" SelectionMode="Single" SelectionChanged="OnUnitSelectionChanged">
                                <ListView.Header>
                                    <Grid Padding="8,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bezeichnung" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Typ" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="MEA ‰" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="m²" FontWeight="SemiBold"/>
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Type}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Mea}" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding Area}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Eigentumszuordnungen der ausgewählten Einheit" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OwnershipsCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Zuerst links eine Einheit auswählen" />
                                </StackPanel>
                                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False">
                                    <AppBarButton x:Name="NewOwnershipButton" Label="Eigentümer zuordnen" IsEnabled="False" Click="OnNewOwnershipClick"><AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="EditOwnershipButton" Label="Zuordnung bearbeiten" IsEnabled="False" Click="OnEditOwnershipClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="DeleteOwnershipButton" Label="Zuordnung löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteOwnershipClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon></AppBarButton>
                                </CommandBar>
                            </Grid>
                            <ListView x:Name="OwnershipsList" Grid.Row="1" Height="235" SelectionMode="Single" SelectionChanged="OnRelatedSelectionChanged">
                                <ListView.Header>
                                    <Grid Padding="8,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Eigentümer" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Von" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Bis" FontWeight="SemiBold"/></Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Owner}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding From}"/><TextBlock Grid.Column="2" Text="{Binding To}"/></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Eigentümerstamm" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="OwnersCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,8,0,0">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <CommandBar HorizontalAlignment="Right" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                                <AppBarButton Label="Erfassen" Click="OnNewOwnerClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon></AppBarButton>
                                <AppBarButton x:Name="EditOwnerButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditOwnerClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon></AppBarButton>
                                <AppBarButton x:Name="DeleteOwnerButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteOwnerClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon></AppBarButton>
                            </CommandBar>
                            <ListView x:Name="OwnersList" Grid.Row="1" Height="210" SelectionMode="Single" SelectionChanged="OnRelatedSelectionChanged">
                                <ListView.Header><Grid Padding="8,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><TextBlock Text="Name" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="E-Mail" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Telefon" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Notiz" FontWeight="SemiBold"/></Grid></ListView.Header>
                                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Email}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Phone}"/><TextBlock Grid.Column="3" Text="{Binding Note}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Expander>

                <!-- Schlüssel und Zähler bleiben nebeneinander, weil Zähler auf Schlüssel verweisen können. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="350"/><ColumnDefinition Width="1.25*" MinWidth="470"/></Grid.ColumnDefinitions>
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Verteilschlüssel" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="KeysCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False">
                                    <AppBarButton x:Name="NewKeyButton" Label="Schlüssel neu" Click="OnNewKeyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="EditKeyButton" Label="Umbenennen" IsEnabled="False" Click="OnEditKeyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8AC;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="KeyLinesButton" Label="Zeilen bearbeiten" IsEnabled="False" Click="OnKeyLinesClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8FD;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="DeleteKeyButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteKeyClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton>
                                </CommandBar>
                            </Grid>
                            <TextBlock x:Name="KeyRelationshipText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <ListView x:Name="KeysList" Grid.Row="2" Height="230" SelectionMode="Single" SelectionChanged="OnRelatedSelectionChanged">
                                <ListView.Header><Grid Padding="8,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Bezeichnung" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Modus" FontWeight="SemiBold"/></Grid></ListView.Header>
                                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Mode}"/></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Zähler" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="MetersCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False">
                                    <AppBarButton x:Name="NewMeterButton" Label="Zähler neu" Click="OnNewMeterClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="EditMeterButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditMeterClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon></AppBarButton>
                                    <AppBarButton x:Name="DeleteMeterButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteMeterClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton>
                                </CommandBar>
                            </Grid>
                            <TextBlock x:Name="MeterRelationshipText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <ListView x:Name="MetersList" Grid.Row="2" Height="230" SelectionMode="Single" SelectionChanged="OnRelatedSelectionChanged">
                                <ListView.Header><Grid Padding="8,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><TextBlock Text="Zähler" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Typ" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Einheit" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Schlüssel" FontWeight="SemiBold"/></Grid></ListView.Header>
                                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Type}"/><TextBlock Grid.Column="2" Text="{Binding Unit}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding AllocationKey}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
