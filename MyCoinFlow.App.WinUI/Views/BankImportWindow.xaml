<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.BankImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    xmlns:converters="using:MyCoinFlow.WinUI.Converters"
    Title="Bankimport (CAMT)">

    <Grid x:Name="RootGrid" Padding="22,18,22,20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <converters:DateToTextConverter x:Key="DateToText" />
            <converters:DecimalToTextConverter x:Key="DecimalToText" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Bankimport (CAMT)" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="CAMT-Datei prüfen, in die Importablage speichern und anschließend verbuchen"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                <AppBarButton Label="CAMT" Click="OnOpenCamtClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Leeren" Click="OnClearClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Speichern" Click="OnSaveClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Laden" Click="OnLoadClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Bulk" Click="OnBulkClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" />
            <CheckBox x:Name="IncompleteOnlyCheck" Grid.Column="1" Content="Nur unvollständige anzeigen"
                      Click="OnIncompleteOnlyClick" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="10,9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="184" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="1.2*" MinWidth="190" />
                        <ColumnDefinition Width="1.25*" MinWidth="210" />
                        <ColumnDefinition Width="1.25*" MinWidth="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AKTIONEN" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="VALUTA" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="BETRAG" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="RICHTUNG" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="GEGENPARTEI" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="KONTO (NACH)" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="KONTO (VON)" FontSize="11" FontWeight="SemiBold" />
                </Grid>

                <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,7" ColumnSpacing="8" MinHeight="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="184" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="1.2*" MinWidth="190" />
                                    <ColumnDefinition Width="1.25*" MinWidth="210" />
                                    <ColumnDefinition Width="1.25*" MinWidth="210" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Width="34" Height="34" Padding="0" Click="OnAssignRowClick"
                                            Visibility="{Binding IstVollstaendig, Converter={StaticResource BoolToVisibility}}"
                                            ToolTipService.ToolTip="Zuordnung bearbeiten">
                                        <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource MyCoinFlowPositiveBrush}" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnBookRowClick"
                                            Visibility="{Binding StagingId, Converter={StaticResource NotNullToVisibility}}"
                                            IsEnabled="{Binding IstVollstaendig}"
                                            ToolTipService.ToolTip="Diese Buchung sofort übernehmen">
                                        <FontIcon Glyph="&#xE768;" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnAssignRowClick"
                                            Visibility="{Binding IstVollstaendig, Converter={StaticResource InverseBoolToVisibility}}"
                                            ToolTipService.ToolTip="Transaktion anlernen">
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Click="OnDeleteRowClick"
                                            ToolTipService.ToolTip="Zeile löschen">
                                        <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource MyCoinFlowDangerBrush}" />
                                    </Button>
                                    <FontIcon Glyph="&#xE735;" Foreground="{StaticResource MyCoinFlowAccentBrush}"
                                              Visibility="{Binding IstSonderregelTreffer, Converter={StaticResource BoolToVisibility}}"
                                              ToolTipService.ToolTip="Treffer über Sonderregel" />
                                    <FontIcon Glyph="&#xE7BA;" Foreground="#D97706"
                                              Visibility="{Binding IstUnsichereRegel, Converter={StaticResource BoolToVisibility}}"
                                              ToolTipService.ToolTip="Unsichere Zuordnung: überlappende Regeln – bitte prüfen" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding ValueDate, Converter={StaticResource DateToText}, ConverterParameter=yyyy-MM-dd}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Amount, Converter={StaticResource DecimalToText}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding RichtungText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CounterpartyName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Text}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NachKontoLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding VorschlagNachKontoId}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VonKontoLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding VorschlagVonKontoId}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="CountText" Grid.Column="1" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</window:PersistentWindow>
