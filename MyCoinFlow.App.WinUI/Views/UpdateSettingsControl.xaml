<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.UpdateSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Update" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Version prüfen, sichern und bestehendes Setup starten" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Suchen" Click="OnCheckClick"><AppBarButton.Icon><FontIcon Glyph="&#xE721;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Sichern" Click="OnBackupClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="UpdateButton" Label="Updaten" IsEnabled="False" Click="OnUpdateClick"><AppBarButton.Icon><FontIcon Glyph="&#xE895;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <ScrollViewer Grid.Row="1" Style="{StaticResource FormScrollViewerStyle}"><StackPanel MaxWidth="850" HorizontalAlignment="Left" Spacing="14"><Border Style="{StaticResource CardBorderStyle}" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Update-Quelle" FontSize="17" FontWeight="SemiBold"/><RadioButton x:Name="LocalModeButton" Content="Lokal (OneDrive)" GroupName="UpdateMode" IsChecked="True"/><RadioButton Content="Online" GroupName="UpdateMode"/></StackPanel></Border><Border Style="{StaticResource CardBorderStyle}" Padding="16"><Grid ColumnSpacing="18" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Installierte Version"/><TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Verfügbare Version"/><TextBlock x:Name="AvailableVersionText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Text="Release Notes"/><TextBlock x:Name="NotesText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/></Grid></Border><ProgressBar x:Name="DownloadProgress" Visibility="Collapsed"/></StackPanel></ScrollViewer>
  <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
