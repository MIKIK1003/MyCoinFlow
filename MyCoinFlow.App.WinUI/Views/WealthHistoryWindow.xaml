<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.WealthHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Kursverlauf">

    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="250" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubheadingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ComboBox x:Name="PeriodBox" Grid.Column="1" Width="150" Header="Zeitraum" Margin="0,0,14,0" SelectionChanged="OnPeriodSelectionChanged" />
            <CommandBar Grid.Column="2" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                <AppBarButton Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton x:Name="UpdateButton" Label="Auswahl aktualisieren" IsEnabled="False" Click="OnUpdateClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Auswahl löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="Schließen" Click="OnCloseClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8BB;" /></AppBarButton.Icon></AppBarButton>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Kursentwicklung" Style="{StaticResource SectionTitleStyle}" />
                <Canvas x:Name="PriceHistoryCanvas" Grid.Row="1" Background="Transparent" SizeChanged="OnPriceHistorySizeChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Kursdatum" VerticalAlignment="Center" />
                <CalendarDatePicker x:Name="DatePicker" Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="Kurs" VerticalAlignment="Center" />
                <TextBox x:Name="PriceBox" Grid.Column="3" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Manuelle Kurse werden in derselben Historie wie Import- und API-Kurse geführt." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <ListView x:Name="HistoryList" Grid.Row="3" SelectionChanged="OnSelectionChanged">
            <ListView.Header>
                <Grid Padding="10,8" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition x:Name="FxHeaderColumn" Width="120" />
                        <ColumnDefinition x:Name="ChfHeaderColumn" Width="120" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kursdatum" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Kurs" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="FX → CHF" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Kurs CHF" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Quelle" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Erfasst am" FontWeight="SemiBold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="{Binding FxColumnWidth}" />
                            <ColumnDefinition Width="{Binding FxColumnWidth}" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding KursDatumText}" />
                        <TextBlock Grid.Column="1" Text="{Binding KursText}" />
                        <TextBlock Grid.Column="2" Text="{Binding FxKursText}" />
                        <TextBlock Grid.Column="3" Text="{Binding KursChfText}" />
                        <TextBlock Grid.Column="4" Text="{Binding Quelle}" />
                        <TextBlock Grid.Column="5" Text="{Binding ErfasstAmText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" />
    </Grid>
</window:PersistentWindow>
