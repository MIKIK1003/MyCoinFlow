<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.BookingAssignmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Buchung zuordnen">

    <Grid x:Name="RootGrid" Padding="20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="BookingInfoText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="BookingText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" ToolTipService.ToolTip="Buchungstext im Web recherchieren" Click="OnWebClick">
                        <FontIcon Glyph="&#xE721;" />
                    </Button>
                </Grid>
            </Border>

            <InfoBar x:Name="BudgetHintBar" IsClosable="False" Severity="Warning" IsOpen="False" />

            <Border Style="{StaticResource CardBorderStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource MyCoinFlowAccentSoftBrush}">
                        <FontIcon x:Name="BookingTypeIcon" Glyph="&#xE8AB;" FontSize="22" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="BookingTypeText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="BookingTypeHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource FormScrollViewerStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Adresse" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="NewAddressCheck" Content="Neue Adresse anlegen" Click="OnInputChanged" />
                            <CheckBox x:Name="BudgetIncomeCheck"
                                      Content="Budgetierte Einnahme (zusätzliches Einnahmen-Leg erzeugen/aktualisieren)"
                                      Click="OnInputChanged" />

                            <StackPanel x:Name="ExistingAddressPanel" Spacing="5">
                                <TextBlock Text="Bestehende Adresse" />
                                <ComboBox x:Name="AddressBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                          SelectionChanged="OnAddressChanged" />
                            </StackPanel>

                            <StackPanel x:Name="NewAddressPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="NewAddressNameBox" Header="Name" TextChanged="OnInputTextChanged" />
                                <TextBox x:Name="NewAddressIbanBox" Header="IBAN (optional)" TextChanged="OnInputTextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE825;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                            <TextBlock Text="Geldinstitut" FontWeight="SemiBold" />
                            <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InstitutionInfoText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Standardkonto" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Dieses Konto wird – je nach Regel – als Nach-Konto (Einnahme/Ausgabe) oder als Von-Konto (Refund) verwendet."
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <AutoSuggestBox x:Name="AccountBox" Header="Konto suchen oder auswählen"
                                            PlaceholderText="Enthaltener Text, z. B. Hausha"
                                            TextMemberPath="Anzeige"
                                            TextChanged="OnAccountTextChanged"
                                            SuggestionChosen="OnAccountSuggestionChosen">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Anzeige}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Anzeige}" />
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                            <TextBlock Text="Freitext filtert nach enthaltenem Text. Zum Übernehmen das gewünschte Konto aus der Trefferliste wählen."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="QuickChoiceCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Schnellwahl" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="QuickAccountList" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Id}"
                                                Click="OnQuickAccountClick"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <TextBlock Text="{Binding Anzeige}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding Anzeige}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" MaxWidth="520" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Übernehmen" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</window:PersistentWindow>
