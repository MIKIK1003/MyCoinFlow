<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingDeliveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="E-Mail und DMS">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendShortcut" />
            <KeyboardAccelerator Key="F5" Invoked="OnReloadShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource EditorWindowHeaderStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="HeaderTitleText" Text="E-Mail und DMS"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="PDF versenden, Beilagen wählen und Ablage nachweisen"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="AP09 · Versand" />
                </Border>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" Margin="16,10,16,0"
                 IsOpen="False" IsClosable="True" />

        <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="2" Margin="16,10,16,10"
                      Style="{StaticResource FormScrollViewerStyle}">
            <StackPanel Spacing="12" Padding="0,0,0,8">
                <Border Style="{StaticResource EditorSectionCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Per E-Mail senden" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="PdfStatusText"
                                       Text="Der reproduzierbare PDF-Stand wird geprüft."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <InfoBar x:Name="SmtpInfoBar" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="SMTP-Konfiguration" />
                        <TextBox x:Name="RecipientBox" Header="Empfängeradresse"
                                 InputScope="EmailSmtpAddress"
                                 TextChanged="OnDeliveryInputChanged" />
                        <TextBox x:Name="SubjectBox" Header="Betreff" MaxLength="300"
                                 TextChanged="OnDeliveryInputChanged" />
                        <TextBox x:Name="BodyBox" Header="Nachricht"
                                 MinHeight="150" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 TextChanged="OnDeliveryInputChanged" />
                        <CheckBox x:Name="RecipientConfirmedBox"
                                  Content="Empfängeradresse und ausgewählte Beilagen sind geprüft"
                                  Checked="OnDeliveryInputChanged"
                                  Unchecked="OnDeliveryInputChanged" />
                        <CheckBox x:Name="RememberRecipientBox"
                                  Content="Rechnungs-E-Mail für weitere Dokumente dieser Adresse merken" />
                        <TextBlock x:Name="AttachmentSummaryText"
                                   Text="Die Dokument-PDF wird immer angehängt."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorSectionCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="DMS-Ablage und Beilagen"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="DmsHelpText"
                                           Text="Dokumentbezogene DMS-Dateien können als zusätzliche Beilage gewählt werden."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ArchivePdfButton" Grid.Column="1"
                                    Content="PDF im DMS ablegen"
                                    Click="OnArchivePdfClick" />
                            <Button x:Name="AddAttachmentButton" Grid.Column="2"
                                    Content="Beilage hinzufügen"
                                    Click="OnAddAttachmentClick" />
                        </Grid>
                        <ListView x:Name="DmsAttachmentList" MinHeight="90" MaxHeight="240"
                                  SelectionMode="Multiple"
                                  SelectionChanged="OnDmsSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Details}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalName}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="260" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyDmsPanel" Spacing="3" HorizontalAlignment="Center"
                                    Margin="0,8">
                            <TextBlock Text="Noch keine dokumentbezogenen DMS-Dateien"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Die PDF kann abgelegt oder eine PDF-/Bildbeilage hinzugefügt werden."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorSectionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Versandnachweise" Style="{StaticResource SectionTitleStyle}" />
                        <ListView x:Name="AttemptList" MinHeight="80" MaxHeight="220"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,5" Spacing="2">
                                        <TextBlock Text="{Binding AttemptDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyAttemptText" Text="Noch kein Versandversuch vorhanden."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource EditorWindowFooterStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
                    <TextBlock x:Name="FooterStatusText" Text="Daten werden geladen …"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Neu laden" Click="OnReloadClick" />
                    <Button Content="Schließen" Click="OnCloseClick" />
                    <Button x:Name="SendButton" Content="Per E-Mail senden"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False" Click="OnSendClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</window:PersistentWindow>
