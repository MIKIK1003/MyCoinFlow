<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyCoinFlow.WinUI.Views.HouseholdPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Enabled">
 <Grid Padding="28,22,28,24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Haushalt" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Standorte, Räume, Objekte und wiederkehrende Aufgaben" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"><AppBarButton Label="Aktualisieren" Click="OnRefreshClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="NewButton" Label="Neu" Click="OnNewClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick"><AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Standort" VerticalAlignment="Center"/><ComboBox x:Name="LocationFilterBox" Grid.Column="1" DisplayMemberPath="Bezeichnung" SelectionChanged="OnLocationFilterChanged"/><TextBlock Grid.Column="2" Text="Raum" VerticalAlignment="Center"/><ComboBox x:Name="RoomFilterBox" Grid.Column="3" DisplayMemberPath="Bezeichnung" SelectionChanged="OnRoomFilterChanged"/><TextBlock x:Name="ResultText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Grid.Column="5" Content="Aufgaben aktualisieren" Click="OnUpdateTasksClick"/><Button Grid.Column="6" Content="Aufgabe erledigen" Click="OnCompleteTaskClick"/></Grid></Border>
  <TabView x:Name="Sections" Grid.Row="2" IsAddTabButtonVisible="False" SelectionChanged="OnSectionChanged">
   <TabViewItem x:Name="TasksTab" Header="Aufgaben" Tag="Tasks">
    <ListView x:Name="TasksList" SelectionMode="Single" SelectionChanged="OnListSelectionChanged">
     <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="334" ItemHeight="190"/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate>
      <Border Width="324" Height="180" Padding="16" CornerRadius="14" Background="{Binding TileBrush}">
       <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Foreground="{Binding TextBrush}" FontSize="12" Opacity="0.75"/>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="5">
         <TextBlock Text="{Binding Title}" Foreground="{Binding TextBrush}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
         <TextBlock Text="{Binding ObjectName}" Foreground="{Binding TextBrush}" FontSize="13" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="16">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Aktiv ab" Foreground="{Binding TextBrush}" FontSize="11" Opacity="0.65"/><TextBlock Text="{Binding ActivationDateText}" Foreground="{Binding TextBrush}" FontWeight="SemiBold"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="Fällig" Foreground="{Binding TextBrush}" FontSize="11" Opacity="0.65"/><TextBlock Text="{Binding DueDateText}" Foreground="{Binding TextBrush}" FontWeight="SemiBold"/></StackPanel>
         <Button Grid.Column="2" Width="38" Height="38" Padding="0" Tag="{Binding Value}" Click="OnCompleteTaskTileClick" ToolTipService.ToolTip="Aufgabe erledigen"><FontIcon Glyph="&#xE73E;" Foreground="{Binding AccentBrush}"/></Button>
        </Grid>
       </Grid>
      </Border>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </TabViewItem>
   <TabViewItem Header="Standorte" Tag="Locations"><ListView x:Name="LocationsList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding IconKey}"/><TextBlock Grid.Column="2" Text="{Binding FarbeKey}"/><TextBlock Grid.Column="3" Text="{Binding Bemerkung}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
   <TabViewItem Header="Räume" Tag="Rooms"><ListView x:Name="RoomsList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StandortBezeichnung}"/><TextBlock Grid.Column="2" Text="{Binding IconKey}"/><TextBlock Grid.Column="3" Text="{Binding Bemerkung}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
   <TabViewItem Header="Objekte" Tag="Objects"><ListView x:Name="ObjectsList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding RaumBezeichnung}"/><TextBlock Grid.Column="2" Text="{Binding KategorieBezeichnung}"/><TextBlock Grid.Column="3" Text="{Binding ArbeitsanweisungBezeichnung}"/><TextBlock Grid.Column="4" Text="{Binding ZeitintervallBezeichnung}"/><TextBlock Grid.Column="5" Text="{Binding VorlaufTage}"/><TextBlock Grid.Column="6" Text="{Binding Bemerkung}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
   <TabViewItem Header="Kategorien" Tag="Categories"><ListView x:Name="CategoriesList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding IconKey}"/><TextBlock Grid.Column="2" Text="{Binding Bemerkung}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
   <TabViewItem Header="Tätigkeiten" Tag="Instructions"><ListView x:Name="InstructionsList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding IconKey}"/><TextBlock Grid.Column="2" Text="{Binding Beschreibung}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
   <TabViewItem Header="Zeitintervalle" Tag="Intervals"><ListView x:Name="IntervalsList" SelectionChanged="OnListSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Tage}"/><TextBlock Grid.Column="2" Text="{Binding Bemerkung}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
  </TabView>
  <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True"/>
 </Grid>
</Page>
