<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.NumberRangesSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nummernkreise" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Kontobereiche, Richtung und Budgetrelevanz" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Neu" Click="OnNewClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Löschen" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Neu laden" Click="OnReloadClick"><AppBarButton.Icon><FontIcon Glyph="&#xE72C;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><NumberBox x:Name="StartBox" Header="Von (Nr.)" SpinButtonPlacementMode="Compact"/><NumberBox x:Name="EndBox" Grid.Column="1" Header="Bis (Nr.)" SpinButtonPlacementMode="Compact"/><ComboBox x:Name="DirectionBox" Grid.Column="2" Header="Richtung"/><ComboBox x:Name="DescriptionBox" Grid.Column="3" Header="Bezeichnung"/><CheckBox x:Name="BudgetBox" Grid.Column="4" Content="Ist Budgetkonto" VerticalAlignment="Bottom"/><CheckBox x:Name="ExcludeStweBox" Grid.Column="5" Content="Nicht in STWE-Sets" VerticalAlignment="Bottom"/></Grid></Border>
  <ListView x:Name="RulesList" Grid.Row="2" SelectionChanged="OnSelectionChanged"><ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Von" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Bis" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Richtung" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Bezeichnung" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Budgetkonto" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Nicht in STWE-Sets" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RangeStart}"/><TextBlock Grid.Column="1" Text="{Binding RangeEnd}"/><TextBlock Grid.Column="2" Text="{Binding Richtung}"/><TextBlock Grid.Column="3" Text="{Binding Bezeichnung}"/><CheckBox Grid.Column="4" IsChecked="{Binding IstBudgetkonto}" IsHitTestVisible="False"/><CheckBox Grid.Column="5" IsChecked="{Binding ExcludeFromStweSets}" IsHitTestVisible="False"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
  <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
