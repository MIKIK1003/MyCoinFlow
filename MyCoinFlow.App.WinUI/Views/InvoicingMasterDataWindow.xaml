<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingMasterDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Fakturieren – Stammdaten">

    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="8"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseShortcut" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="Fakturierungsstammdaten" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Artikel, Leistungen und Empfängerprofile für fakturierbare Immobilienobjekte"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WorkspaceFunctionBarStyle}">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="ARTIKEL / LEISTUNG" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NewArticleButton" Style="{StaticResource FunctionPrimaryButtonStyle}"
                                    Click="OnNewArticleClick" AutomationProperties.Name="Neuer Artikel oder neue Leistung">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionAddIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Neuer Artikel / neue Leistung" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditArticleButton" Style="{StaticResource FunctionButtonStyle}"
                                    Click="OnEditArticleClick" AutomationProperties.Name="Artikel oder Leistung bearbeiten">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionEditIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Artikel / Leistung bearbeiten" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />
                    <StackPanel>
                        <TextBlock Text="ERTRAGSKONTO" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <Button x:Name="NewRevenueAccountButton"
                                Style="{StaticResource FunctionButtonStyle}" Click="OnNewRevenueAccountClick"
                                AutomationProperties.Name="Neues Ertragskonto">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="{StaticResource ActionAddIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                <TextBlock Text="Neues Ertragskonto" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />
                    <StackPanel>
                        <TextBlock Text="IMMOBILIENPROFIL" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NewUsageButton" Style="{StaticResource FunctionPrimaryButtonStyle}"
                                    Click="OnNewUsageClick" AutomationProperties.Name="Nutzungszeitraum hinzufügen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionAddIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Nutzungszeitraum hinzufügen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditUsageButton" Style="{StaticResource FunctionButtonStyle}"
                                    Click="OnEditUsageClick" AutomationProperties.Name="Nutzungszeitraum bearbeiten">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionEditIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Nutzungszeitraum bearbeiten" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteUsageButton" Style="{StaticResource FunctionDangerButtonStyle}"
                                    Click="OnDeleteUsageClick" AutomationProperties.Name="Nutzungszeitraum löschen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionDeleteIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Nutzungszeitraum löschen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />
                    <StackPanel>
                        <TextBlock Text="ANSICHT" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnRefreshClick"
                                    AutomationProperties.Name="Aktualisieren">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionRefreshIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Aktualisieren" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnCloseClick"
                                    AutomationProperties.Name="Schließen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8BB;" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Schließen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WorkspaceFilterBarStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SUCHE" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                    <TextBox x:Name="SearchBox" Height="34"
                             PlaceholderText="Artikelnummer, Bezeichnung, Liegenschaft, Einheit oder Adresse"
                             TextChanged="OnSearchTextChanged"
                             AutomationProperties.Name="Fakturierungsstammdaten durchsuchen" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="STATUS" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="9,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource MyCoinFlowPositiveBrush}" />
                            <TextBlock x:Name="SummaryText" Text="Stammdaten werden geladen …" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="3" IsOpen="False" IsClosable="True" />

        <TabView x:Name="MasterDataTabs" Grid.Row="4" TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="False"
                 SelectionChanged="OnTabSelectionChanged">
            <TabViewItem Header="Artikel und Leistungen" IsClosable="False"
                         VerticalContentAlignment="Stretch">
                <Grid x:Name="ArticleWorkspace" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="ArticleNarrow">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="ArticleWide">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ArticleListCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="ArticleDetailCard.(Grid.Row)" Value="0" />
                                    <Setter Target="ArticleDetailCard.(Grid.Column)" Value="1" />
                                    <Setter Target="ArticleDetailCard.(Grid.ColumnSpan)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border x:Name="ArticleListCard" Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NUMMER" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="BEZEICHNUNG" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="KATEGORIE" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                            <ListView x:Name="ArticlesList" Grid.Row="1" SelectionMode="Single"
                                      SelectionChanged="OnArticleSelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,7" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ArticleNumber}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Designation}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Category}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding ActiveDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="ArticleDetailCard" Grid.Row="1" Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer Style="{StaticResource FormScrollViewerStyle}" MaxHeight="480">
                            <StackPanel Spacing="9">
                                <TextBlock x:Name="ArticleDetailTitle" Text="Kein Artikel ausgewählt"
                                           Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ArticleDetailDescription" Text="Wählen Sie links einen Artikel oder eine Leistung."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Text="Preis / Einheit" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ArticlePriceText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="MWST" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ArticleVatText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Ertragskonto" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ArticleRevenueText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Nebenkostenklassifikation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ArticleClassificationText" Text="—" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Immobilien- und Empfängerprofile" IsClosable="False"
                         VerticalContentAlignment="Stretch">
                <Grid x:Name="ProfileWorkspace" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="ProfileNarrow">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="ProfileWide">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ProfileListCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="ProfileDetailCard.(Grid.Row)" Value="0" />
                                    <Setter Target="ProfileDetailCard.(Grid.Column)" Value="1" />
                                    <Setter Target="ProfileDetailCard.(Grid.ColumnSpan)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border x:Name="ProfileListCard" Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ListView x:Name="ProfilesList" SelectionMode="Single"
                                  SelectionChanged="OnProfileSelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PropertyAndUnit}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding UsageDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding RecipientDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border x:Name="ProfileDetailCard" Grid.Row="1" Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer Style="{StaticResource FormScrollViewerStyle}" MaxHeight="520">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="ProfileDetailTitle" Text="Keine Einheit ausgewählt"
                                           Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="Liegenschaft → Einheit" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProfileChainPropertyText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Zeitraum / Nutzung" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProfileChainUsageText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Verantwortliche Partei" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProfileChainOwnerText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Rechnungsempfänger" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProfileChainRecipientText" Text="—" TextWrapping="Wrap" />
                                <TextBlock Text="Miet-/Nebenkostenkontext" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProfileRentalText" Text="—" TextWrapping="Wrap" />
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                                         Title="Prüfhinweis"
                                         Message="Eigentümer ist der sichere Standard. Mieter nur bei aktivem Mietverhältnis, dokumentierter Nebenkostenvereinbarung und dokumentierter Direktfakturierungsfreigabe wählen; Art. 712h ZGB, Art. 257a/257b OR, VMWG und BWO-Hinweise prüfen." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="5" Style="{StaticResource WorkspaceStatusBarStyle}">
            <TextBlock x:Name="FooterStatusText" Text="Stammdaten werden geladen …"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid x:Name="LoadingOverlay" Grid.RowSpan="6"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Fakturierungsstammdaten werden geladen …" />
            </StackPanel>
        </Grid>
    </Grid>
</window:PersistentWindow>
