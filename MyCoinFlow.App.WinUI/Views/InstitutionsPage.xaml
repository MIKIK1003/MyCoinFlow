<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.InstitutionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Geldinstitute" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Bankverbindungen, Anfangswerte und aktuelle Salden verwalten"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="False" VerticalAlignment="Center">
                <AppBarButton Label="Aktualisieren" Click="OnRefreshClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Neu" Click="OnNewClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False"
                              Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,10">
            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <FontIcon Glyph="&#xE825;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                    <TextBlock x:Name="InstitutionCountText" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="InitialTotalText" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <TextBlock Grid.Column="2" x:Name="BookedTotalText" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <TextBlock Grid.Column="3" x:Name="ClosingTotalText" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <DatePicker x:Name="CutoffPicker" Grid.Column="5" Header="Saldo per"
                            MinWidth="300" HorizontalAlignment="Stretch" DateChanged="OnCutoffDateChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Doppelklick öffnet die Transaktionen"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="BANKVERBINDUNG" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="NOTIZ" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="ANFANGSBESTAND" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="GEBUCHT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="SCHLUSSSALDO" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="InstitutionsList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnInstitutionSelectionChanged"
                          DoubleTapped="OnInstitutionDoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <Button Padding="6" ToolTipService.ToolTip="Transaktionen dieses Geldinstituts anzeigen"
                                        Click="OnOpenTransactionsClick">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding Name}" />
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BankConnectionPrimary}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Iban}" />
                                    <TextBlock Text="{Binding BankConnectionSecondary}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Note}" />
                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InitialBalanceText}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding InitialDateText}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{Binding BookedText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding ClosingBalanceText}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="BusyRing" Grid.RowSpan="2" IsActive="False" Width="42" Height="42"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
