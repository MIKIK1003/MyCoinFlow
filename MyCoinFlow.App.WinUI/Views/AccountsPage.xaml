<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Kontenplan" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Kontenstruktur, Budgetwerte und Buchungen verwalten"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        IsDynamicOverflowEnabled="False" VerticalAlignment="Center">
                <AppBarButton Label="Aktualisieren" Click="OnRefreshClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Neu" Click="OnNewClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="Bearbeiten" IsEnabled="False" Click="OnEditClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Löschen" IsEnabled="False"
                              Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,10">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8EF;" Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                    <TextBlock x:Name="AccountCountText" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="BudgetTotalText" />
                <TextBlock Grid.Column="2" x:Name="BookedTotalText" />
                <TextBlock Grid.Column="4" x:Name="ActivePeriodText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Expander Grid.Row="2" Header="Suchen und filtern" IsExpanded="True">
            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,0,12,12">
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Header="Kontonummer, Art, Gruppe oder Detail"
                             PlaceholderText="Suchbegriffe" KeyDown="OnSearchKeyDown" />
                    <DatePicker x:Name="FromPicker" Grid.Column="1" Header="Von" HorizontalAlignment="Stretch" />
                    <DatePicker x:Name="ToPicker" Grid.Column="2" Header="Bis" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="AccountFilterBox" Grid.Column="3" Header="Konto" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Anwenden" Style="{StaticResource AccentButtonStyle}" Click="OnApplyFilterClick" />
                        <Button Content="Leeren" Click="OnClearFilterClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ToggleSwitch x:Name="ViewToggle" Grid.Column="1" Header="Tabellenansicht"
                          OffContent="Baum" OnContent="Tabelle" Toggled="OnViewToggled" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid x:Name="TreeHost">
                    <TreeView x:Name="AccountsTree" SelectionMode="Single"
                              SelectionChanged="OnTreeSelectionChanged" />
                </Grid>

                <Grid x:Name="TableHost" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="NR." FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="ART" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="GRUPPE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="UNTERGRUPPE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="DETAIL" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="BUDGET" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="GEBUCHT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="Δ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView x:Name="AccountsList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="OnAccountSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,5" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <Button Padding="6" ToolTipService.ToolTip="Transaktionen dieses Kontos anzeigen"
                                            Click="OnOpenAccountTransactionsClick">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding AccountNumberText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Art}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Subgroup}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding BudgetText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="{Binding BookedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="8" Text="{Binding DifferenceText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ProgressRing x:Name="BusyRing" IsActive="False" Width="42" Height="42"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="5" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
