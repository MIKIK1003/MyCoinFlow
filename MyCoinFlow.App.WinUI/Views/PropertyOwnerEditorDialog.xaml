<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.PropertyOwnerEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Eigentümer"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="540">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleStyle}" />
            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
            <TextBox x:Name="NameBox" Header="Name*" />
            <TextBox x:Name="EmailBox" Header="E-Mail" />
            <TextBox x:Name="PhoneBox" Header="Telefon" />
            <TextBox x:Name="NoteBox" Header="Notiz" Height="85" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
