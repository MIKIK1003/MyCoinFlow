<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyCoinFlow.WinUI.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid x:Name="PageLayout" Padding="28,22,28,24" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WorkspaceWidthStates">
                <VisualState x:Name="CompactWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="MediumWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchFieldSecondColumn.Width" Value="0.72*" />
                        <Setter Target="AddressBox.(Grid.Row)" Value="0" />
                        <Setter Target="AddressBox.(Grid.Column)" Value="1" />
                        <Setter Target="AddressBox.Margin" Value="8,0,0,0" />
                        <Setter Target="FilterActionsColumn.Width" Value="Auto" />
                        <Setter Target="FilterActions.(Grid.Row)" Value="0" />
                        <Setter Target="FilterActions.(Grid.Column)" Value="2" />
                        <Setter Target="FilterActions.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="FilterActions.Margin" Value="0" />
                        <Setter Target="StatusSecondColumn.Width" Value="Auto" />
                        <Setter Target="SelectionContext.(Grid.Row)" Value="0" />
                        <Setter Target="SelectionContext.(Grid.Column)" Value="1" />
                        <Setter Target="SelectionContext.Margin" Value="0" />
                        <Setter Target="SelectionContext.TextAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchFieldSecondColumn.Width" Value="0.72*" />
                        <Setter Target="AddressBox.(Grid.Row)" Value="0" />
                        <Setter Target="AddressBox.(Grid.Column)" Value="1" />
                        <Setter Target="AddressBox.Margin" Value="8,0,0,0" />
                        <Setter Target="FilterActionsColumn.Width" Value="Auto" />
                        <Setter Target="FilterActions.(Grid.Row)" Value="0" />
                        <Setter Target="FilterActions.(Grid.Column)" Value="2" />
                        <Setter Target="FilterActions.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="FilterActions.Margin" Value="0" />
                        <Setter Target="StatusSecondColumn.Width" Value="Auto" />
                        <Setter Target="SelectionContext.(Grid.Row)" Value="0" />
                        <Setter Target="SelectionContext.(Grid.Column)" Value="1" />
                        <Setter Target="SelectionContext.Margin" Value="0" />
                        <Setter Target="SelectionContext.TextAlignment" Value="Right" />
                        <Setter Target="FilterSearchColumn.Width" Value="2*" />
                        <Setter Target="FilterSeparatorColumn.Width" Value="Auto" />
                        <Setter Target="FilterPeriodColumn.Width" Value="1.35*" />
                        <Setter Target="FilterSeparator.(Grid.Row)" Value="0" />
                        <Setter Target="FilterSeparator.(Grid.Column)" Value="1" />
                        <Setter Target="FilterSeparator.Width" Value="1" />
                        <Setter Target="FilterSeparator.Height" Value="64" />
                        <Setter Target="FilterSeparator.Margin" Value="12,0" />
                        <Setter Target="PeriodZone.(Grid.Row)" Value="0" />
                        <Setter Target="PeriodZone.(Grid.Column)" Value="2" />
                        <Setter Target="MetricsThirdColumn.Width" Value="*" />
                        <Setter Target="MetricsFourthColumn.Width" Value="*" />
                        <Setter Target="MetricsFifthColumn.Width" Value="*" />
                        <Setter Target="ExpenseCard.(Grid.Row)" Value="0" />
                        <Setter Target="ExpenseCard.(Grid.Column)" Value="2" />
                        <Setter Target="AttachmentCard.(Grid.Row)" Value="0" />
                        <Setter Target="AttachmentCard.(Grid.Column)" Value="3" />
                        <Setter Target="PeriodCard.(Grid.Row)" Value="0" />
                        <Setter Target="PeriodCard.(Grid.Column)" Value="4" />
                        <Setter Target="PeriodCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="Transaktionen" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Zahlungsströme prüfen, erfassen und nachvollziehen"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource WorkspaceFunctionBarStyle}">
            <ScrollViewer Padding="0"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="TRANSAKTION" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionPrimaryButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnNewClick"
                                    ToolTipService.ToolTip="Neue Buchung erfassen">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionAddIconGlyph}" />
                                    <TextBlock Text="Neue Buchung" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding CanActOnSelection}"
                                    Click="OnEditClick"
                                    ToolTipService.ToolTip="Markierte Buchung bearbeiten">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="E" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionEditIconGlyph}" />
                                    <TextBlock Text="Bearbeiten" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionDangerButtonStyle}"
                                    IsEnabled="{Binding CanActOnSelection}"
                                    Click="OnDeleteClick"
                                    ToolTipService.ToolTip="Markierte Buchung löschen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionDeleteIconGlyph}" />
                                    <TextBlock Text="Löschen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />

                    <StackPanel>
                        <TextBlock Text="PRÜFEN" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnRefreshClick"
                                    ToolTipService.ToolTip="Transaktionsbestand aktualisieren">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionRefreshIconGlyph}" />
                                    <TextBlock Text="Aktualisieren" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnDuplicatesClick"
                                    ToolTipService.ToolTip="Mögliche Dubletten prüfen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionCopyIconGlyph}" />
                                    <TextBlock Text="Dubletten" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />

                    <StackPanel>
                        <TextBlock Text="IMPORT" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnBankImportClick"
                                    ToolTipService.ToolTip="Banktransaktionen einlesen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionDownloadIconGlyph}" />
                                    <TextBlock Text="Bank einlesen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnCreditCardImportClick"
                                    ToolTipService.ToolTip="Kreditkartentransaktionen einlesen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionDownloadIconGlyph}" />
                                    <TextBlock Text="Kreditkarte einlesen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />

                    <StackPanel>
                        <TextBlock Text="AUSWERTUNG" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding CanActOnSelection}"
                                    Click="OnWebResearchClick"
                                    ToolTipService.ToolTip="Zum Text der markierten Buchung im Web suchen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionSearchIconGlyph}" />
                                    <TextBlock Text="Web-Recherche" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FunctionButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnReportClick"
                                    ToolTipService.ToolTip="Transaktionsbericht öffnen">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionReportIconGlyph}" />
                                    <TextBlock Text="Bericht" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2"
                Style="{StaticResource WorkspaceFilterBarStyle}">
            <Grid x:Name="FilterLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterSearchColumn" Width="*" />
                    <ColumnDefinition x:Name="FilterSeparatorColumn" Width="0" />
                    <ColumnDefinition x:Name="FilterPeriodColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="SearchZone">
                    <TextBlock Text="SUCHE" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SearchFieldSecondColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 IsEnabled="{Binding IsNotBusy}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Volltext, Nummer, Konto oder Betrag"
                                 AutomationProperties.Name="Transaktionen durchsuchen"
                                 KeyDown="OnFilterKeyDown" />
                        <TextBox x:Name="AddressBox"
                                 Grid.Row="1"
                                 Margin="0,8,0,0"
                                 IsEnabled="{Binding IsNotBusy}"
                                 Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Adresse"
                                 AutomationProperties.Name="Nach Adresse filtern"
                                 KeyDown="OnFilterKeyDown" />
                    </Grid>
                </StackPanel>

                <Border x:Name="FilterSeparator"
                        Grid.Row="1"
                        Height="1"
                        Margin="0,12"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <StackPanel x:Name="PeriodZone" Grid.Row="2">
                    <TextBlock Text="FILTER · ZEITRAUM" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                    <Grid x:Name="PeriodLayout" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FilterActionsColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Header="Von"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SelectedDate="{Binding From, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Zeitraum von" />
                        <DatePicker Grid.Column="1"
                                    Header="Bis"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SelectedDate="{Binding To, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Zeitraum bis" />
                        <StackPanel x:Name="FilterActions"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Bottom">
                            <Button Height="34" IsEnabled="{Binding IsNotBusy}" Click="OnApplyFilterClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                              Glyph="{StaticResource ActionFilterIconGlyph}" />
                                    <TextBlock Text="Anwenden" />
                                </StackPanel>
                            </Button>
                            <Button Height="34"
                                    Content="Zurücksetzen"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnResetFilterClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MetricsGrid" Grid.Row="3" ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MetricsThirdColumn" Width="0" />
                <ColumnDefinition x:Name="MetricsFourthColumn" Width="0" />
                <ColumnDefinition x:Name="MetricsFifthColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ResultCard" Style="{StaticResource WorkspaceMetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="ERGEBNIS" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding ResultCountText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="IncomeCard" Grid.Column="1" Style="{StaticResource WorkspaceMetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="EINNAHMEN" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding IncomeAmountText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <ToolTipService.ToolTip>Nummernkreis „Einnahmen (Budgetiert)“; neutrale Konten sind ausgeschlossen.</ToolTipService.ToolTip>
            </Border>
            <Border x:Name="ExpenseCard" Grid.Row="1" Style="{StaticResource WorkspaceMetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="AUSGABEN" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding ExpenseAmountText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <ToolTipService.ToolTip>Nummernkreis „Ausgaben (Budgetiert)“; neutrale Konten sind ausgeschlossen.</ToolTipService.ToolTip>
            </Border>
            <Border x:Name="AttachmentCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource WorkspaceMetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="MIT BELEGEN" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding AttachmentCountText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="PeriodCard"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource WorkspaceMetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="ZEITRAUM" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding PeriodText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                CornerRadius="6"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="TransactionHeaderWidthStates">
                            <VisualState x:Name="CompactTransactionHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="CompactHeader.Visibility" Value="Visible" />
                                    <Setter Target="WideHeader.Visibility" Value="Collapsed" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideTransactionHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1280" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="CompactHeader.Visibility" Value="Collapsed" />
                                    <Setter Target="WideHeader.Visibility" Value="Visible" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid x:Name="CompactHeader"
                          Padding="14,10"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="TRANSAKTIONEN" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Details werden für die verfügbare Breite umgebrochen."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Doppelklick: bearbeiten"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="WideHeader"
                          Visibility="Collapsed"
                          Padding="16,11"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DOKUMENTE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="DATUM" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="NR." FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="VON" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="NACH" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="BETRAG" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="KONTEXT" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="NOTIZ" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="TransactionGroupsList"
                              ItemsSource="{Binding TransactionGroups}"
                              SelectionMode="None"
                              IsEnabled="{Binding IsNotBusy}"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,3" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid Padding="4,3" RowSpacing="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="7,2">
                                                    <TextBlock Text="{Binding Direction}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Summary}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Grid>
                                    </Expander.Header>

                                    <ListView ItemsSource="{Binding Entries}"
                                              SelectionMode="Single"
                                              SelectionChanged="OnTransactionSelectionChanged"
                                              DoubleTapped="OnListDoubleTapped"
                                              Loaded="OnTransactionListLoaded"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="TransactionRowWidthStates">
                                                            <VisualState x:Name="CompactTransactionRow">
                                                                <VisualState.StateTriggers>
                                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                                </VisualState.StateTriggers>
                                                                <VisualState.Setters>
                                                                    <Setter Target="CompactRow.Visibility" Value="Visible" />
                                                                    <Setter Target="WideRow.Visibility" Value="Collapsed" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="WideTransactionRow">
                                                                <VisualState.StateTriggers>
                                                                    <AdaptiveTrigger MinWindowWidth="1280" />
                                                                </VisualState.StateTriggers>
                                                                <VisualState.Setters>
                                                                    <Setter Target="CompactRow.Visibility" Value="Collapsed" />
                                                                    <Setter Target="WideRow.Visibility" Value="Visible" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Grid x:Name="CompactRow"
                                                          Padding="14,10"
                                                          RowSpacing="8"
                                                          MinHeight="132">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DatumAnzeige}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding BudgetDatumAnzeige}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MyCoinFlowAccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding NummerAnzeige}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding BetragAnzeige}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />

                                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="VON" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                                                                <TextBlock Text="{Binding VonAnzeige}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           ToolTipService.ToolTip="{Binding VonAnzeige}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="NACH" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                                                                <TextBlock Text="{Binding NachAnzeige}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           ToolTipService.ToolTip="{Binding NachAnzeige}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="KONTEXT" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                                                                <TextBlock Text="{Binding KontextAnzeige}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           ToolTipService.ToolTip="{Binding KontextAnzeige}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="NOTIZ" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" Margin="0" />
                                                                <TextBlock Text="{Binding Notiz}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           ToolTipService.ToolTip="{Binding Notiz}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <TextBlock Text="DOKUMENTE"
                                                                           Style="{StaticResource WorkspaceFilterZoneTitleStyle}"
                                                                           Margin="0"
                                                                           VerticalAlignment="Center" />
                                                                <Border Background="{StaticResource MyCoinFlowAccentBrush}"
                                                                        CornerRadius="8"
                                                                        Opacity="{Binding AttachmentOpacity}"
                                                                        MinWidth="18"
                                                                        Height="18">
                                                                    <TextBlock Text="{Binding AttachmentAnzeige}"
                                                                               Foreground="White"
                                                                               FontSize="10"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        HorizontalAlignment="Right">
                                                                <Button Width="34"
                                                                        Height="34"
                                                                        Padding="0"
                                                                        Click="OnAttachDocumentRowClick"
                                                                        AutomationProperties.Name="Dokument verknüpfen"
                                                                        ToolTipService.ToolTip="Dokument verknüpfen">
                                                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                              Glyph="{StaticResource ActionAttachIconGlyph}" />
                                                                </Button>
                                                                <Button Width="34"
                                                                        Height="34"
                                                                        Padding="0"
                                                                        Click="OnOpenDocumentRowClick"
                                                                        IsEnabled="{Binding HasAttachments}"
                                                                        AutomationProperties.Name="Dokument öffnen"
                                                                        ToolTipService.ToolTip="Dokument öffnen">
                                                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                              Glyph="{StaticResource ActionOpenIconGlyph}" />
                                                                </Button>
                                                                <Button Width="34"
                                                                        Height="34"
                                                                        Padding="0"
                                                                        Click="OnManageDocumentsRowClick"
                                                                        IsEnabled="{Binding HasAttachments}"
                                                                        AutomationProperties.Name="Dokumente verwalten"
                                                                        ToolTipService.ToolTip="Dokumente verwalten">
                                                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                              Glyph="{StaticResource ActionDocumentIconGlyph}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>

                                                    <Grid x:Name="WideRow"
                                                          Visibility="Collapsed"
                                                          Padding="16,11"
                                                          ColumnSpacing="12"
                                                          MinHeight="54">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="1.25*" />
                                                            <ColumnDefinition Width="1.25*" />
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <Button Width="34"
                                                                    Height="34"
                                                                    Padding="0"
                                                                    Click="OnAttachDocumentRowClick"
                                                                    AutomationProperties.Name="Dokument verknüpfen"
                                                                    ToolTipService.ToolTip="Dokument verknüpfen">
                                                                <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                          Glyph="{StaticResource ActionAttachIconGlyph}" />
                                                            </Button>
                                                            <Button Width="34"
                                                                    Height="34"
                                                                    Padding="0"
                                                                    Click="OnOpenDocumentRowClick"
                                                                    IsEnabled="{Binding HasAttachments}"
                                                                    AutomationProperties.Name="Dokument öffnen"
                                                                    ToolTipService.ToolTip="Dokument öffnen">
                                                                <Grid>
                                                                    <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                              Glyph="{StaticResource ActionOpenIconGlyph}" />
                                                                    <Border Background="{StaticResource MyCoinFlowAccentBrush}"
                                                                            CornerRadius="8"
                                                                            Opacity="{Binding AttachmentOpacity}"
                                                                            MinWidth="16"
                                                                            Height="16"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="14,-8,-8,0">
                                                                        <TextBlock Text="{Binding AttachmentAnzeige}"
                                                                                   Foreground="White"
                                                                                   FontSize="9"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="3,0" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                            <Button Width="34"
                                                                    Height="34"
                                                                    Padding="0"
                                                                    Click="OnManageDocumentsRowClick"
                                                                    IsEnabled="{Binding HasAttachments}"
                                                                    AutomationProperties.Name="Dokumente verwalten"
                                                                    ToolTipService.ToolTip="Dokumente verwalten">
                                                                <FontIcon Style="{StaticResource ActionIconStyle}"
                                                                          Glyph="{StaticResource ActionDocumentIconGlyph}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DatumAnzeige}" />
                                                            <TextBlock Text="{Binding BudgetDatumAnzeige}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding NummerAnzeige}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding VonAnzeige}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding VonAnzeige}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding NachAnzeige}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding NachAnzeige}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding BetragAnzeige}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding KontextAnzeige}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding KontextAnzeige}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7"
                                                                   Text="{Binding Notiz}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{Binding Notiz}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="430"
                                Spacing="10">
                        <FontIcon Style="{StaticResource ActionIconStyle}"
                                  Glyph="{StaticResource ActionSearchIconGlyph}"
                                  FontSize="32"
                                  Width="32"
                                  Height="32"
                                  Foreground="{StaticResource MyCoinFlowAccentBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Keine Transaktionen gefunden"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Passe Suchbegriff, Adresse oder Zeitraum an und wende den Filter erneut an."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button Content="Filter zurücksetzen"
                                HorizontalAlignment="Center"
                                Click="OnResetFilterClick" />
                    </StackPanel>

                    <ProgressRing IsActive="{Binding IsBusy}"
                                  Width="42"
                                  Height="42"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource WorkspaceStatusBarStyle}">
            <Grid x:Name="StatusLayout" ColumnSpacing="16" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="StatusSecondColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Style="{StaticResource ActionIconStyle}"
                              Glyph="{StaticResource ActionMessageIconGlyph}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock x:Name="SelectionContext"
                           Grid.Row="1"
                           Margin="23,0,0,0"
                           Text="{Binding SelectionContextText}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Left" />
            </Grid>
        </Border>

        <InfoBar x:Name="ErrorInfoBar"
                 Grid.RowSpan="6"
                 VerticalAlignment="Top"
                 Margin="80,12"
                 IsOpen="{Binding HasError}"
                 IsClosable="True"
                 Severity="Error"
                 Title="Aktion nicht möglich"
                 Message="{Binding ErrorMessage}"
                 Closed="OnErrorClosed" />
    </Grid>
</Page>
