<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyCoinFlow.WinUI.Views.InvoicingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot" Padding="28,22,28,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Fakturieren" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Offerten, Aufträge, Lieferungen und Rechnungen als zusammengehörende Vorgänge"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                    <TextBlock x:Name="ContextBadgeText" Text="Mandant wird geladen …"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WorkspaceFunctionBarStyle}">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="VORGANG" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NewCaseButton" Style="{StaticResource FunctionPrimaryButtonStyle}"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Neuer Vorgang"
                                    ToolTipService.ToolTip="Die Dokumenterfassung wird in einem späteren Fakturieren-Ausbauschritt freigeschaltet.">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionAddIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Neuer Vorgang" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource FunctionGroupSeparatorStyle}" />
                    <StackPanel>
                        <TextBlock Text="ANSICHT" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FunctionButtonStyle}" Click="OnRefreshClick"
                                    AutomationProperties.Name="Aktualisieren">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="{StaticResource ActionRefreshIconGlyph}" Style="{StaticResource ActionIconStyle}" />
                                    <TextBlock Text="Aktualisieren" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle x:Name="SettingsSeparator" Style="{StaticResource FunctionGroupSeparatorStyle}" />
                    <StackPanel x:Name="SettingsActionGroup">
                        <TextBlock Text="EINRICHTUNG" Style="{StaticResource FunctionGroupTitleStyle}" />
                        <Button Style="{StaticResource FunctionButtonStyle}" Click="OnFinanceSettingsClick"
                                AutomationProperties.Name="Finanzen einstellen">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE713;" Style="{StaticResource ActionIconStyle}" />
                                <TextBlock Text="Finanzen einstellen" Style="{StaticResource FunctionButtonFullLabelStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WorkspaceFilterBarStyle}">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid ColumnSpacing="8" MinWidth="980">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SUCHE" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                        <TextBox x:Name="SearchBox" Height="34" IsEnabled="False"
                                 PlaceholderText="Vorgang, Adresse oder Dokumentnummer"
                                 AutomationProperties.Name="Fakturierungsvorgänge durchsuchen" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="STATUS" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="9,7">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Entwurf" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MyCoinFlowAccentBrush}" />
                                    <TextBlock Text="Offen" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MyCoinFlowDangerBrush}" />
                                    <TextBlock Text="Überfällig" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MyCoinFlowPositiveBrush}" />
                                    <TextBlock Text="Bezahlt" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SCHNELLANSICHT" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleButton Content="Alle · 0" Height="34" IsChecked="True" IsEnabled="False" />
                            <ToggleButton Content="Offen · 0" Height="34" IsEnabled="False" />
                            <ToggleButton Content="Überfällig · 0" Height="34" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="FILTER" Style="{StaticResource WorkspaceFilterZoneTitleStyle}" />
                        <ComboBox Width="180" Height="34" IsEnabled="False"
                                  Header="Filter" HeaderTemplate="{x:Null}" SelectedIndex="0">
                            <ComboBoxItem Content="Alle Dokumentarten" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <InfoBar x:Name="ErrorInfoBar" Grid.Row="3" IsOpen="False" IsClosable="True"
                 Severity="Error" Title="Fakturieren konnte nicht geladen werden">
            <InfoBar.ActionButton>
                <Button Content="Erneut versuchen" Click="OnRefreshClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer Grid.Row="4" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource WorkspaceMetricCardStyle}" Width="176">
                    <StackPanel>
                        <TextBlock Text="VORGÄNGE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Noch keine erfasst" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkspaceMetricCardStyle}" Width="176">
                    <StackPanel>
                        <TextBlock Text="OFFENE RECHNUNGEN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="0,00 in Basiswährung" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkspaceMetricCardStyle}" Width="176">
                    <StackPanel>
                        <TextBlock Text="ÜBERFÄLLIG" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Keine Mahnfälle" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkspaceMetricCardStyle}" Width="208">
                    <StackPanel>
                        <TextBlock Text="FINANZGRUNDLAGE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ConfigurationMetricText" Text="Wird geprüft …"
                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="CurrencyMetricText" Text="Basiswährung —" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="WorkspaceGrid" Grid.Row="5" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowWorkspace">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideWorkspace">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CaseListCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="ContextCard.(Grid.Row)" Value="0" />
                            <Setter Target="ContextCard.(Grid.Column)" Value="1" />
                            <Setter Target="ContextCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="ContextCard.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="CaseListCard" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}"
                    CornerRadius="6" MinHeight="250">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="520" Spacing="10">
                        <Border Width="58" Height="58" CornerRadius="18"
                                Background="{StaticResource MyCoinFlowAccentSoftBrush}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="28"
                                      Foreground="{StaticResource MyCoinFlowAccentBrush}" />
                        </Border>
                        <TextBlock x:Name="EmptyStateTitle" Text="Fakturieren wird vorbereitet"
                                   FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyStateDescription"
                                   Text="Schema und Finanzstammdaten werden geprüft."
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="EmptyStateSettingsButton" Content="Finanzen einstellen"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="OnFinanceSettingsClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ContextCard" Grid.Row="1" Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}" CornerRadius="6"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="Auswahl und Konfiguration" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Kein Vorgang ausgewählt"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Aussteller" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="IssuerText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Währungen" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CurrenciesText" Grid.Row="1" Grid.Column="1" Text="—" />
                        <TextBlock Grid.Row="2" Text="MWST" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VatText" Grid.Row="2" Grid.Column="1" Text="—" />
                        <TextBlock Grid.Row="3" Text="Zahlung" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PaymentText" Grid.Row="3" Grid.Column="1" Text="—" />
                    </Grid>
                    <TextBlock x:Name="MissingConfigurationText" TextWrapping="Wrap"
                               Foreground="{StaticResource MyCoinFlowDangerBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Fakturieren wird geladen …" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource WorkspaceStatusBarStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Verbindung wird geprüft …"
                           TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="SchemaText" Grid.Column="1" Text="Schema —"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
