<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.StweDistributionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Set verteilen">
    <Grid x:Name="RootGrid" Padding="24,18,24,20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3"><TextBlock x:Name="HeaderText" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="SetStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                <AppBarButton x:Name="SaveButton" Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton>
                <AppBarButton x:Name="AutoFixButton" Label="Auto FIX" Click="OnAutoFixClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8EF;"/></AppBarButton.Icon></AppBarButton>
                <AppBarButton x:Name="AutoMeaButton" Label="Auto MEA" Click="OnAutoMeaClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8EF;"/></AppBarButton.Icon></AppBarButton>
                <AppBarButton x:Name="EnergyButton" Label="Energie berechnen" Visibility="Collapsed" Click="OnEnergyClick"><AppBarButton.Icon><FontIcon Glyph="&#xEC4A;"/></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="Schließen" Click="OnCloseClick"><AppBarButton.Icon><FontIcon Glyph="&#xE8BB;"/></AppBarButton.Icon></AppBarButton>
            </CommandBar>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="14,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Verteilschlüssel" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="KeyBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnKeyChanged" MinWidth="300"/></Grid></Border>
            <Border x:Name="EnergySetPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Visibility="Collapsed"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Zählerdaten-Set" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="EnergySetBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectionChanged="OnEnergySetChanged" MinWidth="360"/></Grid></Border>
        </Grid>
        <Border x:Name="EnergyInfoPanel" Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" Visibility="Collapsed">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zeitraum" FontWeight="SemiBold"/><TextBlock x:Name="EnergyPeriodText" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Notiz" FontWeight="SemiBold"/><TextBlock x:Name="EnergyNoteText" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Rechnung kWh" FontWeight="SemiBold"/><TextBlock x:Name="EnergyInvoiceText"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Gutschrift CHF" FontWeight="SemiBold"/><TextBlock x:Name="EnergyCreditText"/></StackPanel></Grid>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition x:Name="EnergyColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"><AppBarButton x:Name="AddRowButton" Label="Zeile" Click="OnAddRowClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="DeleteRowButton" Label="Markierte löschen" Click="OnDeleteRowClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="ClearRowsButton" Label="Leeren" Click="OnClearRowsClick"><AppBarButton.Icon><FontIcon Glyph="&#xE894;"/></AppBarButton.Icon></AppBarButton></CommandBar>
                <ListView x:Name="RowsList" Grid.Row="1" SelectionMode="Single"><ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Eigentümer" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Betrag" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Notiz" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Quelle" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="6,4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Owners}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OwnerId, Mode=TwoWay}"/><TextBox Grid.Column="1" Text="{Binding AmountText, Mode=TwoWay}" TextAlignment="Right"/><TextBox Grid.Column="2" Text="{Binding Note, Mode=TwoWay}"/><TextBlock Grid.Column="3" Text="{Binding Source}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
            </Grid></Border>
            <Border x:Name="EnergyDiffPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Zählerdifferenzen" FontWeight="SemiBold" Margin="14,12"/><ListView x:Name="EnergyDiffList" Grid.Row="1" SelectionMode="None"><ListView.Header><Grid Padding="10,8" ColumnSpacing="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Typ" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Zähler" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Alt" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Neu" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Diff. kWh" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Type}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding OldText}"/><TextBlock Grid.Column="3" Text="{Binding NewText}"/><TextBlock Grid.Column="4" Text="{Binding DifferenceText}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20"><TextBlock x:Name="TotalText" FontWeight="SemiBold"/><TextBlock x:Name="DistributedText" FontWeight="SemiBold"/><TextBlock x:Name="RestText" FontWeight="SemiBold"/></StackPanel></Grid>
    </Grid>
</window:PersistentWindow>
