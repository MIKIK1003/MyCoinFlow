<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.TransactionEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Buchen"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="650" Style="{StaticResource FormScrollViewerStyle}">
        <StackPanel Width="720" Spacing="16">
            <StackPanel Spacing="3">
                <TextBlock x:Name="DialogHeading" Text="Neue Buchung" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Der Buchungstyp führt durch die benötigten Angaben."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" Title="Bitte prüfen" IsClosable="False" />
            <InfoBar x:Name="BudgetWarning" IsOpen="False" Severity="Warning" IsClosable="False" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Buchungsweg" Style="{StaticResource SectionTitleStyle}" />
                    <RadioButtons x:Name="TypeOptions" SelectedIndex="0" MaxColumns="3"
                                  SelectionChanged="OnTypeSelectionChanged">
                        <x:String>Bank → Konto</x:String>
                        <x:String>Adresse → Konto</x:String>
                        <x:String>Konto → Konto</x:String>
                        <x:String>Adresse → Bank</x:String>
                        <x:String>Konto → Bank</x:String>
                    </RadioButtons>
                    <ToggleSwitch x:Name="BudgetIncomeSwitch" Header="Als budgetierte Einnahme behandeln"
                                  OffContent="Nein" OnContent="Ja"
                                  Toggled="OnBudgetIncomeToggled" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DatePicker x:Name="DatePicker" Header="Bankdatum" DateChanged="OnDateChanged" HorizontalAlignment="Stretch" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Budgetdatum (optional)" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="BudgetDatePicker" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Leeren" Click="OnClearBudgetDateClick" />
                    </Grid>
                </StackPanel>

                <TextBox x:Name="AmountBox" Grid.Row="1" Header="Betrag (CHF)" PlaceholderText="0.00" />
                <ComboBox x:Name="InstitutionBox" Grid.Row="1" Grid.Column="1" Header="Geldinstitut"
                          PlaceholderText="Geldinstitut wählen" DisplayMemberPath="Name" SelectedValuePath="Id"
                          HorizontalAlignment="Stretch" />

                <ComboBox x:Name="SourceAccountBox" Grid.Row="2" Header="Von-Konto"
                          PlaceholderText="Konto wählen" DisplayMemberPath="Name" SelectedValuePath="Id"
                          HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TargetAccountBox" Grid.Row="2" Grid.Column="1" Header="Nach-/Budgetkonto"
                          PlaceholderText="Konto wählen" DisplayMemberPath="Name" SelectedValuePath="Id"
                          HorizontalAlignment="Stretch" />

                <ComboBox x:Name="AddressBox" Grid.Row="3" Header="Adresse (optional)"
                          PlaceholderText="Adresse wählen" DisplayMemberPath="Name" SelectedValuePath="Id"
                          HorizontalAlignment="Stretch" />
                <TextBox x:Name="NoteBox" Grid.Row="3" Grid.Column="1" Header="Notiz"
                         PlaceholderText="Optionale Buchungsnotiz" MaxLength="200" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
