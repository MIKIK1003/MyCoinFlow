<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyCoinFlow.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Enabled">
 <Grid Padding="28,22,28,24" RowSpacing="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="3"><TextBlock x:Name="HeadingText" Text="Einstellungen" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Konfiguration der bestehenden MyCoinFlow-Funktionen" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  <NavigationView x:Name="SettingsNavigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="OnSelectionChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Nummernkreise" Tag="NumberRanges"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Kontenplan" Tag="AccountStructure"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Transaktionen" Tag="Transactions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Kreditkarten" Tag="CreditCards"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Zahlungsserien" Tag="SubscriptionCategories"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="TenantsItem" Content="Mandanten" Tag="Tenants"><NavigationViewItem.Icon><FontIcon Glyph="&#xE716;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="UpdateItem" Content="Update" Tag="Update"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Backup" Tag="Backup"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Dateianhänge und OCR" Tag="Paths"><NavigationViewItem.Icon><FontIcon Glyph="&#xE838;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Lizenz" Tag="License"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <Grid Padding="22,0,0,0"><ContentControl x:Name="SettingsHost"/></Grid>
  </NavigationView>
 </Grid>
</Page>
