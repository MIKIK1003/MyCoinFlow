<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyCoinFlow.WinUI.Views.MeterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zähler"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MinWidth="760">
        <ScrollViewer MaxHeight="680" Style="{StaticResource FormScrollViewerStyle}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitleStyle}" />
                <InfoBar x:Name="EditorError" IsOpen="False" Severity="Error" />
                <TextBox x:Name="NameBox" Header="Name*" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="TypeBox" Header="Typ" SelectionChanged="OnTypeChanged">
                        <x:String>DIREKT</x:String><x:String>ALLG</x:String><x:String>HEIZ</x:String><x:String>EVU</x:String>
                    </ComboBox>
                    <ComboBox x:Name="UnitBox" Grid.Column="1" Header="Einheit" DisplayMemberPath="Bezeichnung" SelectedValuePath="Id" SelectionChanged="OnUnitChanged" />
                </Grid>
                <TextBox x:Name="NoteBox" Header="Notiz" Height="76" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Text="Verteilung" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,0" />
                <TextBlock Text="DIREKT: automatisch 100 % auf die gewählte Einheit. ALLG/HEIZ: Eigentümerquoten mit Summe 100 %. EVU: keine Verteilzeilen erforderlich."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="10" Padding="8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="EIGENTÜMER" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="ANTEIL %" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="RowsList" SelectionMode="None" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ElementName=RowsList, Path=DataContext.Owners}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OwnerId, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Text="{Binding PercentageText, Mode=TwoWay}" HorizontalContentAlignment="Right" LostFocus="OnPercentageLostFocus" />
                                <Button Grid.Column="2" Padding="6" Click="OnDeleteRowClick" ToolTipService.ToolTip="Zeile löschen"><FontIcon Glyph="&#xE74D;" /></Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LinesInfoText" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Zeile hinzufügen" Click="OnAddRowClick" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
