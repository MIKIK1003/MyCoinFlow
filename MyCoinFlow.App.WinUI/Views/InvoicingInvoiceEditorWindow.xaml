<?xml version="1.0" encoding="utf-8"?>
<window:PersistentWindow
    x:Class="MyCoinFlow.WinUI.Views.InvoicingInvoiceEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:window="using:MyCoinFlow.WinUI"
    Title="Rechnung definitiv setzen">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnCancelShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource EditorWindowHeaderStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Rechnung definitiv setzen" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="Finanz-, Zahlungs- und Revisionsstand verbindlich festhalten"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="AP06 · finanzwirksam" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource FormScrollViewerStyle}">
                <StackPanel Padding="20" Spacing="12">
                    <InfoBar x:Name="ErrorInfoBar" IsOpen="False" IsClosable="True"
                             Severity="Error" Title="Rechnung konnte nicht definitiv gesetzt werden" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                             Title="Definitive Finanzgrenze"
                             Message="Mit dem Abschluss werden Rechnungswerte, offener Posten und Revisionsereignis unveränderlich gespeichert. Zahlung, Buchung, PDF/QR und Versand folgen erst in späteren Arbeitspaketen." />

                    <Border Style="{StaticResource EditorSectionCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Rechnungsentwurf" FontWeight="SemiBold" />
                                <TextBlock x:Name="DocumentTitleText" Text="—" TextWrapping="Wrap" />
                                <TextBlock x:Name="DocumentContextText" Text="—" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Dokumentdatum" FontWeight="SemiBold" />
                                <TextBlock x:Name="DocumentDateText" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Währung / Kurs" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrencyText" Text="—" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="EditorGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="TermsColumn" Spacing="12">
                            <Border Style="{StaticResource EditorSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Rechnungsart und Betrag" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel>
                                        <TextBlock Text="Rechnungsart" />
                                        <ComboBox x:Name="KindBox" DisplayMemberPath="Display"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnInputChanged"
                                                  AutomationProperties.Name="Rechnungsart" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Rabatt in Prozent" />
                                            <NumberBox x:Name="DiscountBox" Minimum="0" Maximum="100"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValueChanged="OnNumberChanged"
                                                       AutomationProperties.Name="Rabatt in Prozent" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Rundung Gesamtbetrag" />
                                            <NumberBox x:Name="RoundingBox" Minimum="-1000" Maximum="1000"
                                                       SmallChange="0.05" SpinButtonPlacementMode="Compact"
                                                       ValueChanged="OnNumberChanged"
                                                       AutomationProperties.Name="Rundungskorrektur" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="PartialAmountPanel" Visibility="Collapsed">
                                        <TextBlock Text="Bruttobetrag dieser Teilrechnung" />
                                        <NumberBox x:Name="PartialAmountBox" Minimum="0" Maximum="999999999999"
                                                   SmallChange="100" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="OnNumberChanged"
                                                   AutomationProperties.Name="Teilrechnungsbetrag" />
                                    </StackPanel>
                                    <InfoBar x:Name="LockedTermsInfoBar" IsOpen="True" IsClosable="False"
                                             Severity="Informational" Title="Rechnungsbasis"
                                             Message="Rabatt und Rundung werden mit der ersten definitiven Rechnung für die gesamte Teilrechnungsfolge festgelegt." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Zahlungsbedingungen" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel>
                                        <TextBlock Text="Zahlungsziel in Tagen" />
                                        <NumberBox x:Name="PaymentDaysBox" Minimum="0" Maximum="365"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValueChanged="OnNumberChanged"
                                                   AutomationProperties.Name="Zahlungsziel in Tagen" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SkontoSwitch" Header="Skonto anbieten"
                                                  Toggled="OnSkontoToggled" />
                                    <Grid x:Name="SkontoFields" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Skonto in Prozent" />
                                            <NumberBox x:Name="SkontoPercentBox" Minimum="0.01" Maximum="100"
                                                       IsEnabled="False"
                                                       SmallChange="0.5" SpinButtonPlacementMode="Compact"
                                                       ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Skontofrist in Tagen" />
                                            <NumberBox x:Name="SkontoDaysBox" Minimum="0" Maximum="365"
                                                       IsEnabled="False"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <ToggleSwitch x:Name="InstallmentSwitch" Header="Abzahlungsplan erstellen"
                                                  Toggled="OnInstallmentToggled" />
                                    <StackPanel x:Name="InstallmentSettings">
                                        <TextBlock Text="Anzahl Monatsraten" />
                                        <NumberBox x:Name="InstallmentCountBox" Minimum="2" Maximum="24"
                                                   IsEnabled="False"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValueChanged="OnNumberChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PreviewColumn" Grid.Column="1" Spacing="12">
                            <Border Style="{StaticResource EditorSectionCardStyle}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Verbindliche Vorschau" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Gesamte Rechnungsbasis" />
                                        <TextBlock x:Name="FullBasisText" Grid.Column="1" Text="—" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Bereits fakturiert" />
                                        <TextBlock x:Name="PreviouslyInvoicedText" Grid.Row="1" Grid.Column="1" Text="—" />
                                        <TextBlock Grid.Row="2" Text="Netto dieser Rechnung" />
                                        <TextBlock x:Name="NetAmountText" Grid.Row="2" Grid.Column="1" Text="—" />
                                        <TextBlock Grid.Row="3" Text="MWST dieser Rechnung" />
                                        <TextBlock x:Name="VatAmountText" Grid.Row="3" Grid.Column="1" Text="—" />
                                        <TextBlock Grid.Row="4" Text="Rundung dieser Rechnung" />
                                        <TextBlock x:Name="InvoiceRoundingText" Grid.Row="4" Grid.Column="1" Text="—" />
                                        <TextBlock Grid.Row="5" Text="Brutto dieser Rechnung" FontWeight="SemiBold" />
                                        <TextBlock x:Name="GrossAmountText" Grid.Row="5" Grid.Column="1" Text="—"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="6" Text="Fällig am" />
                                        <TextBlock x:Name="DueDateText" Grid.Row="6" Grid.Column="1" Text="—" />
                                    </Grid>
                                    <TextBlock x:Name="BaseAmountText" Text="—" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SkontoPreviewText" Text="Kein Skonto" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="InstallmentPreviewCard" Style="{StaticResource EditorSectionCardStyle}"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Abzahlungsplan" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Die letzte Rate gleicht Rundungsdifferenzen aus. Fälligkeiten folgen monatlich ab dem Zahlungsziel."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ListView x:Name="InstallmentList" SelectionMode="None" MaxHeight="260">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LoadingOverlay" Background="#66000000" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource EditorWindowFooterStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Rechnungsdaten werden geladen …"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Abbrechen" Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Content="Definitiv setzen"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                            Click="OnSaveClick"
                            AutomationProperties.Name="Rechnung definitiv setzen" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</window:PersistentWindow>
