<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyCoinFlow.WinUI.Views.CreditCardSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kreditkarten" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Import-Schemas und Spaltenzuordnung" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton Label="Neu" Click="OnNewClick"><AppBarButton.Icon><FontIcon Glyph="&#xE710;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Speichern" Click="OnSaveClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="Löschen" Foreground="{StaticResource MyCoinFlowDangerBrush}" Click="OnDeleteClick"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton></CommandBar></Grid>
  <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="SchemaBox" Header="Vorhandenes Schema" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnSchemaChanged"/><TextBox x:Name="SchemaNameBox" Grid.Column="1" Header="Schema-Name"/></Grid></Border>
  <ListView x:Name="MappingsList" Grid.Row="2"><ListView.Header><Grid Padding="10,8" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><TextBlock Text="Master-Feld" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Feld in Quelldatei" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Fallback" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="8,5" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MasterHeader}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox Grid.Column="1" Text="{Binding SourceHeader, Mode=TwoWay}"/><TextBox Grid.Column="2" Text="{Binding DefaultValue, Mode=TwoWay}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
  <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True"/>
 </Grid>
</UserControl>
